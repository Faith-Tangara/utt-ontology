        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name of the person or organisation acting in the verification process.</rdfs:comment>
        <rdfs:label xml:lang="nl">actor naam</rdfs:label>
        <rdfs:label xml:lang="en">actor name</rdfs:label>
        <skos:definition xml:lang="nl">Naam van de persoon of organisatie.</skos:definition>
        <skos:definition xml:lang="en">Name of the person or organisation.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/afwijkingRichting -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/afwijkingRichting">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/PositieAfwijking"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
