        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Manufacturer and model of the instrument.</rdfs:comment>
        <rdfs:label xml:lang="nl">apparatuur model</rdfs:label>
        <rdfs:label xml:lang="en">equipment model</rdfs:label>
        <skos:definition xml:lang="nl">Fabrikant en model van het instrument.</skos:definition>
        <skos:definition xml:lang="en">Manufacturer and model of the instrument.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/apparatuurSerienummer -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/apparatuurSerienummer">
