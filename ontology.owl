        <rdfs:label xml:lang="en">antenna height</rdfs:label>
        <rdfs:label xml:lang="nl">antennehoogte</rdfs:label>
        <skos:definition xml:lang="en">Height of the GNSS antenna above the measured point.</skos:definition>
        <skos:definition xml:lang="nl">Hoogte van de GNSS antenne boven het ingemeten punt.</skos:definition>
        <eenheid rdf:resource="http://qudt.org/vocab/unit/M"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/apparatuurModel -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/apparatuurModel">
