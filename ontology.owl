        <rdfs:label xml:lang="nl">afwijking richting</rdfs:label>
        <rdfs:label xml:lang="en">deviation direction</rdfs:label>
        <skos:definition xml:lang="en">Direction of the horizontal deviation in degrees (0-360, where 0 = north).</skos:definition>
        <skos:definition xml:lang="nl">Richting van de horizontale afwijking in graden (0-360, waar 0 = noord).</skos:definition>
        <eenheid rdf:resource="http://qudt.org/vocab/unit/DEG"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/antenneHoogte -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/antenneHoogte">
