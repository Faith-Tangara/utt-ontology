    //
    // Datatypes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://www.w3.org/2001/XMLSchema#anyURI -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#anyURI">
        <prez:label>any URI</prez:label>
        <prez:label>anyURI</prez:label>
    </rdfs:Datatype>
    


    <!-- http://www.w3.org/2001/XMLSchema#date -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date">
        <prez:label>date</prez:label>
    </rdfs:Datatype>
    


    <!-- http://www.w3.org/2001/XMLSchema#dateTime -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#dateTime"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#decimal -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#decimal"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#double -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#double"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#string -->


    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#string"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://purl.org/dc/terms/format -->


    <owl:ObjectProperty rdf:about="http://purl.org/dc/terms/format">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/OndersteunendeData"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/DataFormaat"/>
        <rdfs:comment xml:lang="en">Reused from Dublin Core Terms. Links a supporting data file
    to its format (e.g. point cloud, photo, PDF). Replaces utt:bestandsFormaat from v0.1
    following reviewer recommendation to reuse dcterms:format.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://rdfs.org/ns/void#sparqlEndpoint -->


    <owl:ObjectProperty rdf:about="http://rdfs.org/ns/void#sparqlEndpoint">
        <rdfs:domain rdf:resource="http://rdfs.org/ns/void#Dataset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">The SPARQL endpoint that serves this dataset. Recorded per
    participating party so a federated query can be routed without a central store.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://rdfs.org/ns/void#vocabulary -->


    <owl:ObjectProperty rdf:about="http://rdfs.org/ns/void#vocabulary">
        <rdfs:domain rdf:resource="http://rdfs.org/ns/void#Dataset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">The vocabulary used by this dataset, normally the UTT ontology IRI.</rdfs:comment>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#hasGeometry -->


    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#hasGeometry">
        <prez:description xml:lang="en">A spatial representation for a given Feature.</prez:description>
        <prez:label xml:lang="en">has geometry</prez:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dcat#contactPoint -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dcat#contactPoint">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasAssociatedWith -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasAssociatedWith">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasDerivedFrom -->


    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasDerivedFrom">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/bestaatUitMeetpunt -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/bestaatUitMeetpunt">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/utt/def/Proefsleuf"/>
                    <rdf:Description rdf:about="https://w3id.org/utt/def/WaargenomenPositie"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/Meetpunt"/>
        <rdfs:comment xml:lang="en">Links an observed position to the individual survey points
    from which its geometry was constructed, so that a per point date and uncertainty stay
    traceable after the points have been joined into a line.</rdfs:comment>
        <rdfs:label xml:lang="nl">bestaat uit meetpunt</rdfs:label>
        <rdfs:label xml:lang="en">consists of survey point</rdfs:label>
        <skos:definition xml:lang="nl">Koppelt een waargenomen positie aan de afzonderlijke
    meetpunten waaruit de geometrie is opgebouwd.</skos:definition>
        <skos:definition xml:lang="en">Links an observed position to the individual survey
    points from which its geometry was constructed.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/bevatWaarneming -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/bevatWaarneming">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Mantelbuis"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/Waarneming"/>
        <rdfs:comment xml:lang="en">Used to represent nested utilities, where a sleeve (mantelbuis)
    physically contains other cables or pipes observed inside it.</rdfs:comment>
        <rdfs:label xml:lang="nl">bevat waarneming</rdfs:label>
        <rdfs:label xml:lang="en">contains observation</rdfs:label>
        <skos:definition xml:lang="en">Observation of a cable or pipe observed inside this
    sleeve.</skos:definition>
        <skos:definition xml:lang="nl">Waarneming van een kabel of leiding die binnen deze
    mantelbuis is waargenomen.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/bodemGeometrie -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/bodemGeometrie">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Proefsleuf"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
        <rdfs:comment xml:lang="en">The excavation floor outline, as distinct from the ground
    level outline carried by utt:sleufGeometrie. Added in v0.4 because contractor drawings
    deliver both outlines and a single geometry property cannot say which is which. The pair
    gives the excavated volume rather than only a footprint, and the floor level records how
    far the excavation actually reached, which is the exclusion evidence for utilities that
    could have been present but were not found.</rdfs:comment>
        <rdfs:label xml:lang="nl">bodemgeometrie</rdfs:label>
        <rdfs:label xml:lang="en">trench floor geometry</rdfs:label>
        <skos:definition xml:lang="nl">Omtrek van de bodem van de proefsleuf.</skos:definition>
        <skos:definition xml:lang="en">Outline of the floor of the test trench.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/coordinaatstelsel -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/coordinaatstelsel">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/CoordinaatStelsel"/>
        <rdfs:comment xml:lang="en">Declares the coordinate reference system of a geometry
    as a first-class resource, in addition to the CRS URI carried inside the geo:asWKT
    literal. Stated explicitly because UTT data combines a horizontal frame (RD New) with a
    separate vertical datum (NAP), which a single WKT CRS prefix does not always express.</rdfs:comment>
        <rdfs:label xml:lang="en">coordinate reference system</rdfs:label>
        <rdfs:label xml:lang="nl">coördinaatstelsel</rdfs:label>
        <skos:definition xml:lang="nl">Het coördinaatstelsel waarin deze geometrie is
    uitgedrukt.</skos:definition>
        <skos:definition xml:lang="en">The coordinate reference system in which this geometry
    is expressed.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/detailNiveau -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/detailNiveau">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/OndersteunendeData"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/DetailNiveau"/>
        <rdfs:comment xml:lang="en">Level of detail of the captured geometry, following the CityGML
    LoD concept.</rdfs:comment>
        <rdfs:label xml:lang="nl">detail niveau</rdfs:label>
        <rdfs:label xml:lang="en">level of detail</rdfs:label>
        <skos:definition xml:lang="nl">Detailniveau van de vastgelegde geometrie, aansluitend op
    het CityGML LoD concept.</skos:definition>
        <skos:definition xml:lang="en">Level of detail of the captured geometry, aligned to the
    CityGML LoD concept.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/diepteAangrijpingspunt -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/diepteAangrijpingspunt">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/utt/def/GeregistreerdePositie"/>
                    <rdf:Description rdf:about="https://w3id.org/utt/def/WaargenomenPositie"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/DiepteAangrijpingspuntValue"/>
        <rdfs:comment xml:lang="en">The reference point on the utility from which depth
    is measured. Must be explicitly declared per measurement; depth values are only meaningful
    when the reference point is known (top, axis, bottom, BOB for sewer, etc.).</rdfs:comment>
        <rdfs:label xml:lang="en">depth reference point</rdfs:label>
        <rdfs:label xml:lang="nl">diepte aangrijpingspunt</rdfs:label>
        <skos:definition xml:lang="nl">Het punt op het object waarop de diepte is gemeten
    (bovenkant, hart, onderkant, BOB). Hergebruikt IMKL waardelijst via rdfs:seeAlso.</skos:definition>
        <skos:definition xml:lang="en">The point on the utility where depth is measured
    (top, axis, bottom, invert). Mirrors the IMKL value list via rdfs:seeAlso.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/doelVanSleuf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/doelVanSleuf">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Proefsleuf"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/SleufDoel"/>
        <rdfs:comment xml:lang="en">Captures why the trench was excavated. The purpose drives the
    type and resolution of data that can be expected from the observation.</rdfs:comment>
        <rdfs:label xml:lang="nl">doel van sleuf</rdfs:label>
        <rdfs:label xml:lang="en">purpose of trench</rdfs:label>
        <skos:definition xml:lang="en">Reason the test trench was excavated (KLIC verification,
    new installation, maintenance, design investigation).</skos:definition>
        <skos:definition xml:lang="nl">Reden waarom de proefsleuf is gegraven (KLIC verificatie,
    nieuwe aanleg, onderhoud, ontwerp onderzoek).</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/feitelijkePositie -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/feitelijkePositie">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/PositieAfwijking"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/WaargenomenPositie"/>
        <rdfs:comment xml:lang="en">One of two positions compared to derive a deviation.
    This refers to the field-observed position measured during verification.</rdfs:comment>
        <rdfs:label xml:lang="en">actual position</rdfs:label>
        <rdfs:label xml:lang="nl">feitelijke positie</rdfs:label>
        <skos:definition xml:lang="nl">De in het veld waargenomen positie waartegen de
    verwachte positie wordt vergeleken.</skos:definition>
        <skos:definition xml:lang="en">The field-observed position against which the expected
    position is compared.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/gebruiktApparatuur -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/gebruiktApparatuur">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/VerificatieActiviteit"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/Meetapparatuur"/>
        <rdfs:comment xml:lang="en">Links a verification activity to the specific instrument
    used. Distinct from gebruiktMethode: the method is the technique (LiDAR), the equipment is
    the device (Leica BLK2GO).</rdfs:comment>
        <rdfs:label xml:lang="nl">gebruikt apparatuur</rdfs:label>
        <rdfs:label xml:lang="en">used equipment</rdfs:label>
        <skos:definition xml:lang="nl">Het instrument waarmee de meting is uitgevoerd.</skos:definition>
        <skos:definition xml:lang="en">The instrument with which the measurement was taken.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/gebruiktMethode -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/gebruiktMethode">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/VerificatieActiviteit"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/Meetmethode"/>
        <rdfs:comment xml:lang="en">Links the verification activity to the measurement method
    used.</rdfs:comment>
        <rdfs:label xml:lang="nl">gebruikt methode</rdfs:label>
        <rdfs:label xml:lang="en">used method</rdfs:label>
        <skos:definition xml:lang="nl">De meetmethode die is gebruikt.</skos:definition>
        <skos:definition xml:lang="en">The measurement method that was used.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/geregistreerdeGeometrie -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/geregistreerdeGeometrie">
        <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/GeregistreerdePositie"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
        <rdfs:comment xml:lang="en">Geometry of the position as held in the registry.</rdfs:comment>
        <rdfs:label xml:lang="nl">geregistreerde geometrie</rdfs:label>
        <rdfs:label xml:lang="en">registered geometry</rdfs:label>
        <skos:definition xml:lang="nl">Geometrie van de positie zoals vastgelegd in de registratie.</skos:definition>
        <skos:definition xml:lang="en">Geometry of the position as held in the registry.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/geverifieerdDoor -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/geverifieerdDoor">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Proefsleuf"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/VerificatieActiviteit"/>
        <rdfs:comment xml:lang="en">Links a test trench to the verification activity that produced its data.</rdfs:comment>
        <rdfs:label xml:lang="nl">geverifieerd door</rdfs:label>
        <rdfs:label xml:lang="en">verified by</rdfs:label>
        <skos:definition xml:lang="nl">De verificatie activiteit die deze proefsleuf heeft aangemaakt.</skos:definition>
        <skos:definition xml:lang="en">The verification activity that produced this test trench record.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/heeftAanvrager -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/heeftAanvrager">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Graafpolygoon"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:comment xml:lang="en">The party that submitted the area request.</rdfs:comment>
        <rdfs:label xml:lang="en">has requesting party</rdfs:label>
        <rdfs:label xml:lang="nl">heeft aanvrager</rdfs:label>
        <skos:definition xml:lang="nl">De partij die het gebiedsverzoek heeft ingediend.</skos:definition>
        <skos:definition xml:lang="en">The party that submitted the area request.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/heeftAfwijking -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/heeftAfwijking">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Waarneming"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/PositieAfwijking"/>
        <rdfs:comment xml:lang="en">Links an observation to a deviation record.</rdfs:comment>
        <rdfs:label xml:lang="en">has deviation</rdfs:label>
        <rdfs:label xml:lang="nl">heeft afwijking</rdfs:label>
        <skos:definition xml:lang="nl">Afwijking ten opzichte van de geregistreerde positie,
    afgeleid uit twee expliciete positie instanties.</skos:definition>
        <skos:definition xml:lang="en">Deviation from the registered position, derived from two
    explicit position instances.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/heeftBijdrager -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/heeftBijdrager">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Graafpolygoon"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:comment xml:lang="en">A party that contributed trench data in response to the
    area request. Multiple contributors are expected.</rdfs:comment>
        <rdfs:label xml:lang="en">has contributing party</rdfs:label>
        <rdfs:label xml:lang="nl">heeft bijdrager</rdfs:label>
        <skos:definition xml:lang="en">A party that contributed trench data in response to
    the area request.</skos:definition>
        <skos:definition xml:lang="nl">Een partij die proefsleufinformatie heeft bijgedragen
    in reactie op het gebiedsverzoek.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/heeftGrondCondities -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/heeftGrondCondities">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Proefsleuf"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/GrondCondities"/>
        <rdfs:comment xml:lang="en">Links a test trench to the observed ground conditions
    at the site (soil type, groundwater, compaction).</rdfs:comment>
        <rdfs:label xml:lang="en">has ground conditions</rdfs:label>
        <rdfs:label xml:lang="nl">heeft grond condities</rdfs:label>
        <skos:definition xml:lang="nl">De waargenomen grondcondities ter plaatse van de
    proefsleuf.</skos:definition>
        <skos:definition xml:lang="en">The observed ground conditions at the site of the
    test trench.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/heeftKenmerken -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/heeftKenmerken">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Waarneming"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/WaargenomenKenmerken"/>
        <rdfs:comment xml:lang="en">Links an observation to its observed physical characteristics.</rdfs:comment>
        <rdfs:label xml:lang="en">has characteristics</rdfs:label>
        <rdfs:label xml:lang="nl">heeft kenmerken</rdfs:label>
        <skos:definition xml:lang="en">Observed physical characteristics.</skos:definition>
        <skos:definition xml:lang="nl">Waargenomen fysieke kenmerken.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/heeftMeetapparatuur -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/heeftMeetapparatuur">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Meetpunt"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/Meetapparatuur"/>
        <rdfs:comment xml:lang="en">Links a survey point to the equipment used for that
    point.</rdfs:comment>
        <rdfs:label xml:lang="nl">gemeten met apparatuur</rdfs:label>
        <rdfs:label xml:lang="en">measured with equipment</rdfs:label>
        <skos:definition xml:lang="nl">Koppelt een meetpunt aan de gebruikte meetapparatuur.</skos:definition>
        <skos:definition xml:lang="en">Links a survey point to the equipment used.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/heeftNauwkeurigheid -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/heeftNauwkeurigheid">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/utt/def/GeregistreerdePositie"/>
                    <rdf:Description rdf:about="https://w3id.org/utt/def/WaargenomenPositie"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/Nauwkeurigheid"/>
        <rdfs:comment xml:lang="en">Accuracy is a property of the measured or registered
    position, not of the trench itself.</rdfs:comment>
        <rdfs:label xml:lang="en">has accuracy</rdfs:label>
        <rdfs:label xml:lang="nl">heeft nauwkeurigheid</rdfs:label>
        <skos:definition xml:lang="en">Accuracy indicator for this position.</skos:definition>
        <skos:definition xml:lang="nl">Nauwkeurigheidsindicator voor deze positie.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/heeftOndersteunendeData -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/heeftOndersteunendeData">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/utt/def/Proefsleuf"/>
                    <rdf:Description rdf:about="https://w3id.org/utt/def/Waarneming"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/OndersteunendeData"/>
        <rdfs:comment xml:lang="en">Links an observation or a whole trench to external
    supporting files such as photos, point clouds, or CAD drawings.</rdfs:comment>
        <rdfs:label xml:lang="en">has supporting data</rdfs:label>
        <rdfs:label xml:lang="nl">heeft ondersteunende data</rdfs:label>
        <skos:definition xml:lang="en">Reference to supporting data files.</skos:definition>
        <skos:definition xml:lang="nl">Verwijzing naar ondersteunende databestanden.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/heeftPositie -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/heeftPositie">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Waarneming"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/WaargenomenPositie"/>
        <rdfs:comment xml:lang="en">Links an observation to its field-verified position.</rdfs:comment>
        <rdfs:label xml:lang="en">has position</rdfs:label>
        <rdfs:label xml:lang="nl">heeft positie</rdfs:label>
        <skos:definition xml:lang="nl">De geverifieerde positie van deze waarneming.</skos:definition>
        <skos:definition xml:lang="en">The verified position of this observation.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/heeftStatus -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/heeftStatus">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Waarneming"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/WaarnemingStatus"/>
        <rdfs:comment xml:lang="en">Captures whether the observed utility matched the expected KLIC
    registration, deviated from it, or could not be identified at all.</rdfs:comment>
        <rdfs:label xml:lang="en">has status</rdfs:label>
        <rdfs:label xml:lang="nl">heeft status</rdfs:label>
        <skos:definition xml:lang="en">Status of the observation: expected, aberrant, or unknown
    (not identifiable).</skos:definition>
        <skos:definition xml:lang="nl">Status van de waarneming: verwacht, afwijkend, of onbekend
    (niet te identificeren).</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/heeftWaarneming -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/heeftWaarneming">
        <owl:inverseOf rdf:resource="https://w3id.org/utt/def/waargenomenIn"/>
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Proefsleuf"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/Waarneming"/>
        <rdfs:comment xml:lang="en">Links a trench to the observations made within it.</rdfs:comment>
        <rdfs:label xml:lang="en">has observation</rdfs:label>
        <rdfs:label xml:lang="nl">heeft waarneming</rdfs:label>
        <skos:definition xml:lang="en">Observations made in this test trench.</skos:definition>
        <skos:definition xml:lang="nl">Waarnemingen gedaan in deze proefsleuf.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/komtOvereenMet -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/komtOvereenMet">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Waarneming"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/ImklKabelOfLeiding"/>
        <rdfs:comment xml:lang="en">Links an observation to the registered asset in KLIC data
    when the correspondence can be established. The absence of this triple is meaningful and
    indicates an unregistered utility (orphan or weeslijding).</rdfs:comment>
        <rdfs:label xml:lang="en">corresponds to</rdfs:label>
        <rdfs:label xml:lang="nl">komt overeen met</rdfs:label>
        <skos:definition xml:lang="en">Reference to the registered IMKL object if identifiable.
    Absence of this relation indicates an unregistered utility.</skos:definition>
        <skos:definition xml:lang="nl">Verwijzing naar het geregistreerde IMKL object indien
    identificeerbaar. Afwezigheid van deze relatie duidt op een niet-geregistreerde
    utiliteit.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/nauwkeurigheidDiepteklasse -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/nauwkeurigheidDiepteklasse">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Nauwkeurigheid"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/NauwkeurigheidDiepteValue"/>
        <rdfs:comment xml:lang="en">Mirrors the IMKL depth accuracy value list via rdfs:seeAlso.</rdfs:comment>
        <rdfs:label xml:lang="en">accuracy depth class</rdfs:label>
        <rdfs:label xml:lang="nl">nauwkeurigheid diepte klasse</rdfs:label>
        <skos:definition xml:lang="en">Accuracy class for depth. Mirrors the IMKL value list.</skos:definition>
        <skos:definition xml:lang="nl">Nauwkeurigheidsklasse voor diepte. Hergebruikt IMKL waardelijst.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/nauwkeurigheidXYklasse -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/nauwkeurigheidXYklasse">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Nauwkeurigheid"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/NauwkeurigheidXYvalue"/>
        <rdfs:comment xml:lang="en">Mirrors the IMKL XY accuracy value list via rdfs:seeAlso.</rdfs:comment>
        <rdfs:label xml:lang="en">accuracy XY class</rdfs:label>
        <rdfs:label xml:lang="nl">nauwkeurigheid XY klasse</rdfs:label>
        <skos:definition xml:lang="en">Accuracy class for XY. Mirrors the IMKL value list.</skos:definition>
        <skos:definition xml:lang="nl">Nauwkeurigheidsklasse voor XY. Hergebruikt IMKL waardelijst.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/onderdeelVanDataset -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/onderdeelVanDataset">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Proefsleuf"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/UTTDataset"/>
        <rdfs:comment xml:lang="en">Links a trench record to the published dataset that holds
    it. This is what makes the federation discoverable.</rdfs:comment>
        <rdfs:label xml:lang="nl">onderdeel van dataset</rdfs:label>
        <rdfs:label xml:lang="en">part of dataset</rdfs:label>
        <skos:definition xml:lang="nl">De gepubliceerde dataset waarin deze proefsleuf is
    opgenomen.</skos:definition>
        <skos:definition xml:lang="en">The published dataset in which this test trench is
    held.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/onderdeelVanProject -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/onderdeelVanProject">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Proefsleuf"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/Project"/>
        <rdfs:comment xml:lang="en">Groups multiple trenches under a single excavation job or project.</rdfs:comment>
        <rdfs:label xml:lang="nl">onderdeel van project</rdfs:label>
        <rdfs:label xml:lang="en">part of project</rdfs:label>
        <skos:definition xml:lang="nl">Het project waartoe deze proefsleuf behoort.</skos:definition>
        <skos:definition xml:lang="en">The project that this test trench belongs to.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/onderdeelVanStelsel -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/onderdeelVanStelsel">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Waarneming"/>
        <rdfs:range rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="en">Links an observed utility to the network it belongs to,
    identified by an external IRI. UTT does not model networks itself.</rdfs:comment>
        <rdfs:label xml:lang="nl">onderdeel van stelsel</rdfs:label>
        <rdfs:label xml:lang="en">part of network</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://data.gwsw.nl/"/>
        <skos:definition xml:lang="nl">Het netwerk of stelsel waartoe de waargenomen kabel of
    leiding behoort, geïdentificeerd via een externe IRI.</skos:definition>
        <skos:definition xml:lang="en">The network to which the observed cable or pipe
    belongs, identified by an external IRI.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/opdrachtVan -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/opdrachtVan">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/VerificatieActiviteit"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/Aannemer"/>
        <rdfs:comment xml:lang="en">Links a verification activity to the contractor who commissioned it.</rdfs:comment>
        <rdfs:label xml:lang="en">commissioned by</rdfs:label>
        <rdfs:label xml:lang="nl">opdracht van</rdfs:label>
        <skos:definition xml:lang="nl">De aannemer die de verificatie heeft laten uitvoeren.</skos:definition>
        <skos:definition xml:lang="en">The contractor who commissioned the verification.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/positieGeometrie -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/positieGeometrie">
        <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/WaargenomenPositie"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
        <rdfs:comment xml:lang="en">3D point or line geometry of the observed position.</rdfs:comment>
        <rdfs:label xml:lang="nl">positie geometrie</rdfs:label>
        <rdfs:label xml:lang="en">position geometry</rdfs:label>
        <skos:definition xml:lang="en">3D point or line geometry of the observed position.</skos:definition>
        <skos:definition xml:lang="nl">3D punt of lijn geometrie van de waargenomen positie.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/registratieBron -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/registratieBron">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/GeregistreerdePositie"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/RegistratieBron"/>
        <rdfs:comment xml:lang="en">Identifies where a registered position was obtained from.</rdfs:comment>
        <rdfs:label xml:lang="nl">registratiebron</rdfs:label>
        <rdfs:label xml:lang="en">registration source</rdfs:label>
        <skos:definition xml:lang="nl">De bron waaruit de geregistreerde positie is
    overgenomen.</skos:definition>
        <skos:definition xml:lang="en">The source from which the registered position was
    obtained.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/sleufGeometrie -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/sleufGeometrie">
        <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Proefsleuf"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
        <rdfs:comment xml:lang="en">The 3D geometry of the trench.</rdfs:comment>
        <rdfs:label xml:lang="nl">sleuf geometrie</rdfs:label>
        <rdfs:label xml:lang="en">trench geometry</rdfs:label>
        <skos:definition xml:lang="nl">De 3D geometrie van de proefsleuf (contour, polygoon, of lijn).</skos:definition>
        <skos:definition xml:lang="en">The 3D geometry of the test trench (contour, polygon, or line).</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/uitgevoerdDoor -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/uitgevoerdDoor">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/ns/prov#wasAssociatedWith"/>
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/VerificatieActiviteit"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/Landmeter"/>
        <rdfs:comment xml:lang="en">Links a verification activity to the surveyor or organisation that performed it.</rdfs:comment>
        <rdfs:label xml:lang="en">performed by</rdfs:label>
        <rdfs:label xml:lang="nl">uitgevoerd door</rdfs:label>
        <skos:definition xml:lang="nl">De landmeter of organisatie die de meting heeft uitgevoerd.</skos:definition>
        <skos:definition xml:lang="en">The surveyor or organisation that performed the measurement.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/verwachtePositie -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/verwachtePositie">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/PositieAfwijking"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/GeregistreerdePositie"/>
        <rdfs:comment xml:lang="en">One of two positions compared to derive a deviation.
    This refers to the registered expected position.</rdfs:comment>
        <rdfs:label xml:lang="en">expected position</rdfs:label>
        <rdfs:label xml:lang="nl">verwachte positie</rdfs:label>
        <skos:definition xml:lang="nl">De geregistreerde verwachte positie, waartegen de
    feitelijke positie wordt vergeleken.</skos:definition>
        <skos:definition xml:lang="en">The registered expected position against which the
    actual position is compared.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/waargenomenIn -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/waargenomenIn">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Waarneming"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/Proefsleuf"/>
        <rdfs:comment xml:lang="en">Links an observation back to the trench in which it was made.</rdfs:comment>
        <rdfs:label xml:lang="en">observed in</rdfs:label>
        <rdfs:label xml:lang="nl">waargenomen in</rdfs:label>
        <skos:definition xml:lang="nl">De proefsleuf waarin deze waarneming is gedaan.</skos:definition>
        <skos:definition xml:lang="en">The test trench in which this observation was made.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/waargenomenMateriaal -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/waargenomenMateriaal">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/WaargenomenKenmerken"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/utt/def/ImklPipeMaterialTypeValue"/>
                    <rdf:Description rdf:about="https://w3id.org/utt/def/KabelConstructieValue"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Material type. Mirrors the IMKL PipeMaterialType value list via rdfs:seeAlso.</rdfs:comment>
        <rdfs:label xml:lang="en">observed material</rdfs:label>
        <rdfs:label xml:lang="nl">waargenomen materiaal</rdfs:label>
        <skos:definition xml:lang="nl">Materiaaltype. Hergebruikt IMKL PipeMaterialType waardelijst.</skos:definition>
        <skos:definition xml:lang="en">Material type. Mirrors the IMKL PipeMaterialType value list.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/utt/def/waargenomenType -->


    <owl:ObjectProperty rdf:about="https://w3id.org/utt/def/waargenomenType">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Waarneming"/>
        <rdfs:range rdf:resource="https://w3id.org/utt/def/ImklThema"/>
        <rdfs:comment xml:lang="en">Theme (type of utility) of the observed cable or pipe.</rdfs:comment>
        <rdfs:label xml:lang="en">observed type</rdfs:label>
        <rdfs:label xml:lang="nl">waargenomen type</rdfs:label>
        <skos:definition xml:lang="nl">Het type nutsvoorziening (thema) van de waargenomen
    kabel of leiding. Gebruikt IMKL Thema waardelijst.</skos:definition>
        <skos:definition xml:lang="en">The type of utility (theme) of the observed cable or
    pipe. Uses the IMKL Thema value list.</skos:definition>
    </owl:ObjectProperty>
    


