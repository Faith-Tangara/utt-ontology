    <rdf:Description rdf:about="http://www.w3.org/2002/07/owl#versionInfo">
        <prez:description>The annotation property that provides version information for an ontology or another OWL construct.</prez:description>
        <prez:label>versionInfo</prez:label>
    </rdf:Description>
    


