    <!-- https://w3id.org/utt/def/Aannemer -->


    <owl:Class rdf:about="https://w3id.org/utt/def/Aannemer">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:comment xml:lang="en">Contractor organisation responsible for the excavation work.</rdfs:comment>
        <rdfs:label xml:lang="nl">Aannemer</rdfs:label>
        <rdfs:label xml:lang="en">Contractor</rdfs:label>
        <skos:definition xml:lang="nl">Organisatie verantwoordelijk voor de graafwerkzaamheden.</skos:definition>
        <skos:definition xml:lang="en">Organisation responsible for the excavation work.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/CoordinaatStelsel -->


    <owl:Class rdf:about="https://w3id.org/utt/def/CoordinaatStelsel">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Top concept of the UTT coordinate reference system SKOS vocabulary.</rdfs:comment>
        <rdfs:label xml:lang="en">Coordinate Reference System</rdfs:label>
        <rdfs:label xml:lang="nl">Coördinaatstelsel</rdfs:label>
        <skos:definition xml:lang="en">Coordinate reference system in which geometry is expressed.</skos:definition>
        <skos:definition xml:lang="nl">Coördinaatstelsel waarin geometrie is uitgedrukt.</skos:definition>
        <skos:topConceptOf rdf:resource="https://w3id.org/utt/voc/CoordinaatStelselScheme"/>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/DataFormaat -->


    <owl:Class rdf:about="https://w3id.org/utt/def/DataFormaat">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Top concept of the UTT data format SKOS vocabulary.</rdfs:comment>
        <rdfs:label xml:lang="nl">Data Formaat</rdfs:label>
        <rdfs:label xml:lang="en">Data Format</rdfs:label>
        <skos:definition xml:lang="nl">Formaat van ondersteunend data bestand.</skos:definition>
        <skos:definition xml:lang="en">Format of a supporting data file.</skos:definition>
        <skos:topConceptOf rdf:resource="https://w3id.org/utt/voc/DataFormaatScheme"/>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/DetailNiveau -->


    <owl:Class rdf:about="https://w3id.org/utt/def/DetailNiveau">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Top concept of the UTT level of detail SKOS vocabulary.</rdfs:comment>
        <rdfs:label xml:lang="nl">Detail Niveau</rdfs:label>
        <rdfs:label xml:lang="en">Level of Detail</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.ogc.org/standards/citygml"/>
        <skos:definition xml:lang="nl">Detailniveau van vastgelegde geometrie.</skos:definition>
        <skos:definition xml:lang="en">Level of detail of captured geometry.</skos:definition>
        <skos:topConceptOf rdf:resource="https://w3id.org/utt/voc/DetailNiveauScheme"/>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/DiepteAangrijpingspuntValue -->


    <owl:Class rdf:about="https://w3id.org/utt/def/DiepteAangrijpingspuntValue">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Depth reference point dictionary. Mirrors the IMKL depth reference point list.</rdfs:comment>
        <rdfs:label xml:lang="en">Depth Reference Point Value</rdfs:label>
        <rdfs:label xml:lang="nl">Diepte Aangrijpingspunt Value</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://docs.geostandaarden.nl/kl/imkl/"/>
        <skos:definition xml:lang="nl">Aangrijpingspunt waarop diepte is gemeten, per meting expliciet gedeclareerd.</skos:definition>
        <skos:definition xml:lang="en">Reference point at which depth is measured, explicitly declared per measurement.</skos:definition>
        <skos:topConceptOf rdf:resource="https://w3id.org/utt/voc/DiepteAangrijpingspuntScheme"/>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/GeregistreerdePositie -->


    <owl:Class rdf:about="https://w3id.org/utt/def/GeregistreerdePositie">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">The expected position of a utility as recorded in a registry.</rdfs:comment>
        <rdfs:label xml:lang="nl">Geregistreerde Positie</rdfs:label>
        <rdfs:label xml:lang="en">Registered Position</rdfs:label>
        <skos:definition xml:lang="nl">De verwachte positie van een kabel of leiding volgens de registratie.</skos:definition>
        <skos:definition xml:lang="en">The expected position of a cable or pipe according to the registry.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/Graafpolygoon -->


    <owl:Class rdf:about="https://w3id.org/utt/def/Graafpolygoon">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment xml:lang="en">The polygon delineating the area for which underground
    utility information is requested. Declared as a subclass of geo:Feature so its geometry
    is carried via geo:hasGeometry.</rdfs:comment>
        <rdfs:label xml:lang="en">Excavation Polygon</rdfs:label>
        <rdfs:label xml:lang="nl">Graafpolygoon</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://docs.geostandaarden.nl/kl/pmkl30/"/>
        <skos:definition xml:lang="nl">Het polygoon dat het gebied afbakent waarvoor informatie
    over ondergrondse kabels en leidingen wordt opgevraagd.</skos:definition>
        <skos:definition xml:lang="en">The polygon delineating the area for which underground
    utility information is requested.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/GrondCondities -->


    <owl:Class rdf:about="https://w3id.org/utt/def/GrondCondities">
        <rdfs:comment xml:lang="en">Captures ground condition information at the trench.</rdfs:comment>
        <rdfs:label xml:lang="nl">Grond Condities</rdfs:label>
        <rdfs:label xml:lang="en">Ground Conditions</rdfs:label>
        <skos:definition xml:lang="nl">Grondcondities ter plaatse van de proefsleuf.</skos:definition>
        <skos:definition xml:lang="en">Ground conditions at the trench site.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/ImklKabelOfLeiding -->


    <owl:Class rdf:about="https://w3id.org/utt/def/ImklKabelOfLeiding">
        <rdfs:comment xml:lang="en">UTT bridge class used to represent a cable or pipe registered in KLIC/IMKL. IMKL is referenced as an external information model; this class is defined by UTT and is not an IMKL ontology class.</rdfs:comment>
        <rdfs:comment xml:lang="nl">UTT-brugklasse voor een kabel of leiding die in KLIC/IMKL is geregistreerd. IMKL wordt als extern informatiemodel gerefereerd; deze klasse is door UTT gedefinieerd en is geen IMKL-ontologieklasse.</rdfs:comment>
        <rdfs:label xml:lang="en">IMKL Cable or Pipe</rdfs:label>
        <rdfs:label xml:lang="nl">IMKL Kabel of Leiding</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://docs.geostandaarden.nl/kl/imkl/"/>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/ImklPipeMaterialTypeValue -->


    <owl:Class rdf:about="https://w3id.org/utt/def/ImklPipeMaterialTypeValue">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Material of the observed cable or pipe. Mirrors the
    IMKL PipeMaterialType value list.</rdfs:comment>
        <rdfs:label xml:lang="nl">Materiaal Value</rdfs:label>
        <rdfs:label xml:lang="en">Pipe Material Type Value</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://data.gwsw.nl/Totaal/Materiaal_leiding"/>
        <rdfs:seeAlso rdf:resource="https://docs.geostandaarden.nl/kl/imkl/"/>
        <skos:topConceptOf rdf:resource="https://w3id.org/utt/voc/MateriaalScheme"/>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/ImklThema -->


    <owl:Class rdf:about="https://w3id.org/utt/def/ImklThema">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Stub for the IMKL utility theme class.</rdfs:comment>
        <rdfs:label xml:lang="nl">IMKL Thema</rdfs:label>
        <rdfs:label xml:lang="en">IMKL Theme</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://docs.geostandaarden.nl/kl/imkl/"/>
        <skos:topConceptOf rdf:resource="https://w3id.org/utt/voc/ThemaScheme"/>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/KabelConstructieValue -->


    <owl:Class rdf:about="https://w3id.org/utt/def/KabelConstructieValue">
        <rdfs:comment xml:lang="en">Value list for cable constructions such as GPLK and coaxial cable.</rdfs:comment>
        <rdfs:label xml:lang="en">cable construction value</rdfs:label>
        <rdfs:label xml:lang="nl">kabelconstructie waarde</rdfs:label>
        <skos:definition xml:lang="en">Value list for cable constructions.</skos:definition>
        <skos:definition xml:lang="nl">Waardelijst voor kabelconstructies.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/Landmeter -->


    <owl:Class rdf:about="https://w3id.org/utt/def/Landmeter">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Agent"/>
        <rdfs:comment xml:lang="en">Person or organisation performing the field measurements.</rdfs:comment>
        <rdfs:label xml:lang="nl">Landmeter</rdfs:label>
        <rdfs:label xml:lang="en">Surveyor</rdfs:label>
        <skos:definition xml:lang="en">Person or organisation performing the measurements.</skos:definition>
        <skos:definition xml:lang="nl">Persoon of organisatie die de metingen uitvoert.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/Mantelbuis -->


    <owl:Class rdf:about="https://w3id.org/utt/def/Mantelbuis">
        <rdfs:subClassOf rdf:resource="https://w3id.org/utt/def/Waarneming"/>
        <rdfs:comment xml:lang="en">A sleeve or mantel tube observed in a trench, which physically
    contains other cables or pipes.</rdfs:comment>
        <rdfs:label xml:lang="nl">Mantelbuis</rdfs:label>
        <rdfs:label xml:lang="en">Sleeve</rdfs:label>
        <skos:definition xml:lang="en">A sleeve or mantel tube enclosing other cables or pipes.</skos:definition>
        <skos:definition xml:lang="nl">Mantelbuis die andere kabels of leidingen omhult.</skos:definition>
        <skos:exactMatch rdf:resource="https://data.gwsw.nl/Totaal/Mantelbuis"/>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/Meetapparatuur -->


    <owl:Class rdf:about="https://w3id.org/utt/def/Meetapparatuur">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">The physical instrument used to take a measurement.</rdfs:comment>
        <rdfs:label xml:lang="en">Measurement Equipment</rdfs:label>
        <rdfs:label xml:lang="nl">Meetapparatuur</rdfs:label>
        <skos:definition xml:lang="nl">Het fysieke instrument waarmee is gemeten.</skos:definition>
        <skos:definition xml:lang="en">The physical instrument used to measure.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/Meetmethode -->


    <owl:Class rdf:about="https://w3id.org/utt/def/Meetmethode">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Top concept of the UTT measurement methods SKOS vocabulary.</rdfs:comment>
        <rdfs:label xml:lang="en">Measurement Method</rdfs:label>
        <rdfs:label xml:lang="nl">Meetmethode</rdfs:label>
        <skos:definition xml:lang="nl">Techniek gebruikt voor positiebepaling.</skos:definition>
        <skos:definition xml:lang="en">Technique used for position determination.</skos:definition>
        <skos:topConceptOf rdf:resource="https://w3id.org/utt/voc/MeetmethodeScheme"/>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/Meetpunt -->


    <owl:Class rdf:about="https://w3id.org/utt/def/Meetpunt">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">A single point measured in the field, with its own number, its own
    survey date and its own uncertainty figure.</rdfs:comment>
        <rdfs:label xml:lang="nl">meetpunt</rdfs:label>
        <rdfs:label xml:lang="en">survey point</rdfs:label>
        <skos:definition xml:lang="en">A single point measured in the field, carrying its own point number, survey date and uncertainty.</skos:definition>
        <skos:definition xml:lang="nl">Een enkel in het veld ingemeten punt, met eigen puntnummer, opnamedatum en onzekerheid.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/Nauwkeurigheid -->


    <owl:Class rdf:about="https://w3id.org/utt/def/Nauwkeurigheid">
        <rdfs:comment xml:lang="en">Measurement accuracy indicator.</rdfs:comment>
        <rdfs:label xml:lang="en">Accuracy</rdfs:label>
        <rdfs:label xml:lang="nl">Nauwkeurigheid</rdfs:label>
        <skos:definition xml:lang="nl">Kwantitatieve onzekerheid van de gemeten positie.</skos:definition>
        <skos:definition xml:lang="en">Quantitative uncertainty of the measured position.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/NauwkeurigheidDiepteValue -->


    <owl:Class rdf:about="https://w3id.org/utt/def/NauwkeurigheidDiepteValue">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Depth accuracy classification. Mirrors the IMKL depth accuracy value list.</rdfs:comment>
        <rdfs:label xml:lang="en">Depth Accuracy Value</rdfs:label>
        <rdfs:label xml:lang="nl">Nauwkeurigheid Diepte Value</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://docs.geostandaarden.nl/kl/imkl/"/>
        <skos:definition xml:lang="en">Accuracy class for depth measurement.</skos:definition>
        <skos:definition xml:lang="nl">Nauwkeurigheidsklasse voor dieptemeting.</skos:definition>
        <skos:topConceptOf rdf:resource="https://w3id.org/utt/voc/NauwkeurigheidDiepteScheme"/>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/NauwkeurigheidXYvalue -->


    <owl:Class rdf:about="https://w3id.org/utt/def/NauwkeurigheidXYvalue">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">XY accuracy classification. Mirrors the IMKL XY accuracy value list.</rdfs:comment>
        <rdfs:label xml:lang="nl">Nauwkeurigheid XY Value</rdfs:label>
        <rdfs:label xml:lang="en">XY Accuracy Value</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://docs.geostandaarden.nl/kl/imkl/"/>
        <skos:definition xml:lang="en">Accuracy class for XY measurement.</skos:definition>
        <skos:definition xml:lang="nl">Nauwkeurigheidsklasse voor XY meting.</skos:definition>
        <skos:topConceptOf rdf:resource="https://w3id.org/utt/voc/NauwkeurigheidXYScheme"/>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/OndersteunendeData -->


    <owl:Class rdf:about="https://w3id.org/utt/def/OndersteunendeData">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">External supporting data such as point clouds, photos, CAD drawings, or reports.</rdfs:comment>
        <rdfs:label xml:lang="nl">Ondersteunende Data</rdfs:label>
        <rdfs:label xml:lang="en">Supporting Data</rdfs:label>
        <skos:definition xml:lang="en">Reference to external data files.</skos:definition>
        <skos:definition xml:lang="nl">Verwijzing naar externe databestanden.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/PositieAfwijking -->


    <owl:Class rdf:about="https://w3id.org/utt/def/PositieAfwijking">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">The deviation between the registered expected position and
    the field-observed actual position. This class is optional.</rdfs:comment>
        <rdfs:label xml:lang="nl">Positie Afwijking</rdfs:label>
        <rdfs:label xml:lang="en">Position Deviation</rdfs:label>
        <skos:definition xml:lang="nl">Afgeleide afwijking tussen verwachte en feitelijke positie.</skos:definition>
        <skos:definition xml:lang="en">Derived deviation between expected and actual position.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/Proefsleuf -->


    <owl:Class rdf:about="https://w3id.org/utt/def/Proefsleuf">
        <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:comment xml:lang="en">Central class of UTT.</rdfs:comment>
        <rdfs:label xml:lang="nl">Proefsleuf</rdfs:label>
        <rdfs:label xml:lang="en">Test Trench</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.ogc.org/standards/citygml"/>
        <skos:definition xml:lang="en">A physical excavation made to verify the location, depth
    and condition of underground cables and pipes.</skos:definition>
        <skos:definition xml:lang="nl">Een fysieke uitgraving gemaakt om de locatie, diepte en
    conditie van ondergrondse kabels en leidingen te verifiëren.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/Project -->


    <owl:Class rdf:about="https://w3id.org/utt/def/Project">
        <rdfs:comment xml:lang="en">The excavation project under which one or more test trenches are dug.</rdfs:comment>
        <rdfs:label xml:lang="en">Project</rdfs:label>
        <rdfs:label xml:lang="nl">Project</rdfs:label>
        <skos:definition xml:lang="nl">Het bouwproject waarbinnen de proefsleuf is gegraven.</skos:definition>
        <skos:definition xml:lang="en">The construction project under which the test trench was excavated.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/PuntClassificatie -->


    <owl:Class rdf:about="https://w3id.org/utt/def/PuntClassificatie">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Top concept of the UTT point classification SKOS vocabulary.</rdfs:comment>
        <rdfs:label xml:lang="en">Point Classification</rdfs:label>
        <rdfs:label xml:lang="nl">Puntclassificatie</rdfs:label>
        <skos:definition xml:lang="nl">Classificatie van een punt in een puntenwolk.</skos:definition>
        <skos:definition xml:lang="en">Classification of a point in a point cloud.</skos:definition>
        <skos:topConceptOf rdf:resource="https://w3id.org/utt/voc/PuntClassificatieScheme"/>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/RegistratieBron -->


    <owl:Class rdf:about="https://w3id.org/utt/def/RegistratieBron">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Top concept of the UTT registration source SKOS vocabulary.</rdfs:comment>
        <rdfs:label xml:lang="nl">Registratie Bron</rdfs:label>
        <rdfs:label xml:lang="en">Registration Source</rdfs:label>
        <skos:definition xml:lang="nl">Registratie waaruit een verwachte positie afkomstig is.</skos:definition>
        <skos:definition xml:lang="en">Registry from which an expected position was obtained.</skos:definition>
        <skos:topConceptOf rdf:resource="https://w3id.org/utt/voc/RegistratieBronScheme"/>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/SleufDoel -->


    <owl:Class rdf:about="https://w3id.org/utt/def/SleufDoel">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Top concept of the UTT trench purpose SKOS vocabulary.</rdfs:comment>
        <rdfs:label xml:lang="en">Purpose of Trench</rdfs:label>
        <rdfs:label xml:lang="nl">Sleuf Doel</rdfs:label>
        <skos:definition xml:lang="en">Reason the test trench was excavated.</skos:definition>
        <skos:definition xml:lang="nl">Reden waarom een proefsleuf wordt gegraven.</skos:definition>
        <skos:topConceptOf rdf:resource="https://w3id.org/utt/voc/SleufDoelScheme"/>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/UTTDataset -->


    <owl:Class rdf:about="https://w3id.org/utt/def/UTTDataset">
        <rdfs:subClassOf rdf:resource="http://rdfs.org/ns/void#Dataset"/>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
        <rdfs:comment xml:lang="en">A published collection of UTT trench records held by one party.</rdfs:comment>
        <rdfs:label xml:lang="en">UTT Dataset</rdfs:label>
        <rdfs:label xml:lang="nl">UTT Dataset</rdfs:label>
        <skos:definition xml:lang="en">A published collection of UTT trench records held by one party.</skos:definition>
        <skos:definition xml:lang="nl">Een gepubliceerde verzameling UTT proefsleufgegevens van één partij.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/VerificatieActiviteit -->


    <owl:Class rdf:about="https://w3id.org/utt/def/VerificatieActiviteit">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:comment xml:lang="en">The act of measuring and verifying the utilities observed in a trench.</rdfs:comment>
        <rdfs:label xml:lang="nl">Verificatie Activiteit</rdfs:label>
        <rdfs:label xml:lang="en">Verification Activity</rdfs:label>
        <skos:definition xml:lang="nl">De handeling van meten en verifiëren van de waarnemingen in een proefsleuf.</skos:definition>
        <skos:definition xml:lang="en">The act of measuring and verifying the observations in a trench.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/WaargenomenKenmerken -->


    <owl:Class rdf:about="https://w3id.org/utt/def/WaargenomenKenmerken">
        <rdfs:comment xml:lang="en">Physical characteristics of the cable or pipe as observed in the field.</rdfs:comment>
        <rdfs:label xml:lang="en">Observed Characteristics</rdfs:label>
        <rdfs:label xml:lang="nl">Waargenomen Kenmerken</rdfs:label>
        <skos:definition xml:lang="nl">Fysieke eigenschappen van de kabel of leiding zoals waargenomen in het veld.</skos:definition>
        <skos:definition xml:lang="en">Physical properties of the cable or pipe as observed in the field.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/WaargenomenPositie -->


    <owl:Class rdf:about="https://w3id.org/utt/def/WaargenomenPositie">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">The field-observed 3D position of a utility.</rdfs:comment>
        <rdfs:label xml:lang="en">Observed Position</rdfs:label>
        <rdfs:label xml:lang="nl">Waargenomen Positie</rdfs:label>
        <skos:definition xml:lang="nl">De in het veld gemeten 3D positie van een kabel of leiding.</skos:definition>
        <skos:definition xml:lang="en">The field-measured 3D position of a cable or pipe.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/Waarneming -->


    <owl:Class rdf:about="https://w3id.org/utt/def/Waarneming">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:comment xml:lang="en">A record of a cable or pipe observed in a test trench.</rdfs:comment>
        <rdfs:label xml:lang="en">Observation</rdfs:label>
        <rdfs:label xml:lang="nl">Waarneming</rdfs:label>
        <skos:definition xml:lang="en">A record of a cable or pipe observed in a test trench.</skos:definition>
        <skos:definition xml:lang="nl">Een registratie van een kabel of leiding die is waargenomen in een proefsleuf.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/utt/def/WaarnemingStatus -->


    <owl:Class rdf:about="https://w3id.org/utt/def/WaarnemingStatus">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
        <rdfs:comment xml:lang="en">Top concept of the UTT observation status SKOS vocabulary.</rdfs:comment>
        <rdfs:label xml:lang="en">Observation Status</rdfs:label>
        <rdfs:label xml:lang="nl">Waarneming Status</rdfs:label>
        <skos:definition xml:lang="en">Status of an observation with respect to the registry.</skos:definition>
        <skos:definition xml:lang="nl">Status van een waarneming ten opzichte van de registratie.</skos:definition>
        <skos:topConceptOf rdf:resource="https://w3id.org/utt/voc/WaarnemingStatusScheme"/>
    </owl:Class>
    


