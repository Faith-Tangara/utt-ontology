        <skos:definition xml:lang="en">The reference point was not recorded.</skos:definition>
        <skos:inScheme rdf:resource="https://w3id.org/utt/voc/DiepteAangrijpingspuntScheme"/>
        <skos:prefLabel xml:lang="nl">onbekend aangrijpingspunt</skos:prefLabel>
