        <skos:hasTopConcept rdf:resource="https://w3id.org/utt/def/WaarnemingStatus"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/utt/voc/aangrijpingspuntOnbekend -->


    <owl:NamedIndividual rdf:about="https://w3id.org/utt/voc/aangrijpingspuntOnbekend">
        <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
