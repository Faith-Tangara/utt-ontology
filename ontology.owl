        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Serial number of the instrument.</rdfs:comment>
        <rdfs:label xml:lang="nl">apparatuur serienummer</rdfs:label>
        <rdfs:label xml:lang="en">equipment serial number</rdfs:label>
        <skos:definition xml:lang="en">Serial number of the instrument.</skos:definition>
        <skos:definition xml:lang="nl">Serienummer van het instrument.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/bestandsReferentie -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/bestandsReferentie">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/OndersteunendeData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">URI reference to the external supporting data file.</rdfs:comment>
        <rdfs:label xml:lang="nl">bestands referentie</rdfs:label>
        <rdfs:label xml:lang="en">file reference</rdfs:label>
        <skos:definition xml:lang="en">URI reference to the external file.</skos:definition>
        <skos:definition xml:lang="nl">URI verwijzing naar het externe bestand.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/bodemElevatieNAP -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/bodemElevatieNAP">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Proefsleuf"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Elevation of the excavation floor relative to NAP.</rdfs:comment>
        <rdfs:label xml:lang="nl">bodemhoogte NAP</rdfs:label>
        <rdfs:label xml:lang="en">trench floor elevation NAP</rdfs:label>
        <skos:definition xml:lang="en">Elevation of the trench floor relative to NAP.</skos:definition>
        <skos:definition xml:lang="nl">Hoogte van de bodem van de proefsleuf ten opzichte van NAP.</skos:definition>
        <eenheid rdf:resource="http://qudt.org/vocab/unit/M"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/bodemType -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/bodemType">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/GrondCondities"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Observed soil type at the trench location.</rdfs:comment>
        <rdfs:label xml:lang="nl">bodem type</rdfs:label>
        <rdfs:label xml:lang="en">soil type</rdfs:label>
        <skos:definition xml:lang="en">Observed soil type (e.g. sand, clay, peat, mixed).</skos:definition>
        <skos:definition xml:lang="nl">Waargenomen bodemtype (bijv. zand, klei, veen, gemengd).</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/bronObjectId -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/bronObjectId">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/GeregistreerdePositie"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Identifier of the object in the source registry.</rdfs:comment>
        <rdfs:label xml:lang="nl">bron object ID</rdfs:label>
        <rdfs:label xml:lang="en">source object ID</rdfs:label>
        <skos:definition xml:lang="nl">Identificatie van het object in de bronregistratie.</skos:definition>
        <skos:definition xml:lang="en">Identifier of the object in the source registry.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/bronPeildatum -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/bronPeildatum">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/GeregistreerdePositie"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Date and time at which the registered position was retrieved from its source.</rdfs:comment>
        <rdfs:label xml:lang="nl">bron peildatum</rdfs:label>
        <rdfs:label xml:lang="en">source reference date</rdfs:label>
        <skos:definition xml:lang="en">Date and time at which the registered position was retrieved from its source.</skos:definition>
        <skos:definition xml:lang="nl">Datum en tijd waarop de geregistreerde positie uit de bron is opgehaald.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/bronService -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/bronService">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/GeregistreerdePositie"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:comment xml:lang="en">URI of the specific service endpoint the registered position was retrieved from.</rdfs:comment>
        <rdfs:label xml:lang="nl">bron service</rdfs:label>
        <rdfs:label xml:lang="en">source service</rdfs:label>
        <skos:definition xml:lang="en">URI of the service from which the registered position was retrieved.</skos:definition>
        <skos:definition xml:lang="nl">URI van de service waaruit de geregistreerde positie is opgehaald.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/classificatieCode -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/classificatieCode">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/PuntClassificatie"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="en">The integer value stored in the PLY class property for this category.</rdfs:comment>
        <rdfs:label xml:lang="nl">classificatiecode</rdfs:label>
        <rdfs:label xml:lang="en">classification code</rdfs:label>
        <skos:definition xml:lang="nl">De integerwaarde opgeslagen in de PLY class eigenschap.</skos:definition>
        <skos:definition xml:lang="en">The integer value stored in the PLY class property.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/compactheid -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/compactheid">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/GrondCondities"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Qualitative or quantitative description of soil compaction at the trench.</rdfs:comment>
        <rdfs:label xml:lang="nl">compactheid</rdfs:label>
        <rdfs:label xml:lang="en">compaction</rdfs:label>
        <skos:definition xml:lang="nl">Kwalitatieve of kwantitatieve beschrijving van de grondverdichting.</skos:definition>
        <skos:definition xml:lang="en">Qualitative or quantitative description of soil compaction.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/diepteNAP -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/diepteNAP">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/utt/def/GeregistreerdePositie"/>
                    <rdf:Description rdf:about="https://w3id.org/utt/def/WaargenomenPositie"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Elevation of the utility reference point relative to NAP (Normaal
    Amsterdams Peil), in meters.</rdfs:comment>
        <rdfs:label xml:lang="en">depth NAP</rdfs:label>
        <rdfs:label xml:lang="nl">diepte NAP</rdfs:label>
        <skos:definition xml:lang="en">Elevation of the utility reference point relative to NAP, in
    meters. Source of truth for depth.</skos:definition>
        <skos:definition xml:lang="nl">Hoogte van het aangrijpingspunt van de kabel/leiding ten
    opzichte van NAP, in meters. Bron van waarheid voor diepte.</skos:definition>
        <skos:scopeNote xml:lang="en">Both diepteNAP and diepteTovMaaiveld are retained because NAP
    elevation is the stable registration value that survives surface changes, while
    depth-of-cover relative to ground level is the value contractors actually collect and
    record in DXF deliveries. IMKL carries both. Removing depth-of-cover would leave the
    database empty wherever a contractor records only cover, while removing NAP would make
    values non-comparable across sites with different surface levels.</skos:scopeNote>
        <eenheid rdf:resource="http://qudt.org/vocab/unit/M"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/diepteTovMaaiveld -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/diepteTovMaaiveld">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/utt/def/GeregistreerdePositie"/>
                    <rdf:Description rdf:about="https://w3id.org/utt/def/WaargenomenPositie"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Depth of the utility reference point relative to the local
    ground surface, in meters. This is the value normally carried in contractor DXF and CAD
    output. The authoritative depth is diepteNAP.</rdfs:comment>
        <rdfs:label xml:lang="en">depth relative to ground level</rdfs:label>
        <rdfs:label xml:lang="nl">diepte t.o.v. maaiveld</rdfs:label>
        <skos:definition xml:lang="en">Depth of the utility reference point relative to the
    local ground surface, in meters. Derived; may shift if the ground surface changes.</skos:definition>
        <skos:definition xml:lang="nl">Diepte van het aangrijpingspunt van de kabel/leiding
    ten opzichte van het lokale maaiveld, in meters. Afgeleid; kan wijzigen bij
    maaiveldverandering.</skos:definition>
        <skos:scopeNote xml:lang="en">Retained alongside diepteNAP because contractor DXF
    deliveries record depth-of-cover relative to ground level, not NAP elevation. The
    authoritative value is diepteNAP; this property preserves the field-recorded value so
    the conversion can be audited.</skos:scopeNote>
        <eenheid rdf:resource="http://qudt.org/vocab/unit/M"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/grondwaterNiveau -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/grondwaterNiveau">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/GrondCondities"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Observed groundwater level at the trench, expressed as elevation relative to NAP in meters.</rdfs:comment>
        <rdfs:label xml:lang="nl">grondwater niveau</rdfs:label>
        <rdfs:label xml:lang="en">groundwater level</rdfs:label>
        <skos:definition xml:lang="en">Observed groundwater level relative to NAP in meters.</skos:definition>
        <skos:definition xml:lang="nl">Waargenomen grondwaterstand t.o.v. NAP in meters.</skos:definition>
        <eenheid rdf:resource="http://qudt.org/vocab/unit/M"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/horizontaleAfwijking -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/horizontaleAfwijking">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/PositieAfwijking"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Horizontal (XY) deviation in meters.</rdfs:comment>
        <rdfs:label xml:lang="en">horizontal deviation</rdfs:label>
        <rdfs:label xml:lang="nl">horizontale afwijking</rdfs:label>
        <skos:definition xml:lang="en">Horizontal (XY) deviation in meters.</skos:definition>
        <skos:definition xml:lang="nl">Horizontale (XY) afwijking in meters.</skos:definition>
        <eenheid rdf:resource="http://qudt.org/vocab/unit/M"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/horizontaleOnzekerheid -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/horizontaleOnzekerheid">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Nauwkeurigheid"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Horizontal (XY) measurement uncertainty in meters (1 sigma).</rdfs:comment>
        <rdfs:label xml:lang="en">horizontal uncertainty</rdfs:label>
        <rdfs:label xml:lang="nl">horizontale onzekerheid</rdfs:label>
        <skos:definition xml:lang="en">Horizontal (XY) uncertainty in meters (1 sigma).</skos:definition>
        <skos:definition xml:lang="nl">Horizontale (XY) onzekerheid in meters (1 sigma).</skos:definition>
        <eenheid rdf:resource="http://qudt.org/vocab/unit/M"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/kalibratieDatum -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/kalibratieDatum">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Meetapparatuur"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date of last calibration.</rdfs:comment>
        <rdfs:label xml:lang="en">calibration date</rdfs:label>
        <rdfs:label xml:lang="nl">kalibratie datum</rdfs:label>
        <skos:definition xml:lang="en">Date of last calibration.</skos:definition>
        <skos:definition xml:lang="nl">Datum van laatste kalibratie.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/klicObjectId -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/klicObjectId">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/ImklKabelOfLeiding"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Persistent identifier for a registered utility object, stable
    across multiple KLIC meldingen.</rdfs:comment>
        <rdfs:label xml:lang="en">KLIC object ID</rdfs:label>
        <rdfs:label xml:lang="nl">KLIC object ID</rdfs:label>
        <skos:definition xml:lang="en">Persistent identifier of a registered cable or pipe.</skos:definition>
        <skos:definition xml:lang="nl">Persistente identifier van een geregistreerde kabel of leiding.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/leverancierCode -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/leverancierCode">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Waarneming"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The contractor&apos;s own classification code for the observation,
    retained verbatim.</rdfs:comment>
        <rdfs:label xml:lang="nl">leverancierscode</rdfs:label>
        <rdfs:label xml:lang="en">supplier code</rdfs:label>
        <skos:definition xml:lang="nl">De eigen classificatiecode van de aannemer, letterlijk bewaard.</skos:definition>
        <skos:definition xml:lang="en">The contractor&apos;s own classification code, retained verbatim.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/maaiveldElevatieNAP -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/maaiveldElevatieNAP">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Proefsleuf"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Elevation of the ground surface at the trench, relative to NAP in meters.</rdfs:comment>
        <rdfs:label xml:lang="en">ground surface elevation NAP</rdfs:label>
        <rdfs:label xml:lang="nl">maaiveld elevatie NAP</rdfs:label>
        <skos:definition xml:lang="en">Ground surface elevation at the trench relative to NAP in meters.</skos:definition>
        <skos:definition xml:lang="nl">Hoogte van het maaiveld ter plaatse van de proefsleuf t.o.v. NAP in meters.</skos:definition>
        <eenheid rdf:resource="http://qudt.org/vocab/unit/M"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/opnameDatum -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/opnameDatum">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Meetpunt"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
        <rdfs:comment xml:lang="en">Date on which this individual point was measured.</rdfs:comment>
        <rdfs:label xml:lang="nl">opnamedatum</rdfs:label>
        <rdfs:label xml:lang="en">survey date</rdfs:label>
        <skos:definition xml:lang="en">Date on which this individual point was measured.</skos:definition>
        <skos:definition xml:lang="nl">Datum waarop dit punt is ingemeten.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/prismaHoogte -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/prismaHoogte">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Meetapparatuur"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Height of the prism above the measured point for total station work.</rdfs:comment>
        <rdfs:label xml:lang="en">prism height</rdfs:label>
        <rdfs:label xml:lang="nl">prismahoogte</rdfs:label>
        <skos:definition xml:lang="en">Height of the prism above the measured point.</skos:definition>
        <skos:definition xml:lang="nl">Hoogte van het prisma boven het ingemeten punt.</skos:definition>
        <eenheid rdf:resource="http://qudt.org/vocab/unit/M"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/projectNaam -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/projectNaam">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Name of the excavation project.</rdfs:comment>
        <rdfs:label xml:lang="nl">project naam</rdfs:label>
        <rdfs:label xml:lang="en">project name</rdfs:label>
        <skos:definition xml:lang="nl">Naam van het project.</skos:definition>
        <skos:definition xml:lang="en">Name of the project.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/projectNummer -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/projectNummer">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Project"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Identifier of the excavation project.</rdfs:comment>
        <rdfs:label xml:lang="en">project number</rdfs:label>
        <rdfs:label xml:lang="nl">project nummer</rdfs:label>
        <skos:definition xml:lang="en">Number/identifier of the project.</skos:definition>
        <skos:definition xml:lang="nl">Nummer/identificatie van het project.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/puntNummer -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/puntNummer">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Meetpunt"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">The surveyor&apos;s own point number as delivered.</rdfs:comment>
        <rdfs:label xml:lang="en">point number</rdfs:label>
        <rdfs:label xml:lang="nl">puntnummer</rdfs:label>
        <skos:definition xml:lang="nl">Puntnummer van de landmeter zoals aangeleverd.</skos:definition>
        <skos:definition xml:lang="en">The surveyor&apos;s own point number as delivered.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/puntOnzekerheid -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/puntOnzekerheid">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Meetpunt"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">The single combined uncertainty figure reported by the instrument for one point.</rdfs:comment>
        <rdfs:label xml:lang="en">point uncertainty</rdfs:label>
        <rdfs:label xml:lang="nl">puntonzekerheid</rdfs:label>
        <skos:definition xml:lang="nl">De gecombineerde onzekerheid die het instrument voor een punt rapporteert.</skos:definition>
        <skos:definition xml:lang="en">The single combined uncertainty figure reported by the instrument for one point.</skos:definition>
        <eenheid rdf:resource="http://qudt.org/vocab/unit/M"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/sleufBreedte -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/sleufBreedte">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Proefsleuf"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Width of the test trench in meters.</rdfs:comment>
        <rdfs:label xml:lang="nl">sleuf breedte</rdfs:label>
        <rdfs:label xml:lang="en">trench width</rdfs:label>
        <skos:definition xml:lang="nl">Breedte van de proefsleuf in meters.</skos:definition>
        <skos:definition xml:lang="en">Width of the test trench in meters.</skos:definition>
        <eenheid rdf:resource="http://qudt.org/vocab/unit/M"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/sleufDiepte -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/sleufDiepte">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Proefsleuf"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Maximum excavated depth of the trench itself, in meters.</rdfs:comment>
        <rdfs:label xml:lang="nl">sleuf diepte</rdfs:label>
        <rdfs:label xml:lang="en">trench excavated depth</rdfs:label>
        <skos:definition xml:lang="nl">Maximale uitgegraven diepte van de proefsleuf in meters.</skos:definition>
        <skos:definition xml:lang="en">Maximum excavated depth of the trench in meters.</skos:definition>
        <eenheid rdf:resource="http://qudt.org/vocab/unit/M"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/sleufLengte -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/sleufLengte">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Proefsleuf"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Length of the test trench in meters.</rdfs:comment>
        <rdfs:label xml:lang="nl">sleuf lengte</rdfs:label>
        <rdfs:label xml:lang="en">trench length</rdfs:label>
        <skos:definition xml:lang="nl">Lengte van de proefsleuf in meters.</skos:definition>
        <skos:definition xml:lang="en">Length of the test trench in meters.</skos:definition>
        <eenheid rdf:resource="http://qudt.org/vocab/unit/M"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/typeAanduiding -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/typeAanduiding">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/WaargenomenKenmerken"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A manufacturer or trade designation such as a cable type code.</rdfs:comment>
        <rdfs:label xml:lang="en">type designation</rdfs:label>
        <rdfs:label xml:lang="nl">typeaanduiding</rdfs:label>
        <skos:definition xml:lang="en">A manufacturer or trade designation, for example a cable type code.</skos:definition>
        <skos:definition xml:lang="nl">Fabrikants- of handelsaanduiding, bijvoorbeeld een kabeltypecode.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/verificatieDatum -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/verificatieDatum">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/VerificatieActiviteit"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="en">Date and time the verification was performed.</rdfs:comment>
        <rdfs:label xml:lang="nl">verificatie datum</rdfs:label>
        <rdfs:label xml:lang="en">verification date</rdfs:label>
        <skos:definition xml:lang="en">Date and time the verification was performed.</skos:definition>
        <skos:definition xml:lang="nl">Datum en tijd waarop de verificatie is uitgevoerd.</skos:definition>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/verticaleAfwijking -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/verticaleAfwijking">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/PositieAfwijking"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Vertical (depth) deviation in metres. Signed: positive means the utility was
    found shallower than registered.</rdfs:comment>
        <rdfs:label xml:lang="en">vertical deviation</rdfs:label>
        <rdfs:label xml:lang="nl">verticale afwijking</rdfs:label>
        <skos:definition xml:lang="en">Vertical (depth) deviation in metres.</skos:definition>
        <skos:definition xml:lang="nl">Verticale (diepte) afwijking in meters.</skos:definition>
        <eenheid rdf:resource="http://qudt.org/vocab/unit/M"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/verticaleOnzekerheid -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/verticaleOnzekerheid">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/Nauwkeurigheid"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Vertical (depth) measurement uncertainty in metres (1 sigma).</rdfs:comment>
        <rdfs:label xml:lang="en">vertical uncertainty</rdfs:label>
        <rdfs:label xml:lang="nl">verticale onzekerheid</rdfs:label>
        <skos:definition xml:lang="en">Vertical (depth) uncertainty in metres (1 sigma).</skos:definition>
        <skos:definition xml:lang="nl">Verticale (diepte) onzekerheid in meters (1 sigma).</skos:definition>
        <eenheid rdf:resource="http://qudt.org/vocab/unit/M"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/waargenomenDiameter -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/waargenomenDiameter">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/WaargenomenKenmerken"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="en">Outer diameter of the cable or pipe in millimeters.</rdfs:comment>
        <rdfs:label xml:lang="en">observed diameter</rdfs:label>
        <rdfs:label xml:lang="nl">waargenomen diameter</rdfs:label>
        <skos:definition xml:lang="nl">Buitendiameter van de kabel of leiding in millimeters.</skos:definition>
        <skos:definition xml:lang="en">Outer diameter of the cable or pipe in millimeters.</skos:definition>
        <eenheid rdf:resource="http://qudt.org/vocab/unit/MilliM"/>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/utt/def/waargenomenKleur -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/utt/def/waargenomenKleur">
        <rdfs:domain rdf:resource="https://w3id.org/utt/def/WaargenomenKenmerken"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">Colour of the cable, pipe, or marking as observed in the field.</rdfs:comment>
        <rdfs:label xml:lang="en">observed color</rdfs:label>
        <rdfs:label xml:lang="nl">waargenomen kleur</rdfs:label>
        <skos:definition xml:lang="en">Colour of the cable, pipe or marking as observed in the field.</skos:definition>
        <skos:definition xml:lang="nl">Kleur van de kabel, leiding of markering zoals waargenomen in het veld.</skos:definition>
    </owl:DatatypeProperty>
    


