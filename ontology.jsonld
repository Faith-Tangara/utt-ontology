    "@language" : "en",
    "@value" : "Qualitative or quantitative description of soil compaction."
  } ]
}, {
  "@id" : "https://w3id.org/utt/def/coordinaatstelsel",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Declares the coordinate reference system of a geometry\n    as a first-class resource, in addition to the CRS URI carried inside the geo:asWKT\n    literal. Stated explicitly because UTT data combines a horizontal frame (RD New) with a\n    separate vertical datum (NAP), which a single WKT CRS prefix does not always express."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "http://www.opengis.net/ont/geosparql#Geometry"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "coordinate reference system"
  }, {
    "@language" : "nl",
    "@value" : "coördinaatstelsel"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/utt/def/CoordinaatStelsel"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "nl",
    "@value" : "Het coördinaatstelsel waarin deze geometrie is\n    uitgedrukt."
  }, {
    "@language" : "en",
    "@value" : "The coordinate reference system in which this geometry\n    is expressed."
  } ]
}, {
  "@id" : "https://w3id.org/utt/def/detailNiveau",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Level of detail of the captured geometry, following the CityGML\n    LoD concept."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/utt/def/OndersteunendeData"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "nl",
    "@value" : "detail niveau"
  }, {
    "@language" : "en",
    "@value" : "level of detail"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/utt/def/DetailNiveau"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "nl",
    "@value" : "Detailniveau van de vastgelegde geometrie, aansluitend op\n    het CityGML LoD concept."
  }, {
    "@language" : "en",
    "@value" : "Level of detail of the captured geometry, aligned to the\n    CityGML LoD concept."
  } ]
}, {
  "@id" : "https://w3id.org/utt/def/diepteAangrijpingspunt",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The reference point on the utility from which depth\n    is measured. Must be explicitly declared per measurement; depth values are only meaningful\n    when the reference point is known (top, axis, bottom, BOB for sewer, etc.)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid4"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "depth reference point"
  }, {
    "@language" : "nl",
    "@value" : "diepte aangrijpingspunt"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/utt/def/DiepteAangrijpingspuntValue"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "nl",
    "@value" : "Het punt op het object waarop de diepte is gemeten\n    (bovenkant, hart, onderkant, BOB). Hergebruikt IMKL waardelijst via rdfs:seeAlso."
  }, {
    "@language" : "en",
    "@value" : "The point on the utility where depth is measured\n    (top, axis, bottom, invert). Mirrors the IMKL value list via rdfs:seeAlso."
  } ]
}, {
  "@id" : "https://w3id.org/utt/def/diepteNAP",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Elevation of the utility reference point relative to NAP (Normaal\n    Amsterdams Peil), in meters."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid16"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "depth NAP"
  }, {
    "@language" : "nl",
    "@value" : "diepte NAP"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#decimal"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Elevation of the utility reference point relative to NAP, in\n    meters. Source of truth for depth."
  }, {
    "@language" : "nl",
    "@value" : "Hoogte van het aangrijpingspunt van de kabel/leiding ten\n    opzichte van NAP, in meters. Bron van waarheid voor diepte."
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Both diepteNAP and diepteTovMaaiveld are retained because NAP\n    elevation is the stable registration value that survives surface changes, while\n    depth-of-cover relative to ground level is the value contractors actually collect and\n    record in DXF deliveries. IMKL carries both. Removing depth-of-cover would leave the\n    database empty wherever a contractor records only cover, while removing NAP would make\n    values non-comparable across sites with different surface levels."
  } ],
  "https://w3id.org/utt/def/eenheid" : [ {
    "@id" : "http://qudt.org/vocab/unit/M"
  } ]
}, {
  "@id" : "https://w3id.org/utt/def/diepteTovMaaiveld",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Depth of the utility reference point relative to the local\n    ground surface, in meters. This is the value normally carried in contractor DXF and CAD\n    output. The authoritative depth is diepteNAP."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "_:genid19"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "depth relative to ground level"
  }, {
    "@language" : "nl",
    "@value" : "diepte t.o.v. maaiveld"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#decimal"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Depth of the utility reference point relative to the\n    local ground surface, in meters. Derived; may shift if the ground surface changes."
  }, {
    "@language" : "nl",
    "@value" : "Diepte van het aangrijpingspunt van de kabel/leiding\n    ten opzichte van het lokale maaiveld, in meters. Afgeleid; kan wijzigen bij\n    maaiveldverandering."
  } ],
  "http://www.w3.org/2004/02/skos/core#scopeNote" : [ {
    "@language" : "en",
    "@value" : "Retained alongside diepteNAP because contractor DXF\n    deliveries record depth-of-cover relative to ground level, not NAP elevation. The\n    authoritative value is diepteNAP; this property preserves the field-recorded value so\n    the conversion can be audited."
  } ],
  "https://w3id.org/utt/def/eenheid" : [ {
    "@id" : "http://qudt.org/vocab/unit/M"
  } ]
}, {
  "@id" : "https://w3id.org/utt/def/doelVanSleuf",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Captures why the trench was excavated. The purpose drives the\n    type and resolution of data that can be expected from the observation."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/utt/def/Proefsleuf"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "nl",
    "@value" : "doel van sleuf"
  }, {
    "@language" : "en",
    "@value" : "purpose of trench"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/utt/def/SleufDoel"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Reason the test trench was excavated (KLIC verification,\n    new installation, maintenance, design investigation)."
  }, {
    "@language" : "nl",
    "@value" : "Reden waarom de proefsleuf is gegraven (KLIC verificatie,\n    nieuwe aanleg, onderhoud, ontwerp onderzoek)."
  } ]
}, {
  "@id" : "https://w3id.org/utt/def/eenheid",
  "@type" : [ "http://www.w3.org/2002/07/owl#AnnotationProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Declares the unit in which values of the annotated datatype property\n    are expressed. Values are QUDT unit individuals, so the unit itself is identified by a\n    QUDT IRI and is machine resolvable.\n\n    A local annotation property is used rather than a QUDT predicate for two reasons. First,\n    qudt:unit is deprecated in QUDT 2.1 and marked dcterms:isReplacedBy qudt:hasUnit. Second,\n    qudt:hasUnit relates a system of units to a unit, which is a different relationship from\n    the one needed here. QUDT provides no predicate for annotating an owl:DatatypeProperty\n    with the unit its values carry, because QUDT expects measurements to be reified as\n    qudt:QuantityValue instances.\n\n    UTT deliberately records plain xsd:decimal values rather than reified quantity values,\n    since contractors supply flat numeric fields and reification would add a node per\n    measurement for no practical gain. This property states the expected unit for producers\n    and consumers of that data. It is documentation, not a quantity construction, and no\n    reasoner will derive unit conversion from it."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "nl",
    "@value" : "eenheid"
  }, {
    "@language" : "en",
    "@value" : "unit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://qudt.org/schema/qudt/Unit"
  } ]
}, {
  "@id" : "https://w3id.org/utt/def/feitelijkePositie",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "One of two positions compared to derive a deviation.\n    This refers to the field-observed position measured during verification."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/utt/def/PositieAfwijking"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "actual position"
  }, {
    "@language" : "nl",
    "@value" : "feitelijke positie"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/utt/def/WaargenomenPositie"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "nl",
    "@value" : "De in het veld waargenomen positie waartegen de\n    verwachte positie wordt vergeleken."
  }, {
    "@language" : "en",
    "@value" : "The field-observed position against which the expected\n    position is compared."
  } ]
}, {
  "@id" : "https://w3id.org/utt/def/gebruiktApparatuur",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a verification activity to the specific instrument\n    used. Distinct from gebruiktMethode: the method is the technique (LiDAR), the equipment is\n    the device (Leica BLK2GO)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/utt/def/VerificatieActiviteit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "nl",
    "@value" : "gebruikt apparatuur"
  }, {
    "@language" : "en",
    "@value" : "used equipment"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/utt/def/Meetapparatuur"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "nl",
    "@value" : "Het instrument waarmee de meting is uitgevoerd."
  }, {
    "@language" : "en",
    "@value" : "The instrument with which the measurement was taken."
  } ]
}, {
  "@id" : "https://w3id.org/utt/def/gebruiktMethode",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links the verification activity to the measurement method\n    used."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/utt/def/VerificatieActiviteit"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "nl",
    "@value" : "gebruikt methode"
  }, {
    "@language" : "en",
    "@value" : "used method"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/utt/def/Meetmethode"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "nl",
    "@value" : "De meetmethode die is gebruikt."
  }, {
    "@language" : "en",
    "@value" : "The measurement method that was used."
  } ]
}, {
  "@id" : "https://w3id.org/utt/def/geregistreerdeGeometrie",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Geometry of the position as held in the registry."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/utt/def/GeregistreerdePositie"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "nl",
    "@value" : "geregistreerde geometrie"
  }, {
    "@language" : "en",
    "@value" : "registered geometry"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.opengis.net/ont/geosparql#Geometry"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#subPropertyOf" : [ {
    "@id" : "http://www.opengis.net/ont/geosparql#hasGeometry"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "nl",
    "@value" : "Geometrie van de positie zoals vastgelegd in de registratie."
  }, {
    "@language" : "en",
    "@value" : "Geometry of the position as held in the registry."
  } ]
}, {
  "@id" : "https://w3id.org/utt/def/geverifieerdDoor",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a test trench to the verification activity that produced its data."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/utt/def/Proefsleuf"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "nl",
    "@value" : "geverifieerd door"
  }, {
    "@language" : "en",
    "@value" : "verified by"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/utt/def/VerificatieActiviteit"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "nl",
    "@value" : "De verificatie activiteit die deze proefsleuf heeft aangemaakt."
  }, {
    "@language" : "en",
    "@value" : "The verification activity that produced this test trench record."
  } ]
}, {
  "@id" : "https://w3id.org/utt/def/grondwaterNiveau",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Observed groundwater level at the trench, expressed as elevation relative to NAP in meters."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/utt/def/GrondCondities"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "nl",
    "@value" : "grondwater niveau"
  }, {
    "@language" : "en",
    "@value" : "groundwater level"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/2001/XMLSchema#decimal"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "Observed groundwater level relative to NAP in meters."
  }, {
    "@language" : "nl",
    "@value" : "Waargenomen grondwaterstand t.o.v. NAP in meters."
  } ],
  "https://w3id.org/utt/def/eenheid" : [ {
    "@id" : "http://qudt.org/vocab/unit/M"
  } ]
}, {
  "@id" : "https://w3id.org/utt/def/heeftAanvrager",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The party that submitted the area request."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/utt/def/Graafpolygoon"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has requesting party"
  }, {
    "@language" : "nl",
    "@value" : "heeft aanvrager"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/ns/prov#Agent"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "nl",
    "@value" : "De partij die het gebiedsverzoek heeft ingediend."
  }, {
    "@language" : "en",
    "@value" : "The party that submitted the area request."
  } ]
}, {
  "@id" : "https://w3id.org/utt/def/heeftAfwijking",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links an observation to a deviation record."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/utt/def/Waarneming"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has deviation"
  }, {
    "@language" : "nl",
    "@value" : "heeft afwijking"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/utt/def/PositieAfwijking"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "nl",
    "@value" : "Afwijking ten opzichte van de geregistreerde positie,\n    afgeleid uit twee expliciete positie instanties."
  }, {
    "@language" : "en",
    "@value" : "Deviation from the registered position, derived from two\n    explicit position instances."
  } ]
}, {
  "@id" : "https://w3id.org/utt/def/heeftBijdrager",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "A party that contributed trench data in response to the\n    area request. Multiple contributors are expected."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/utt/def/Graafpolygoon"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has contributing party"
  }, {
    "@language" : "nl",
    "@value" : "heeft bijdrager"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "http://www.w3.org/ns/prov#Agent"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "en",
    "@value" : "A party that contributed trench data in response to\n    the area request."
  }, {
    "@language" : "nl",
    "@value" : "Een partij die proefsleufinformatie heeft bijgedragen\n    in reactie op het gebiedsverzoek."
  } ]
}, {
  "@id" : "https://w3id.org/utt/def/heeftGrondCondities",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links a test trench to the observed ground conditions\n    at the site (soil type, groundwater, compaction)."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/utt/def/Proefsleuf"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "has ground conditions"
  }, {
    "@language" : "nl",
    "@value" : "heeft grond condities"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#range" : [ {
    "@id" : "https://w3id.org/utt/def/GrondCondities"
  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "nl",
    "@value" : "De waargenomen grondcondities ter plaatse van de\n    proefsleuf."
  }, {
    "@language" : "en",
    "@value" : "The observed ground conditions at the site of the\n    test trench."
  } ]
}, {
  "@id" : "https://w3id.org/utt/def/heeftKenmerken",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "Links an observation to its observed physical characteristics."
  } ],
