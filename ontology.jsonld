}, {
  "@id" : "https://w3id.org/utt/def/bodemGeometrie",
  "@type" : [ "http://www.w3.org/2002/07/owl#ObjectProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
    "@language" : "en",
    "@value" : "The excavation floor outline, as distinct from the ground\n    level outline carried by utt:sleufGeometrie. Added in v0.4 because contractor drawings\n    deliver both outlines and a single geometry property cannot say which is which. The pair\n    gives the excavated volume rather than only a footprint, and the floor level records how\n    far the excavation actually reached, which is the exclusion evidence for utilities that\n    could have been present but were not found."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#domain" : [ {
    "@id" : "https://w3id.org/utt/def/Proefsleuf"
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "nl",
    "@value" : "bodemgeometrie"
  }, {
    "@language" : "en",
