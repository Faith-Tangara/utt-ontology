  } ],
  "http://www.w3.org/2004/02/skos/core#definition" : [ {
    "@language" : "nl",
    "@value" : "Omtrek van de bodem van de proefsleuf."
  }, {
    "@language" : "en",
    "@value" : "Outline of the floor of the test trench."
  } ]
