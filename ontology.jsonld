    "@value" : "URI van de service waaruit de geregistreerde positie is opgehaald."
  } ]
}, {
  "@id" : "https://w3id.org/utt/def/classificatieCode",
  "@type" : [ "http://www.w3.org/2002/07/owl#DatatypeProperty" ],
  "http://www.w3.org/2000/01/rdf-schema#comment" : [ {
