    rdfs:subClassOf prov:Activity ;
    skos:definition "The act of measuring and verifying the observations in a trench."@en,
        "De handeling van meten en verifiëren van de waarnemingen in een proefsleuf."@nl .

uttvoc:MeetmethodeScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "UTT Measurement Methods Vocabulary"@en,
        "UTT Meetmethode Waardelijst"@nl ;
    skos:hasTopConcept utt:Meetmethode .

prov:Entity a owl:Class .

utt:DiepteAangrijpingspuntValue a owl:Class ;
    rdfs:label "Depth Reference Point Value"@en,
        "Diepte Aangrijpingspunt Value"@nl ;
    rdfs:comment "Depth reference point dictionary. Mirrors the IMKL depth reference point list."@en ;
    rdfs:seeAlso <https://docs.geostandaarden.nl/kl/imkl/> ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Reference point at which depth is measured, explicitly declared per measurement."@en,
        "Aangrijpingspunt waarop diepte is gemeten, per meting expliciet gedeclareerd."@nl ;
    skos:topConceptOf uttvoc:DiepteAangrijpingspuntScheme .

utt:Meetmethode a owl:Class ;
    rdfs:label "Measurement Method"@en,
        "Meetmethode"@nl ;
    rdfs:comment "Top concept of the UTT measurement methods SKOS vocabulary."@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Technique used for position determination."@en,
        "Techniek gebruikt voor positiebepaling."@nl ;
    skos:topConceptOf uttvoc:MeetmethodeScheme .

utt:WaargenomenPositie a owl:Class ;
    rdfs:label "Observed Position"@en,
        "Waargenomen Positie"@nl ;
    rdfs:comment "The field-observed 3D position of a utility."@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "The field-measured 3D position of a cable or pipe."@en,
        "De in het veld gemeten 3D positie van een kabel of leiding."@nl .

uttvoc:DataFormaatScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "UTT Data Format Vocabulary"@en,
        "UTT Data Formaat Waardelijst"@nl ;
    skos:hasTopConcept utt:DataFormaat .

prov:Agent a owl:Class .

utt:DataFormaat a owl:Class ;
    rdfs:label "Data Format"@en,
        "Data Formaat"@nl ;
    rdfs:comment "Top concept of the UTT data format SKOS vocabulary."@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Format of a supporting data file."@en,
        "Formaat van ondersteunend data bestand."@nl ;
    skos:topConceptOf uttvoc:DataFormaatScheme .

utt:GeregistreerdePositie a owl:Class ;
    rdfs:label "Registered Position"@en,
        "Geregistreerde Positie"@nl ;
    rdfs:comment "Existing registration context is retained for source traceability only; KLIC discrepancy analysis is outside UTT 1.0."@en,
        "The expected position of a utility as recorded in a registry."@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "The expected position of a cable or pipe according to the registry."@en,
        "De verwachte positie van een kabel of leiding volgens de registratie."@nl .

unit:M a qudt:Unit,
        owl:NamedIndividual ;
    rdfs:label "metre"@en,
        "meter"@nl ;
    rdfs:seeAlso unit: .

skos:ConceptScheme a owl:Class .

uttvoc:PuntClassificatieScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "UTT Point Classification Vocabulary"@en,
        "UTT Puntclassificatie Waardelijst"@nl ;
    rdfs:comment "Defines the integer class codes embedded in enriched PLY point cloud files."@en ;
    skos:hasTopConcept utt:PuntClassificatie .

xsd:decimal a rdfs:Datatype .

xsd:string a rdfs:Datatype .

utt:PuntClassificatie a owl:Class ;
    rdfs:label "Point Classification"@en,
        "Puntclassificatie"@nl ;
    rdfs:comment "Top concept of the UTT point classification SKOS vocabulary."@en ;
    rdfs:subClassOf skos:Concept ;
    skos:definition "Classification of a point in a point cloud."@en,
        "Classificatie van een punt in een puntenwolk."@nl ;
    skos:topConceptOf uttvoc:PuntClassificatieScheme .

utt:ImklPipeMaterialTypeValue a owl:Class ;
    rdfs:label "Pipe Material Type Value"@en,
        "Materiaal Value"@nl ;
    rdfs:comment """Material of the observed cable or pipe. Mirrors the\r
    IMKL PipeMaterialType value list."""@en ;
    rdfs:seeAlso <https://data.gwsw.nl/Totaal/Materiaal_leiding>,
        <https://docs.geostandaarden.nl/kl/imkl/> ;
    rdfs:subClassOf skos:Concept ;
    skos:topConceptOf uttvoc:MateriaalScheme .

utt:Proefsleuf a owl:Class ;
    rdfs:label "Test Trench"@en,
        "Proefsleuf"@nl ;
    rdfs:comment "Central class of UTT."@en ;
    rdfs:seeAlso <https://www.ogc.org/standards/citygml> ;
    rdfs:subClassOf geo:Feature ;
    skos:definition """A physical excavation made to verify the location, depth\r
    and condition of underground cables and pipes."""@en,
        """Een fysieke uitgraving gemaakt om de locatie, diepte en\r
    conditie van ondergrondse kabels en leidingen te verifiëren."""@nl .

utt:Waarneming a owl:Class ;
    rdfs:label "Observation"@en,
        "Waarneming"@nl ;
    rdfs:comment "A field record of a physically observed underground utility, protective feature or other relevant excavation finding. The absence of any registry link never proves that an observed utility is unregistered."@en ;
    rdfs:subClassOf prov:Entity ;
    skos:definition "A record of a field observation, including a utility, sleeve, bundle or protective feature found in a test trench."@en,
        "Een registratie van een veldwaarneming, zoals een kabel, leiding, mantelbuis, bundel of beschermingsvoorziening in een proefsleuf."@nl .

uttvoc:MateriaalScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "UTT Material Vocabulary"@en,
        "UTT Materiaal Waardelijst"@nl ;
    skos:hasTopConcept utt:ImklPipeMaterialTypeValue .

uttvoc:ThemaScheme a owl:NamedIndividual,
        skos:ConceptScheme ;
    rdfs:label "UTT Utility Theme Vocabulary"@en,
        "UTT Thema Waardelijst"@nl ;
    skos:hasTopConcept utt:ImklThema .

utt:ImklThema a owl:Class ;
    rdfs:label "IMKL Theme"@en,
        "IMKL Thema"@nl ;
    rdfs:comment "Stub for the IMKL utility theme class."@en ;
    rdfs:seeAlso <https://docs.geostandaarden.nl/kl/imkl/> ;
    rdfs:subClassOf skos:Concept ;
    skos:topConceptOf uttvoc:ThemaScheme .

skos:Concept a owl:Class .

