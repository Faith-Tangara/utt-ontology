@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix utt: <https://w3id.org/utt/def/> .
@prefix uttvoc: <https://w3id.org/utt/voc/> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:conformsTo a owl:AnnotationProperty .
dcterms:created a owl:AnnotationProperty .
dcterms:creator a owl:AnnotationProperty .
dcterms:description a owl:AnnotationProperty .
dcterms:format a owl:AnnotationProperty,
        owl:ObjectProperty ;
    rdfs:comment """Reused from Dublin Core Terms. Links a supporting data file\r
    to its format (e.g. point cloud, photo, PDF). Replaces utt:bestandsFormaat from v0.1\r
    following reviewer recommendation to reuse dcterms:format."""@en ;
    rdfs:domain utt:OndersteunendeData ;
    rdfs:range utt:DataFormaat .

dcterms:license a owl:AnnotationProperty .
dcterms:modified a owl:AnnotationProperty .
dcterms:publisher a owl:AnnotationProperty .
dcterms:spatial a owl:AnnotationProperty .
dcterms:temporal a owl:AnnotationProperty .
dcterms:title a owl:AnnotationProperty .

unit:DEG a qudt:Unit,
        owl:NamedIndividual ;
    rdfs:label "degree"@en,
        "graad"@nl ;
    rdfs:seeAlso unit: .

void:sparqlEndpoint a owl:ObjectProperty ;
    rdfs:comment """The SPARQL endpoint that serves this dataset. Recorded per\r
    participating party so a federated query can be routed without a central store."""@en ;
    rdfs:domain void:Dataset ;
    rdfs:range owl:Thing .

void:vocabulary a owl:ObjectProperty ;
    rdfs:comment "The vocabulary used by this dataset, normally the UTT ontology IRI."@en ;
    rdfs:domain void:Dataset ;
    rdfs:range owl:Thing .

xsd:double a rdfs:Datatype .
skos:altLabel a owl:AnnotationProperty .
skos:broadMatch a owl:AnnotationProperty .
skos:closeMatch a owl:AnnotationProperty .
skos:definition a owl:AnnotationProperty .
skos:exactMatch a owl:AnnotationProperty .
skos:hasTopConcept a owl:AnnotationProperty .
skos:inScheme a owl:AnnotationProperty .
skos:prefLabel a owl:AnnotationProperty .
skos:scopeNote a owl:AnnotationProperty .
skos:topConceptOf a owl:AnnotationProperty .

dcat:contactPoint a owl:ObjectProperty ;
    rdfs:domain dcat:Dataset ;
    rdfs:range prov:Agent .

prov:wasDerivedFrom a owl:ObjectProperty ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Entity .

utt: a owl:Ontology ;
    dcterms:conformsTo <http://www.opengis.net/def/crs/EPSG/0/28992>,
        <http://www.opengis.net/doc/IS/geosparql/1.1> ;
    dcterms:created "2026-01-13"^^xsd:date ;
    dcterms:creator "Faith Tangara" ;
    dcterms:description "An ontology for capturing, sharing, and reusing verification data from test trench excavations (proefsleuven) in the Netherlands."@en,
        "Version 1.0 is scoped to test-trench field observations, spatial measurements, supporting evidence and provenance. KLIC discrepancy detection is outside this release."@en,
        "Een ontologie voor het vastleggen, delen en hergebruiken van verificatiegegevens uit proefsleuven in Nederland."@nl,
        "Versie 1.0 richt zich op veldwaarnemingen in proefsleuven, ruimtelijke metingen, ondersteunend bewijs en herkomst. Detectie van KLIC-afwijkingen valt buiten deze versie."@nl ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    dcterms:modified "2026-11-17"^^xsd:date ;
    dcterms:publisher "Faith Tangara" ;
    dcterms:title "Universal Test Trench (UTT) Ontology"@en,
        "Universele Proefsleuf (UTT) Ontologie"@nl ;
    rdfs:seeAlso <http://www.opengis.net/doc/IS/geosparql/1.1>,
        <https://data.gwsw.nl/>,
        <https://docs.geostandaarden.nl/kl/imkl/>,
        <https://sparql.gwsw.nl>,
        <https://www.ogc.org/standards/citygml>,
        <https://www.pdok.nl/introductie/-/article/stedelijk-water-riolering-> ;
    owl:imports <http://www.opengis.net/ont/geosparql> ;
    owl:priorVersion utt:0.4 ;
    owl:versionIRI utt:1.0 ;
    owl:versionInfo "1.0" .

utt:Beschermingsplaat a owl:Class ;
    rdfs:label "Protective slab / plate"@en,
        "Beschermingsplaat"@nl ;
    rdfs:subClassOf utt:Waarneming ;
    skos:definition "Protective slab / plate"@en,
        "Beschermingsplaat"@nl .

utt:Kabelbundel a owl:Class ;
    rdfs:label "Cable bundle"@en,
        "Kabelbundel"@nl ;
    rdfs:subClassOf utt:Waarneming ;
    skos:definition "Cable bundle"@en,
        "Kabelbundel"@nl .

utt:Landmeter a owl:Class ;
    rdfs:label "Surveyor"@en,
        "Landmeter"@nl ;
    rdfs:comment "Person or organisation performing the field measurements."@en ;
    rdfs:subClassOf prov:Agent ;
    skos:definition "Person or organisation performing the measurements."@en,
        "Persoon of organisatie die de metingen uitvoert."@nl .

utt:UitvoerendePartij a owl:Class ;
    rdfs:label "Executing party"@en,
        "Uitvoerende partij"@nl ;
    rdfs:subClassOf prov:Agent ;
    skos:definition "Executing party"@en,
        "Uitvoerende partij"@nl .

utt:Waarschuwingslint a owl:Class ;
    rdfs:label "Warning tape / band"@en,
        "Waarschuwingslint"@nl ;
    rdfs:subClassOf utt:Waarneming ;
    skos:definition "Warning tape / band"@en,
        "Waarschuwingslint"@nl .

utt:actorNaam a owl:DatatypeProperty ;
    rdfs:label "actor name"@en,
        "actor naam"@nl ;
    rdfs:comment "Name of the person or organisation acting in the verification process."@en ;
    rdfs:domain prov:Agent ;
    rdfs:range xsd:string ;
    skos:definition "Name of the person or organisation."@en,
        "Naam van de persoon of organisatie."@nl .

utt:antenneHoogte a owl:DatatypeProperty ;
    rdfs:label "antenna height"@en,
        "antennehoogte"@nl ;
    rdfs:comment "Height of the GNSS antenna above the measured point."@en ;
    rdfs:domain utt:Meetapparatuur ;
    rdfs:range xsd:decimal ;
    skos:definition "Height of the GNSS antenna above the measured point."@en,
        "Hoogte van de GNSS antenne boven het ingemeten punt."@nl ;
    utt:eenheid unit:M .

utt:apparatuurModel a owl:DatatypeProperty ;
    rdfs:label "equipment model"@en,
        "apparatuur model"@nl ;
    rdfs:comment "Manufacturer and model of the instrument."@en ;
    rdfs:domain utt:Meetapparatuur ;
    rdfs:range xsd:string ;
    skos:definition "Manufacturer and model of the instrument."@en,
        "Fabrikant en model van het instrument."@nl .

utt:apparatuurSerienummer a owl:DatatypeProperty ;
    rdfs:label "equipment serial number"@en,
        "apparatuur serienummer"@nl ;
    rdfs:comment "Serial number of the instrument."@en ;
    rdfs:domain utt:Meetapparatuur ;
    rdfs:range xsd:string ;
    skos:definition "Serial number of the instrument."@en,
        "Serienummer van het instrument."@nl .

utt:bestaatUitMeetpunt a owl:ObjectProperty ;
    rdfs:label "consists of survey point"@en,
        "bestaat uit meetpunt"@nl ;
    rdfs:comment """Links an observed position to the individual survey points\r
    from which its geometry was constructed, so that a per point date and uncertainty stay\r
    traceable after the points have been joined into a line."""@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( utt:WaargenomenPositie utt:Proefsleuf ) ] ;
    rdfs:range utt:Meetpunt ;
    skos:definition """Links an observed position to the individual survey\r
    points from which its geometry was constructed."""@en,
        """Koppelt een waargenomen positie aan de afzonderlijke\r
    meetpunten waaruit de geometrie is opgebouwd."""@nl .

utt:bestandsReferentie a owl:DatatypeProperty ;
    rdfs:label "file reference"@en,
        "bestands referentie"@nl ;
    rdfs:comment "URI reference to the external supporting data file."@en ;
    rdfs:domain utt:OndersteunendeData ;
    rdfs:range xsd:anyURI ;
    skos:definition "URI reference to the external file."@en,
        "URI verwijzing naar het externe bestand."@nl .

utt:bevatWaarneming a owl:ObjectProperty ;
    rdfs:label "contains observation"@en,
        "bevat waarneming"@nl ;
    rdfs:comment """Used to represent nested utilities, where a sleeve (mantelbuis)\r
    physically contains other cables or pipes observed inside it."""@en ;
    rdfs:domain utt:Mantelbuis ;
    rdfs:range utt:Waarneming ;
    skos:definition """Observation of a cable or pipe observed inside this\r
    sleeve."""@en,
        """Waarneming van een kabel of leiding die binnen deze\r
    mantelbuis is waargenomen."""@nl .

utt:bodemElevatieNAP a owl:DatatypeProperty ;
    rdfs:label "trench floor elevation NAP"@en,
        "bodemhoogte NAP"@nl ;
    rdfs:comment "Elevation of the excavation floor relative to NAP."@en ;
    rdfs:domain utt:Proefsleuf ;
    rdfs:range xsd:decimal ;
    skos:definition "Elevation of the trench floor relative to NAP."@en,
        "Hoogte van de bodem van de proefsleuf ten opzichte van NAP."@nl ;
    utt:eenheid unit:M .

utt:bodemGeometrie a owl:ObjectProperty ;
    rdfs:label "trench floor geometry"@en,
        "bodemgeometrie"@nl ;
    rdfs:comment """The excavation floor outline, as distinct from the ground\r
    level outline carried by utt:sleufGeometrie. Added in v0.4 because contractor drawings\r
    deliver both outlines and a single geometry property cannot say which is which. The pair\r
    gives the excavated volume rather than only a footprint, and the floor level records how\r
    far the excavation actually reached, which is the exclusion evidence for utilities that\r
    could have been present but were not found."""@en ;
    rdfs:domain utt:Proefsleuf ;
    rdfs:range geo:Geometry ;
    skos:definition "Outline of the floor of the test trench."@en,
        "Omtrek van de bodem van de proefsleuf."@nl .

utt:bodemType a owl:DatatypeProperty ;
    rdfs:label "soil type"@en,
        "bodem type"@nl ;
    rdfs:comment "Observed soil type at the trench location."@en ;
    rdfs:domain utt:GrondCondities ;
    rdfs:range xsd:string ;
    skos:definition "Observed soil type (e.g. sand, clay, peat, mixed)."@en,
        "Waargenomen bodemtype (bijv. zand, klei, veen, gemengd)."@nl .

utt:bronObjectId a owl:DatatypeProperty ;
    rdfs:label "source object ID"@en,
        "bron object ID"@nl ;
    rdfs:comment "Identifier of the object in the source registry."@en ;
    rdfs:domain utt:GeregistreerdePositie ;
    rdfs:range xsd:string ;
    skos:definition "Identifier of the object in the source registry."@en,
        "Identificatie van het object in de bronregistratie."@nl .

utt:bronPeildatum a owl:DatatypeProperty ;
    rdfs:label "source reference date"@en,
        "bron peildatum"@nl ;
    rdfs:comment "Date and time at which the registered position was retrieved from its source."@en ;
    rdfs:domain utt:GeregistreerdePositie ;
    rdfs:range xsd:dateTime ;
    skos:definition "Date and time at which the registered position was retrieved from its source."@en,
        "Datum en tijd waarop de geregistreerde positie uit de bron is opgehaald."@nl .

utt:bronService a owl:DatatypeProperty ;
    rdfs:label "source service"@en,
        "bron service"@nl ;
    rdfs:comment "URI of the specific service endpoint the registered position was retrieved from."@en ;
    rdfs:domain utt:GeregistreerdePositie ;
    rdfs:range xsd:anyURI ;
    skos:definition "URI of the service from which the registered position was retrieved."@en,
        "URI van de service waaruit de geregistreerde positie is opgehaald."@nl .

utt:classificatieCode a owl:DatatypeProperty ;
    rdfs:label "classification code"@en,
        "classificatiecode"@nl ;
    rdfs:comment "The integer value stored in the PLY class property for this category."@en ;
    rdfs:domain utt:PuntClassificatie ;
    rdfs:range xsd:integer ;
    skos:definition "The integer value stored in the PLY class property."@en,
        "De integerwaarde opgeslagen in de PLY class eigenschap."@nl .

utt:compactheid a owl:DatatypeProperty ;
    rdfs:label "compaction"@en,
        "compactheid"@nl ;
    rdfs:comment "Qualitative or quantitative description of soil compaction at the trench."@en ;
    rdfs:domain utt:GrondCondities ;
    rdfs:range xsd:string ;
    skos:definition "Qualitative or quantitative description of soil compaction."@en,
        "Kwalitatieve of kwantitatieve beschrijving van de grondverdichting."@nl .

utt:coordinaatstelsel a owl:ObjectProperty ;
    rdfs:label "coordinate reference system"@en,
        "coördinaatstelsel"@nl ;
    rdfs:comment """Declares the coordinate reference system of a geometry\r
    as a first-class resource, in addition to the CRS URI carried inside the geo:asWKT\r
    literal. Stated explicitly because UTT data combines a horizontal frame (RD New) with a\r
    separate vertical datum (NAP), which a single WKT CRS prefix does not always express."""@en ;
    rdfs:domain geo:Geometry ;
    rdfs:range utt:CoordinaatStelsel ;
    skos:definition """The coordinate reference system in which this geometry\r
    is expressed."""@en,
        """Het coördinaatstelsel waarin deze geometrie is\r
    uitgedrukt."""@nl .

utt:detailNiveau a owl:ObjectProperty ;
    rdfs:label "level of detail"@en,
        "detail niveau"@nl ;
    rdfs:comment """Level of detail of the captured geometry, following the CityGML\r
    LoD concept."""@en ;
    rdfs:domain utt:OndersteunendeData ;
    rdfs:range utt:DetailNiveau ;
    skos:definition """Level of detail of the captured geometry, aligned to the\r
    CityGML LoD concept."""@en,
        """Detailniveau van de vastgelegde geometrie, aansluitend op\r
    het CityGML LoD concept."""@nl .

utt:diepteAangrijpingspunt a owl:ObjectProperty ;
    rdfs:label "depth reference point"@en,
        "diepte aangrijpingspunt"@nl ;
    rdfs:comment """The reference point on the utility from which depth\r
    is measured. Must be explicitly declared per measurement; depth values are only meaningful\r
    when the reference point is known (top, axis, bottom, BOB for sewer, etc.)."""@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( utt:WaargenomenPositie utt:GeregistreerdePositie ) ] ;
    rdfs:range utt:DiepteAangrijpingspuntValue ;
    skos:definition """The point on the utility where depth is measured\r
    (top, axis, bottom, invert). Mirrors the IMKL value list via rdfs:seeAlso."""@en,
        """Het punt op het object waarop de diepte is gemeten\r
    (bovenkant, hart, onderkant, BOB). Hergebruikt IMKL waardelijst via rdfs:seeAlso."""@nl .

utt:diepteNAP a owl:DatatypeProperty ;
    rdfs:label "depth NAP"@en,
        "diepte NAP"@nl ;
    rdfs:comment """Elevation of the utility reference point relative to NAP (Normaal\r
    Amsterdams Peil), in meters."""@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( utt:WaargenomenPositie utt:GeregistreerdePositie ) ] ;
    rdfs:range xsd:decimal ;
    skos:definition """Elevation of the utility reference point relative to NAP, in\r
    meters. Source of truth for depth."""@en,
        """Hoogte van het aangrijpingspunt van de kabel/leiding ten\r
    opzichte van NAP, in meters. Bron van waarheid voor diepte."""@nl ;
    skos:scopeNote """Both diepteNAP and diepteTovMaaiveld are retained because NAP\r
    elevation is the stable registration value that survives surface changes, while\r
    depth-of-cover relative to ground level is the value contractors actually collect and\r
    record in DXF deliveries. IMKL carries both. Removing depth-of-cover would leave the\r
    database empty wherever a contractor records only cover, while removing NAP would make\r
    values non-comparable across sites with different surface levels."""@en ;
    utt:eenheid unit:M .

utt:diepteTovMaaiveld a owl:DatatypeProperty ;
    rdfs:label "depth relative to ground level"@en,
        "diepte t.o.v. maaiveld"@nl ;
    rdfs:comment """Depth of the utility reference point relative to the local\r
    ground surface, in meters. This is the value normally carried in contractor DXF and CAD\r
    output. The authoritative depth is diepteNAP."""@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( utt:WaargenomenPositie utt:GeregistreerdePositie ) ] ;
    rdfs:range xsd:decimal ;
    skos:definition """Depth of the utility reference point relative to the\r
    local ground surface, in meters. Derived; may shift if the ground surface changes."""@en,
        """Diepte van het aangrijpingspunt van de kabel/leiding\r
    ten opzichte van het lokale maaiveld, in meters. Afgeleid; kan wijzigen bij\r
    maaiveldverandering."""@nl ;
    skos:scopeNote """Retained alongside diepteNAP because contractor DXF\r
    deliveries record depth-of-cover relative to ground level, not NAP elevation. The\r
    authoritative value is diepteNAP; this property preserves the field-recorded value so\r
    the conversion can be audited."""@en ;
    utt:eenheid unit:M .

utt:doelVanSleuf a owl:ObjectProperty ;
    rdfs:label "purpose of trench"@en,
        "doel van sleuf"@nl ;
    rdfs:comment """Captures why the trench was excavated. The purpose drives the\r
    type and resolution of data that can be expected from the observation."""@en ;
    rdfs:domain utt:Proefsleuf ;
    rdfs:range utt:SleufDoel ;
    skos:definition """Reason the test trench was excavated (KLIC verification,\r
    new installation, maintenance, design investigation)."""@en,
        """Reden waarom de proefsleuf is gegraven (KLIC verificatie,\r
    nieuwe aanleg, onderhoud, ontwerp onderzoek)."""@nl .

utt:eenheid a owl:AnnotationProperty ;
    rdfs:label "unit"@en,
        "eenheid"@nl ;
    rdfs:comment """Declares the unit in which values of the annotated datatype property\r
    are expressed. Values are QUDT unit individuals, so the unit itself is identified by a\r
    QUDT IRI and is machine resolvable.\r
\r
    A local annotation property is used rather than a QUDT predicate for two reasons. First,\r
    qudt:unit is deprecated in QUDT 2.1 and marked dcterms:isReplacedBy qudt:hasUnit. Second,\r
    qudt:hasUnit relates a system of units to a unit, which is a different relationship from\r
    the one needed here. QUDT provides no predicate for annotating an owl:DatatypeProperty\r
    with the unit its values carry, because QUDT expects measurements to be reified as\r
    qudt:QuantityValue instances.\r
\r
    UTT deliberately records plain xsd:decimal values rather than reified quantity values,\r
    since contractors supply flat numeric fields and reification would add a node per\r
    measurement for no practical gain. This property states the expected unit for producers\r
    and consumers of that data. It is documentation, not a quantity construction, and no\r
    reasoner will derive unit conversion from it."""@en ;
    rdfs:range qudt:Unit .

utt:gebruiktApparatuur a owl:ObjectProperty ;
    rdfs:label "used equipment"@en,
        "gebruikt apparatuur"@nl ;
    rdfs:comment """Links a verification activity to the specific instrument\r
    used. Distinct from gebruiktMethode: the method is the technique (LiDAR), the equipment is\r
    the device (Leica BLK2GO)."""@en ;
    rdfs:domain utt:VerificatieActiviteit ;
    rdfs:range utt:Meetapparatuur ;
    skos:definition "The instrument with which the measurement was taken."@en,
        "Het instrument waarmee de meting is uitgevoerd."@nl .

utt:gebruiktMethode a owl:ObjectProperty ;
    rdfs:label "used method"@en,
        "gebruikt methode"@nl ;
    rdfs:comment """Links the verification activity to the measurement method\r
    used."""@en ;
    rdfs:domain utt:VerificatieActiviteit ;
    rdfs:range utt:Meetmethode ;
    skos:definition "The measurement method that was used."@en,
        "De meetmethode die is gebruikt."@nl .

utt:geometrieReferentie a owl:ObjectProperty ;
    rdfs:label "geometry reference point"@en,
        "geometriereferentie"@nl ;
    rdfs:domain utt:WaargenomenPositie ;
    rdfs:range utt:DiepteAangrijpingspuntValue ;
    skos:definition "Specifies whether a measured utility geometry represents the top, centre, bottom or other documented reference. Reuses the existing depth-reference vocabulary."@en,
        "Geeft aan of de ingemeten geometrie de bovenkant, hartlijn, onderkant of een andere vastgelegde referentie weergeeft. Hergebruikt de bestaande dieptewaardelijst."@nl .

utt:geregistreerdeGeometrie a owl:ObjectProperty ;
    rdfs:label "registered geometry"@en,
        "geregistreerde geometrie"@nl ;
    rdfs:comment "Existing registration context is retained for source traceability only; KLIC discrepancy analysis is outside UTT 1.0."@en,
        "Geometry of the position as held in the registry."@en ;
    rdfs:domain utt:GeregistreerdePositie ;
    rdfs:range geo:Geometry ;
    rdfs:subPropertyOf geo:hasGeometry ;
    skos:definition "Geometry of the position as held in the registry."@en,
        "Geometrie van de positie zoals vastgelegd in de registratie."@nl .

utt:geverifieerdDoor a owl:ObjectProperty ;
    rdfs:label "verified by"@en,
        "geverifieerd door"@nl ;
    rdfs:comment "Links a test trench to the verification activity that produced its data."@en ;
    rdfs:domain utt:Proefsleuf ;
    rdfs:range utt:VerificatieActiviteit ;
    skos:definition "The verification activity that produced this test trench record."@en,
        "De verificatie activiteit die deze proefsleuf heeft aangemaakt."@nl .

utt:grondwaterNiveau a owl:DatatypeProperty ;
    rdfs:label "groundwater level"@en,
        "grondwater niveau"@nl ;
    rdfs:comment "Observed groundwater level at the trench, expressed as elevation relative to NAP in meters."@en ;
    rdfs:domain utt:GrondCondities ;
    rdfs:range xsd:decimal ;
    skos:definition "Observed groundwater level relative to NAP in meters."@en,
        "Waargenomen grondwaterstand t.o.v. NAP in meters."@nl ;
    utt:eenheid unit:M .

utt:grondwaterOpnameDatum a owl:DatatypeProperty ;
    rdfs:label "groundwater observation date"@en,
        "datum grondwaterwaarneming"@nl ;
    rdfs:domain utt:GrondCondities ;
    rdfs:range xsd:date ;
    skos:definition "Date when the groundwater level was observed. The level may change over time."@en,
        "Datum waarop de grondwaterstand is waargenomen. De stand kan in de tijd veranderen."@nl .

utt:heeftAanvrager a owl:ObjectProperty ;
    rdfs:label "has requesting party"@en,
        "heeft aanvrager"@nl ;
    rdfs:comment "The party that submitted the area request."@en ;
    rdfs:domain utt:Graafpolygoon ;
    rdfs:range prov:Agent ;
    skos:definition "The party that submitted the area request."@en,
        "De partij die het gebiedsverzoek heeft ingediend."@nl .

utt:heeftBeschermingsvoorziening a owl:ObjectProperty ;
    rdfs:label "has observed protective feature"@en,
        "heeft beschermingsvoorziening"@nl ;
    rdfs:domain utt:Waarneming ;
    rdfs:range utt:Waarneming ;
    skos:definition "Links a field observation of a utility to a separately observed warning band or protective slab, when their association is supported by evidence."@en,
        "Verbindt een waarneming van een kabel of leiding met een apart waargenomen waarschuwingslint of beschermingsplaat, indien de samenhang is onderbouwd."@nl .

utt:heeftBijdrager a owl:ObjectProperty ;
    rdfs:label "has contributing party"@en,
        "heeft bijdrager"@nl ;
    rdfs:comment """A party that contributed trench data in response to the\r
    area request. Multiple contributors are expected."""@en ;
    rdfs:domain utt:Graafpolygoon ;
    rdfs:range prov:Agent ;
    skos:definition """A party that contributed trench data in response to\r
    the area request."""@en,
        """Een partij die proefsleufinformatie heeft bijgedragen\r
    in reactie op het gebiedsverzoek."""@nl .

utt:heeftBronRol a owl:ObjectProperty ;
    rdfs:label "has source-data role"@en,
        "heeft bronrol"@nl ;
    rdfs:domain utt:OndersteunendeData ;
    rdfs:range utt:BronRol ;
    skos:definition "Identifies whether a supporting resource is original, processed or generated."@en,
        "Geeft aan of een ondersteunende gegevensbron origineel, bewerkt of gegenereerd is."@nl .

utt:heeftGrondCondities a owl:ObjectProperty ;
    rdfs:label "has ground conditions"@en,
        "heeft grond condities"@nl ;
    rdfs:comment """Links a test trench to the observed ground conditions\r
    at the site (soil type, groundwater, compaction)."""@en ;
    rdfs:domain utt:Proefsleuf ;
    rdfs:range utt:GrondCondities ;
    skos:definition """The observed ground conditions at the site of the\r
    test trench."""@en,
        """De waargenomen grondcondities ter plaatse van de\r
    proefsleuf."""@nl .

utt:heeftKenmerken a owl:ObjectProperty ;
    rdfs:label "has characteristics"@en,
        "heeft kenmerken"@nl ;
    rdfs:comment "Links an observation to its observed physical characteristics."@en ;
    rdfs:domain utt:Waarneming ;
    rdfs:range utt:WaargenomenKenmerken ;
    skos:definition "Observed physical characteristics."@en,
        "Waargenomen fysieke kenmerken."@nl .

utt:heeftMeetapparatuur a owl:ObjectProperty ;
    rdfs:label "measured with equipment"@en,
        "gemeten met apparatuur"@nl ;
    rdfs:comment """Links a survey point to the equipment used for that\r
    point."""@en ;
    rdfs:domain utt:Meetpunt ;
    rdfs:range utt:Meetapparatuur ;
    skos:definition "Links a survey point to the equipment used."@en,
        "Koppelt een meetpunt aan de gebruikte meetapparatuur."@nl .

utt:heeftNauwkeurigheid a owl:ObjectProperty ;
    rdfs:label "has accuracy"@en,
        "heeft nauwkeurigheid"@nl ;
    rdfs:comment """Accuracy is a property of the measured or registered\r
    position, not of the trench itself."""@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( utt:WaargenomenPositie utt:GeregistreerdePositie ) ] ;
    rdfs:range utt:Nauwkeurigheid ;
    skos:definition "Accuracy indicator for this position."@en,
        "Nauwkeurigheidsindicator voor deze positie."@nl .

utt:heeftOndersteunendeData a owl:ObjectProperty ;
    rdfs:label "has supporting data"@en,
        "heeft ondersteunende data"@nl ;
    rdfs:comment """Links an observation or a whole trench to external\r
    supporting files such as photos, point clouds, or CAD drawings."""@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( utt:Waarneming utt:Proefsleuf ) ] ;
    rdfs:range utt:OndersteunendeData ;
    skos:definition "Reference to supporting data files."@en,
        "Verwijzing naar ondersteunende databestanden."@nl .

utt:heeftPositie a owl:ObjectProperty ;
    rdfs:label "has position"@en,
        "heeft positie"@nl ;
    rdfs:comment "Links an observation to its field-verified position."@en ;
    rdfs:domain utt:Waarneming ;
    rdfs:range utt:WaargenomenPositie ;
    skos:definition "The verified position of this observation."@en,
        "De geverifieerde positie van deze waarneming."@nl .

utt:heeftWaarneming a owl:ObjectProperty ;
    rdfs:label "has observation"@en,
        "heeft waarneming"@nl ;
    rdfs:comment "Links a trench to the observations made within it."@en ;
    rdfs:domain utt:Proefsleuf ;
    rdfs:range utt:Waarneming ;
    owl:inverseOf utt:waargenomenIn ;
    skos:definition "Observations made in this test trench."@en,
        "Waarnemingen gedaan in deze proefsleuf."@nl .

utt:horizontaleOnzekerheid a owl:DatatypeProperty ;
    rdfs:label "horizontal uncertainty"@en,
        "horizontale onzekerheid"@nl ;
    rdfs:comment "Horizontal (XY) measurement uncertainty in meters (1 sigma)."@en ;
    rdfs:domain utt:Nauwkeurigheid ;
    rdfs:range xsd:decimal ;
    skos:definition "Horizontal (XY) uncertainty in meters (1 sigma)."@en,
        "Horizontale (XY) onzekerheid in meters (1 sigma)."@nl ;
    utt:eenheid unit:M .

utt:kalibratieDatum a owl:DatatypeProperty ;
    rdfs:label "calibration date"@en,
        "kalibratie datum"@nl ;
    rdfs:comment "Date of last calibration."@en ;
    rdfs:domain utt:Meetapparatuur ;
    rdfs:range xsd:date ;
    skos:definition "Date of last calibration."@en,
        "Datum van laatste kalibratie."@nl .

utt:klicObjectId a owl:DatatypeProperty ;
    rdfs:label "KLIC object ID"@en,
        "KLIC object ID"@nl ;
    rdfs:comment "Existing registration context is retained for source traceability only; KLIC discrepancy analysis is outside UTT 1.0."@en,
        """Persistent identifier for a registered utility object, stable\r
    across multiple KLIC meldingen."""@en ;
    rdfs:domain utt:ImklKabelOfLeiding ;
    rdfs:range xsd:string ;
    skos:definition "Persistent identifier of a registered cable or pipe."@en,
        "Persistente identifier van een geregistreerde kabel of leiding."@nl .

utt:leverancierCode a owl:DatatypeProperty ;
    rdfs:label "supplier code"@en,
        "leverancierscode"@nl ;
    rdfs:comment """The contractor's own classification code for the observation,\r
    retained verbatim."""@en ;
    rdfs:domain utt:Waarneming ;
    rdfs:range xsd:string ;
    skos:definition "The contractor's own classification code, retained verbatim."@en,
        "De eigen classificatiecode van de aannemer, letterlijk bewaard."@nl .

utt:maaiveldElevatieNAP a owl:DatatypeProperty ;
    rdfs:label "ground surface elevation NAP"@en,
        "maaiveld elevatie NAP"@nl ;
    rdfs:comment "Elevation of the ground surface at the trench, relative to NAP in meters."@en ;
    rdfs:domain utt:Proefsleuf ;
    rdfs:range xsd:decimal ;
    skos:definition "Ground surface elevation at the trench relative to NAP in meters."@en,
        "Hoogte van het maaiveld ter plaatse van de proefsleuf t.o.v. NAP in meters."@nl ;
    utt:eenheid unit:M .

utt:nauwkeurigheidDiepteklasse a owl:ObjectProperty ;
    rdfs:label "accuracy depth class"@en,
        "nauwkeurigheid diepte klasse"@nl ;
    rdfs:comment "Mirrors the IMKL depth accuracy value list via rdfs:seeAlso."@en ;
    rdfs:domain utt:Nauwkeurigheid ;
    rdfs:range utt:NauwkeurigheidDiepteValue ;
    skos:definition "Accuracy class for depth. Mirrors the IMKL value list."@en,
        "Nauwkeurigheidsklasse voor diepte. Hergebruikt IMKL waardelijst."@nl .

utt:nauwkeurigheidXYklasse a owl:ObjectProperty ;
    rdfs:label "accuracy XY class"@en,
        "nauwkeurigheid XY klasse"@nl ;
    rdfs:comment "Mirrors the IMKL XY accuracy value list via rdfs:seeAlso."@en ;
    rdfs:domain utt:Nauwkeurigheid ;
    rdfs:range utt:NauwkeurigheidXYvalue ;
    skos:definition "Accuracy class for XY. Mirrors the IMKL value list."@en,
        "Nauwkeurigheidsklasse voor XY. Hergebruikt IMKL waardelijst."@nl .

utt:onderdeelVanDataset a owl:ObjectProperty ;
    rdfs:label "part of dataset"@en,
        "onderdeel van dataset"@nl ;
    rdfs:comment """Links a trench record to the published dataset that holds\r
    it. This is what makes the federation discoverable."""@en ;
    rdfs:domain utt:Proefsleuf ;
    rdfs:range utt:UTTDataset ;
    skos:definition """The published dataset in which this test trench is\r
    held."""@en,
        """De gepubliceerde dataset waarin deze proefsleuf is\r
    opgenomen."""@nl .

utt:onderdeelVanProject a owl:ObjectProperty ;
    rdfs:label "part of project"@en,
        "onderdeel van project"@nl ;
    rdfs:comment "Groups multiple trenches under a single excavation job or project."@en ;
    rdfs:domain utt:Proefsleuf ;
    rdfs:range utt:Project ;
    skos:definition "The project that this test trench belongs to."@en,
        "Het project waartoe deze proefsleuf behoort."@nl .

utt:onderdeelVanStelsel a owl:ObjectProperty ;
    rdfs:label "part of network"@en,
        "onderdeel van stelsel"@nl ;
    rdfs:comment """Links an observed utility to the network it belongs to,\r
    identified by an external IRI. UTT does not model networks itself."""@en ;
    rdfs:domain utt:Waarneming ;
    rdfs:range owl:Thing ;
    rdfs:seeAlso <https://data.gwsw.nl/> ;
    skos:definition """The network to which the observed cable or pipe\r
    belongs, identified by an external IRI."""@en,
        """Het netwerk of stelsel waartoe de waargenomen kabel of\r
    leiding behoort, geïdentificeerd via een externe IRI."""@nl .

utt:opdrachtVan a owl:ObjectProperty ;
    rdfs:label "commissioned by"@en,
        "opdracht van"@nl ;
    rdfs:comment "Links a verification activity to the contractor who commissioned it."@en ;
    rdfs:domain utt:VerificatieActiviteit ;
    rdfs:range utt:Aannemer ;
    skos:definition "The contractor who commissioned the verification."@en,
        "De aannemer die de verificatie heeft laten uitvoeren."@nl .

utt:opnameDatum a owl:DatatypeProperty ;
    rdfs:label "survey date"@en,
        "opnamedatum"@nl ;
    rdfs:comment "Date on which this individual point was measured."@en ;
    rdfs:domain utt:Meetpunt ;
    rdfs:range xsd:date ;
    skos:definition "Date on which this individual point was measured."@en,
        "Datum waarop dit punt is ingemeten."@nl .

utt:pmklKleur a owl:AnnotationProperty ;
    rdfs:label "PMKL colour"@en,
        "PMKL kleur"@nl ;
    rdfs:comment """RGB hex colour from the PMKL (Presentatiemodel Kabels en\r
    Leidingen) version 3.0 colour table, published at docs.geostandaarden.nl/kl/pmkl30/.\r
    Annotated on ThemaScheme individuals so the viewer renders utilities in the colour\r
    practitioners expect from KLIC maps."""@en ;
    rdfs:range xsd:string .

utt:positieGeometrie a owl:ObjectProperty ;
    rdfs:label "position geometry"@en,
        "positie geometrie"@nl ;
    rdfs:comment "3D point or line geometry of the observed position."@en ;
    rdfs:domain utt:WaargenomenPositie ;
    rdfs:range geo:Geometry ;
    rdfs:subPropertyOf geo:hasGeometry ;
    skos:definition "3D point or line geometry of the observed position."@en,
        "3D punt of lijn geometrie van de waargenomen positie."@nl .

utt:prismaHoogte a owl:DatatypeProperty ;
    rdfs:label "prism height"@en,
        "prismahoogte"@nl ;
    rdfs:comment "Height of the prism above the measured point for total station work."@en ;
    rdfs:domain utt:Meetapparatuur ;
    rdfs:range xsd:decimal ;
    skos:definition "Height of the prism above the measured point."@en,
        "Hoogte van het prisma boven het ingemeten punt."@nl ;
    utt:eenheid unit:M .

utt:projectNaam a owl:DatatypeProperty ;
    rdfs:label "project name"@en,
        "project naam"@nl ;
    rdfs:comment "Name of the excavation project."@en ;
    rdfs:domain utt:Project ;
    rdfs:range xsd:string ;
    skos:definition "Name of the project."@en,
        "Naam van het project."@nl .

utt:projectNummer a owl:DatatypeProperty ;
    rdfs:label "project number"@en,
        "project nummer"@nl ;
    rdfs:comment "Identifier of the excavation project."@en ;
    rdfs:domain utt:Project ;
    rdfs:range xsd:string ;
    skos:definition "Number/identifier of the project."@en,
        "Nummer/identificatie van het project."@nl .

utt:puntNummer a owl:DatatypeProperty ;
    rdfs:label "point number"@en,
        "puntnummer"@nl ;
    rdfs:comment "The surveyor's own point number as delivered."@en ;
    rdfs:domain utt:Meetpunt ;
    rdfs:range xsd:string ;
    skos:definition "The surveyor's own point number as delivered."@en,
        "Puntnummer van de landmeter zoals aangeleverd."@nl .

utt:puntOnzekerheid a owl:DatatypeProperty ;
    rdfs:label "point uncertainty"@en,
        "puntonzekerheid"@nl ;
    rdfs:comment "The single combined uncertainty figure reported by the instrument for one point."@en ;
    rdfs:domain utt:Meetpunt ;
    rdfs:range xsd:decimal ;
    skos:definition "The single combined uncertainty figure reported by the instrument for one point."@en,
        "De gecombineerde onzekerheid die het instrument voor een punt rapporteert."@nl ;
    utt:eenheid unit:M .

utt:registratieBron a owl:ObjectProperty ;
    rdfs:label "registration source"@en,
        "registratiebron"@nl ;
    rdfs:comment "Existing registration context is retained for source traceability only; KLIC discrepancy analysis is outside UTT 1.0."@en,
        "Identifies where a registered position was obtained from."@en ;
    rdfs:domain utt:GeregistreerdePositie ;
    rdfs:range utt:RegistratieBron ;
    skos:definition """The source from which the registered position was\r
    obtained."""@en,
        """De bron waaruit de geregistreerde positie is\r
    overgenomen."""@nl .

utt:sleufBreedte a owl:DatatypeProperty ;
    rdfs:label "trench width"@en,
        "sleuf breedte"@nl ;
    rdfs:comment "Width of the test trench in meters."@en ;
    rdfs:domain utt:Proefsleuf ;
    rdfs:range xsd:decimal ;
    skos:definition "Width of the test trench in meters."@en,
        "Breedte van de proefsleuf in meters."@nl ;
    utt:eenheid unit:M .

utt:sleufDiepte a owl:DatatypeProperty ;
    rdfs:label "trench excavated depth"@en,
        "sleuf diepte"@nl ;
    rdfs:comment "Maximum excavated depth of the trench itself, in meters."@en ;
    rdfs:domain utt:Proefsleuf ;
    rdfs:range xsd:decimal ;
    skos:definition "Maximum excavated depth of the trench in meters."@en,
        "Maximale uitgegraven diepte van de proefsleuf in meters."@nl ;
    utt:eenheid unit:M .

utt:sleufGeometrie a owl:ObjectProperty ;
    rdfs:label "trench geometry"@en,
        "sleuf geometrie"@nl ;
    rdfs:comment "The 3D geometry of the trench."@en ;
    rdfs:domain utt:Proefsleuf ;
    rdfs:range geo:Geometry ;
    rdfs:subPropertyOf geo:hasGeometry ;
    skos:definition "The 3D geometry of the test trench (contour, polygon, or line)."@en,
        "De 3D geometrie van de proefsleuf (contour, polygoon, of lijn)."@nl .

utt:sleufLengte a owl:DatatypeProperty ;
    rdfs:label "trench length"@en,
        "sleuf lengte"@nl ;
    rdfs:comment "Length of the test trench in meters."@en ;
    rdfs:domain utt:Proefsleuf ;
    rdfs:range xsd:decimal ;
    skos:definition "Length of the test trench in meters."@en,
        "Lengte van de proefsleuf in meters."@nl ;
    utt:eenheid unit:M .

utt:typeAanduiding a owl:DatatypeProperty ;
    rdfs:label "type designation"@en,
        "typeaanduiding"@nl ;
    rdfs:comment "A manufacturer or trade designation such as a cable type code."@en ;
    rdfs:domain utt:WaargenomenKenmerken ;
    rdfs:range xsd:string ;
    skos:definition "A manufacturer or trade designation, for example a cable type code."@en,
        "Fabrikants- of handelsaanduiding, bijvoorbeeld een kabeltypecode."@nl .

utt:uitgevoerdDoor a owl:ObjectProperty ;
    rdfs:label "performed by"@en,
        "uitgevoerd door"@nl ;
    rdfs:comment "Associates a verification activity with the responsible executing organisation or person. Prefer an organisation identifier; individual names are optional."@en ;
    rdfs:domain utt:VerificatieActiviteit ;
    rdfs:range prov:Agent ;
    rdfs:subPropertyOf prov:wasAssociatedWith ;
    skos:definition "The surveyor or organisation that performed the measurement."@en,
        "De landmeter of organisatie die de meting heeft uitgevoerd."@nl .

utt:verificatieDatum a owl:DatatypeProperty ;
    rdfs:label "verification date"@en,
        "verificatie datum"@nl ;
    rdfs:comment "Date and time the verification was performed."@en ;
    rdfs:domain utt:VerificatieActiviteit ;
    rdfs:range xsd:dateTime ;
    skos:definition "Date and time the verification was performed."@en,
        "Datum en tijd waarop de verificatie is uitgevoerd."@nl .

utt:verticaleOnzekerheid a owl:DatatypeProperty ;
    rdfs:label "vertical uncertainty"@en,
        "verticale onzekerheid"@nl ;
    rdfs:comment "Vertical (depth) measurement uncertainty in metres (1 sigma)."@en ;
    rdfs:domain utt:Nauwkeurigheid ;
    rdfs:range xsd:decimal ;
    skos:definition "Vertical (depth) uncertainty in metres (1 sigma)."@en,
        "Verticale (diepte) onzekerheid in meters (1 sigma)."@nl ;
    utt:eenheid unit:M .

utt:waargenomenDiameter a owl:DatatypeProperty ;
    rdfs:label "observed diameter"@en,
        "waargenomen diameter"@nl ;
    rdfs:comment "Outer diameter of the cable or pipe in millimeters."@en ;
    rdfs:domain utt:WaargenomenKenmerken ;
    rdfs:range xsd:decimal ;
    skos:definition "Outer diameter of the cable or pipe in millimeters."@en,
        "Buitendiameter van de kabel of leiding in millimeters."@nl ;
    utt:eenheid unit:MilliM .

utt:waargenomenKleur a owl:DatatypeProperty ;
    rdfs:label "observed color"@en,
        "waargenomen kleur"@nl ;
    rdfs:comment "Colour of the cable, pipe, or marking as observed in the field."@en ;
    rdfs:domain utt:WaargenomenKenmerken ;
    rdfs:range xsd:string ;
    skos:definition "Colour of the cable, pipe or marking as observed in the field."@en,
        "Kleur van de kabel, leiding of markering zoals waargenomen in het veld."@nl .

utt:waargenomenMateriaal a owl:ObjectProperty ;
    rdfs:label "observed material"@en,
        "waargenomen materiaal"@nl ;
    rdfs:comment "Material type. Mirrors the IMKL PipeMaterialType value list via rdfs:seeAlso."@en ;
    rdfs:domain utt:WaargenomenKenmerken ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( utt:ImklPipeMaterialTypeValue utt:KabelConstructieValue ) ] ;
    skos:definition "Material type. Mirrors the IMKL PipeMaterialType value list."@en,
        "Materiaaltype. Hergebruikt IMKL PipeMaterialType waardelijst."@nl .

utt:waargenomenType a owl:ObjectProperty ;
    rdfs:label "observed type"@en,
        "waargenomen type"@nl ;
    rdfs:comment "Theme (type of utility) of the observed cable or pipe."@en ;
    rdfs:domain utt:Waarneming ;
    rdfs:range utt:ImklThema ;
    skos:definition """The type of utility (theme) of the observed cable or\r
    pipe. Uses the IMKL Thema value list."""@en,
        """Het type nutsvoorziening (thema) van de waargenomen\r
    kabel of leiding. Gebruikt IMKL Thema waardelijst."""@nl .

utt:waarnemingUitActiviteit a owl:ObjectProperty ;
    rdfs:label "observation from activity"@en,
        "waarneming uit activiteit"@nl ;
    rdfs:domain utt:Waarneming ;
    rdfs:range utt:VerificatieActiviteit ;
    skos:definition "Links an individual field observation to the verification activity that produced it."@en,
        "Verbindt een afzonderlijke veldwaarneming met de verificatieactiviteit waarin deze is vastgelegd."@nl .

uttvoc:aangrijpingspuntOnbekend a owl:NamedIndividual,
        skos:Concept,
        utt:DiepteAangrijpingspuntValue ;
    skos:definition "The reference point was not recorded."@en,
        "Het aangrijpingspunt is niet vastgelegd."@nl ;
    skos:inScheme uttvoc:DiepteAangrijpingspuntScheme ;
    skos:prefLabel "unknown reference point"@en,
        "onbekend aangrijpingspunt"@nl .

uttvoc:aansluitleiding a owl:NamedIndividual,
        skos:Concept,
        utt:ImklThema ;
    skos:broadMatch <https://data.gwsw.nl/Totaal/Aansluitleiding> ;
    skos:closeMatch <https://data.gwsw.nl/Totaal/Perceelaansluitleiding> ;
    skos:definition "Service connection from property to main sewer."@en,
        "Aansluitleiding van perceel naar hoofdriool."@nl ;
    skos:inScheme uttvoc:ThemaScheme ;
    skos:prefLabel "service connection"@en,
        "aansluitleiding"@nl ;
    utt:pmklKleur "#ba38a8" .

uttvoc:aluminium a owl:NamedIndividual,
        skos:Concept,
        utt:ImklPipeMaterialTypeValue ;
    skos:definition "Aluminium, common in medium voltage cables."@en,
        "Aluminium, gangbaar in middenspanningskabels."@nl ;
    skos:inScheme uttvoc:MateriaalScheme ;
    skos:prefLabel "aluminium"@en,
        "aluminium"@nl .

uttvoc:asbestcement a owl:NamedIndividual,
        skos:Concept,
        utt:ImklPipeMaterialTypeValue ;
    skos:definition "Asbestos cement. A find triggers a separate site safety procedure."@en,
        "Asbestcement. Een vondst vereist een aparte veiligheidsprocedure op locatie."@nl ;
    skos:exactMatch <http://definities.geostandaarden.nl/imkl2015/id/waardelijst/PipeMaterialTypeValue/AA>,
        <https://data.gwsw.nl/Totaal/Asbestcement> ;
    skos:inScheme uttvoc:MateriaalScheme ;
    skos:prefLabel "asbestos cement"@en,
        "asbestcement"@nl .

uttvoc:beheerderArchief a owl:NamedIndividual,
        skos:Concept,
        utt:RegistratieBron ;
    skos:definition "Archive or asset management system of the network operator or municipality."@en,
        "Archief of beheersysteem van de netbeheerder of gemeente."@nl ;
    skos:inScheme uttvoc:RegistratieBronScheme ;
    skos:prefLabel "asset owner archive"@en,
        "beheerderarchief"@nl .

uttvoc:beton a owl:NamedIndividual,
        skos:Concept,
        utt:ImklPipeMaterialTypeValue ;
    skos:definition "Concrete, plain or reinforced."@en,
        "Beton, ongewapend of gewapend."@nl ;
    skos:exactMatch <http://definities.geostandaarden.nl/imkl2015/id/waardelijst/PipeMaterialTypeValue/AG>,
        <https://data.gwsw.nl/Totaal/Beton> ;
    skos:inScheme uttvoc:MateriaalScheme ;
    skos:prefLabel "concrete"@en,
        "beton"@nl .

uttvoc:bewerkt a owl:NamedIndividual,
        skos:Concept,
        utt:BronRol ;
    skos:inScheme uttvoc:BronRolScheme ;
    skos:prefLabel "Processed source"@en,
        "Bewerkte bron"@nl .

uttvoc:bob a owl:NamedIndividual,
        skos:Concept,
        utt:DiepteAangrijpingspuntValue ;
    rdfs:seeAlso <https://data.gwsw.nl/> ;
    skos:definition "Invert level, the reference point normally used for gravity sewers."@en,
        "Binnenonderkant buis, het gangbare aangrijpingspunt voor vrijvervalriolering."@nl ;
    skos:exactMatch <https://data.gwsw.nl/Totaal/Binnenonderkant_buis> ;
    skos:inScheme uttvoc:DiepteAangrijpingspuntScheme ;
    skos:prefLabel "invert level"@en,
        "BOB"@nl .

uttvoc:bovenkant a owl:NamedIndividual,
        skos:Concept,
        utt:DiepteAangrijpingspuntValue ;
    rdfs:seeAlso <https://docs.geostandaarden.nl/kl/imkl/> ;
    skos:definition "Depth measured to the top of the object."@en,
        "Diepte gemeten tot de bovenkant van het object."@nl ;
    skos:inScheme uttvoc:DiepteAangrijpingspuntScheme ;
    skos:prefLabel "top"@en,
        "bovenkant"@nl .

uttvoc:cadTekening a owl:NamedIndividual,
        skos:Concept,
        utt:DataFormaat ;
    skos:definition "DWG, DXF format."@en,
        "DWG, DXF formaat."@nl ;
    skos:inScheme uttvoc:DataFormaatScheme ;
    skos:prefLabel "CAD drawing"@en,
        "CAD tekening"@nl .

uttvoc:cai a owl:NamedIndividual,
        skos:Concept,
        utt:ImklThema ;
    skos:broader uttvoc:telecom ;
    skos:definition "Cable television network."@en,
        "Centrale antenne inrichting, kabeltelevisienetwerk."@nl ;
    skos:inScheme uttvoc:ThemaScheme ;
    skos:prefLabel "cable television"@en,
        "CAI"@nl ;
    utt:pmklKleur "#00ff00" .

uttvoc:cityGmlBestand a owl:NamedIndividual,
