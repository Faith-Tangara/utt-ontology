                                   rdfs:label "QUDT Eenheid"@nl ,
                                              "QUDT Unit"@en ;
                                   rdfs:seeAlso <http://qudt.org/schema/qudt/> .


###  http://rdfs.org/ns/void#Dataset
<http://rdfs.org/ns/void#Dataset> rdf:type owl:Class ;
                                  rdfs:label "VoID Dataset"@en ,
                                             "VoID Dataset"@nl ;
                                  rdfs:seeAlso <http://www.w3.org/TR/void/> .


###  http://www.opengis.net/ont/geosparql#Feature
<http://www.opengis.net/ont/geosparql#Feature> rdf:type owl:Class ;
                                               <https://prez.dev/description> "A discrete spatial phenomenon in a universe of discourse."@en ;
                                               <https://prez.dev/label> "Feature"@en .


###  http://www.opengis.net/ont/geosparql#Geometry
<http://www.opengis.net/ont/geosparql#Geometry> rdf:type owl:Class ;
                                                <https://prez.dev/description> "A coherent set of direct positions in Euclidian space. A direct position holds the coordinates for a position within a Coordinate Reference System (CRS)."@en ,
                                                                               "A coherent set of direct positions in space. The positions are held within a Spatial Reference System (SRS)."@en ;
                                                <https://prez.dev/label> "Geometry"@en .


###  http://www.w3.org/2004/02/skos/core#Concept
<http://www.w3.org/2004/02/skos/core#Concept> rdf:type owl:Class .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
<http://www.w3.org/2004/02/skos/core#ConceptScheme> rdf:type owl:Class .


###  http://www.w3.org/ns/dcat#Dataset
<http://www.w3.org/ns/dcat#Dataset> rdf:type owl:Class ;
                                    rdfs:label "DCAT Dataset"@en ,
                                               "DCAT Dataset"@nl ;
                                    rdfs:seeAlso <http://www.w3.org/TR/vocab-dcat-3/> .


###  http://www.w3.org/ns/prov#Activity
<http://www.w3.org/ns/prov#Activity> rdf:type owl:Class .


###  http://www.w3.org/ns/prov#Agent
<http://www.w3.org/ns/prov#Agent> rdf:type owl:Class .


###  http://www.w3.org/ns/prov#Entity
<http://www.w3.org/ns/prov#Entity> rdf:type owl:Class .


###  https://w3id.org/utt/def/Aannemer
:Aannemer rdf:type owl:Class ;
          rdfs:subClassOf <http://www.w3.org/ns/prov#Agent> ;
          rdfs:comment "Contractor organisation responsible for the excavation work."@en ;
          rdfs:label "Aannemer"@nl ,
                     "Contractor"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "Organisatie verantwoordelijk voor de graafwerkzaamheden."@nl ,
                                                           "Organisation responsible for the excavation work."@en .


###  https://w3id.org/utt/def/CoordinaatStelsel
:CoordinaatStelsel rdf:type owl:Class ;
                   rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                   rdfs:comment "Top concept of the UTT coordinate reference system SKOS vocabulary."@en ;
                   rdfs:label "Coordinate Reference System"@en ,
                              "Coördinaatstelsel"@nl ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Coordinate reference system in which geometry is expressed."@en ,
                                                                    "Coördinaatstelsel waarin geometrie is uitgedrukt."@nl ;
                   <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://w3id.org/utt/voc/CoordinaatStelselScheme> .


###  https://w3id.org/utt/def/DataFormaat
:DataFormaat rdf:type owl:Class ;
             rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
             rdfs:comment "Top concept of the UTT data format SKOS vocabulary."@en ;
             rdfs:label "Data Formaat"@nl ,
                        "Data Format"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "Formaat van ondersteunend data bestand."@nl ,
                                                              "Format of a supporting data file."@en ;
             <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://w3id.org/utt/voc/DataFormaatScheme> .


###  https://w3id.org/utt/def/DetailNiveau
:DetailNiveau rdf:type owl:Class ;
              rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
              rdfs:comment "Top concept of the UTT level of detail SKOS vocabulary."@en ;
              rdfs:label "Detail Niveau"@nl ,
                         "Level of Detail"@en ;
              rdfs:seeAlso <https://www.ogc.org/standards/citygml> ;
              <http://www.w3.org/2004/02/skos/core#definition> "Detailniveau van vastgelegde geometrie."@nl ,
                                                               "Level of detail of captured geometry."@en ;
              <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://w3id.org/utt/voc/DetailNiveauScheme> .


###  https://w3id.org/utt/def/DiepteAangrijpingspuntValue
:DiepteAangrijpingspuntValue rdf:type owl:Class ;
                             rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                             rdfs:comment "Depth reference point dictionary. Mirrors the IMKL depth reference point list."@en ;
                             rdfs:label "Depth Reference Point Value"@en ,
                                        "Diepte Aangrijpingspunt Value"@nl ;
                             rdfs:seeAlso <https://docs.geostandaarden.nl/kl/imkl/> ;
                             <http://www.w3.org/2004/02/skos/core#definition> "Aangrijpingspunt waarop diepte is gemeten, per meting expliciet gedeclareerd."@nl ,
                                                                              "Reference point at which depth is measured, explicitly declared per measurement."@en ;
                             <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://w3id.org/utt/voc/DiepteAangrijpingspuntScheme> .


###  https://w3id.org/utt/def/GeregistreerdePositie
:GeregistreerdePositie rdf:type owl:Class ;
                       rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ;
                       rdfs:comment "The expected position of a utility as recorded in a registry."@en ;
                       rdfs:label "Geregistreerde Positie"@nl ,
                                  "Registered Position"@en ;
                       <http://www.w3.org/2004/02/skos/core#definition> "De verwachte positie van een kabel of leiding volgens de registratie."@nl ,
                                                                        "The expected position of a cable or pipe according to the registry."@en .


###  https://w3id.org/utt/def/Graafpolygoon
:Graafpolygoon rdf:type owl:Class ;
               rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> ;
               rdfs:comment """The polygon delineating the area for which underground
    utility information is requested. Declared as a subclass of geo:Feature so its geometry
    is carried via geo:hasGeometry."""@en ;
               rdfs:label "Excavation Polygon"@en ,
                          "Graafpolygoon"@nl ;
               rdfs:seeAlso <https://docs.geostandaarden.nl/kl/pmkl30/> ;
               <http://www.w3.org/2004/02/skos/core#definition> """Het polygoon dat het gebied afbakent waarvoor informatie
    over ondergrondse kabels en leidingen wordt opgevraagd."""@nl ,
                                                                """The polygon delineating the area for which underground
    utility information is requested."""@en .


###  https://w3id.org/utt/def/GrondCondities
:GrondCondities rdf:type owl:Class ;
                rdfs:comment "Captures ground condition information at the trench."@en ;
                rdfs:label "Grond Condities"@nl ,
                           "Ground Conditions"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "Grondcondities ter plaatse van de proefsleuf."@nl ,
                                                                 "Ground conditions at the trench site."@en .


###  https://w3id.org/utt/def/ImklKabelOfLeiding
:ImklKabelOfLeiding rdf:type owl:Class ;
                    rdfs:comment "UTT bridge class used to represent a cable or pipe registered in KLIC/IMKL. IMKL is referenced as an external information model; this class is defined by UTT and is not an IMKL ontology class."@en ,
                                 "UTT-brugklasse voor een kabel of leiding die in KLIC/IMKL is geregistreerd. IMKL wordt als extern informatiemodel gerefereerd; deze klasse is door UTT gedefinieerd en is geen IMKL-ontologieklasse."@nl ;
                    rdfs:label "IMKL Cable or Pipe"@en ,
                               "IMKL Kabel of Leiding"@nl ;
                    rdfs:seeAlso <https://docs.geostandaarden.nl/kl/imkl/> .


###  https://w3id.org/utt/def/ImklPipeMaterialTypeValue
:ImklPipeMaterialTypeValue rdf:type owl:Class ;
                           rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                           rdfs:comment """Material of the observed cable or pipe. Mirrors the
    IMKL PipeMaterialType value list."""@en ;
                           rdfs:label "Materiaal Value"@nl ,
                                      "Pipe Material Type Value"@en ;
                           rdfs:seeAlso <https://data.gwsw.nl/Totaal/Materiaal_leiding> ,
                                        <https://docs.geostandaarden.nl/kl/imkl/> ;
                           <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://w3id.org/utt/voc/MateriaalScheme> .


###  https://w3id.org/utt/def/ImklThema
:ImklThema rdf:type owl:Class ;
           rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
           rdfs:comment "Stub for the IMKL utility theme class."@en ;
           rdfs:label "IMKL Thema"@nl ,
                      "IMKL Theme"@en ;
           rdfs:seeAlso <https://docs.geostandaarden.nl/kl/imkl/> ;
           <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://w3id.org/utt/voc/ThemaScheme> .


###  https://w3id.org/utt/def/KabelConstructieValue
:KabelConstructieValue rdf:type owl:Class ;
                       rdfs:comment "Value list for cable constructions such as GPLK and coaxial cable."@en ;
                       rdfs:label "cable construction value"@en ,
                                  "kabelconstructie waarde"@nl ;
                       <http://www.w3.org/2004/02/skos/core#definition> "Value list for cable constructions."@en ,
                                                                        "Waardelijst voor kabelconstructies."@nl .


###  https://w3id.org/utt/def/Landmeter
:Landmeter rdf:type owl:Class ;
           rdfs:subClassOf <http://www.w3.org/ns/prov#Agent> ;
           rdfs:comment "Person or organisation performing the field measurements."@en ;
           rdfs:label "Landmeter"@nl ,
                      "Surveyor"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "Person or organisation performing the measurements."@en ,
                                                            "Persoon of organisatie die de metingen uitvoert."@nl .


###  https://w3id.org/utt/def/Mantelbuis
:Mantelbuis rdf:type owl:Class ;
            rdfs:subClassOf :Waarneming ;
            rdfs:comment """A sleeve or mantel tube observed in a trench, which physically
    contains other cables or pipes."""@en ;
            rdfs:label "Mantelbuis"@nl ,
                       "Sleeve"@en ;
            <http://www.w3.org/2004/02/skos/core#definition> "A sleeve or mantel tube enclosing other cables or pipes."@en ,
                                                             "Mantelbuis die andere kabels of leidingen omhult."@nl ;
            <http://www.w3.org/2004/02/skos/core#exactMatch> <https://data.gwsw.nl/Totaal/Mantelbuis> .


###  https://w3id.org/utt/def/Meetapparatuur
:Meetapparatuur rdf:type owl:Class ;
                rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ;
                rdfs:comment "The physical instrument used to take a measurement."@en ;
                rdfs:label "Measurement Equipment"@en ,
                           "Meetapparatuur"@nl ;
                <http://www.w3.org/2004/02/skos/core#definition> "Het fysieke instrument waarmee is gemeten."@nl ,
                                                                 "The physical instrument used to measure."@en .


###  https://w3id.org/utt/def/Meetmethode
:Meetmethode rdf:type owl:Class ;
             rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
             rdfs:comment "Top concept of the UTT measurement methods SKOS vocabulary."@en ;
             rdfs:label "Measurement Method"@en ,
                        "Meetmethode"@nl ;
             <http://www.w3.org/2004/02/skos/core#definition> "Techniek gebruikt voor positiebepaling."@nl ,
                                                              "Technique used for position determination."@en ;
             <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://w3id.org/utt/voc/MeetmethodeScheme> .


###  https://w3id.org/utt/def/Meetpunt
:Meetpunt rdf:type owl:Class ;
          rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> ,
                          <http://www.w3.org/ns/prov#Entity> ;
          rdfs:comment """A single point measured in the field, with its own number, its own
    survey date and its own uncertainty figure."""@en ;
          rdfs:label "meetpunt"@nl ,
                     "survey point"@en ;
          <http://www.w3.org/2004/02/skos/core#definition> "A single point measured in the field, carrying its own point number, survey date and uncertainty."@en ,
                                                           "Een enkel in het veld ingemeten punt, met eigen puntnummer, opnamedatum en onzekerheid."@nl .


###  https://w3id.org/utt/def/Nauwkeurigheid
:Nauwkeurigheid rdf:type owl:Class ;
                rdfs:comment "Measurement accuracy indicator."@en ;
                rdfs:label "Accuracy"@en ,
                           "Nauwkeurigheid"@nl ;
                <http://www.w3.org/2004/02/skos/core#definition> "Kwantitatieve onzekerheid van de gemeten positie."@nl ,
                                                                 "Quantitative uncertainty of the measured position."@en .


###  https://w3id.org/utt/def/NauwkeurigheidDiepteValue
:NauwkeurigheidDiepteValue rdf:type owl:Class ;
                           rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                           rdfs:comment "Depth accuracy classification. Mirrors the IMKL depth accuracy value list."@en ;
                           rdfs:label "Depth Accuracy Value"@en ,
                                      "Nauwkeurigheid Diepte Value"@nl ;
                           rdfs:seeAlso <https://docs.geostandaarden.nl/kl/imkl/> ;
                           <http://www.w3.org/2004/02/skos/core#definition> "Accuracy class for depth measurement."@en ,
                                                                            "Nauwkeurigheidsklasse voor dieptemeting."@nl ;
                           <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://w3id.org/utt/voc/NauwkeurigheidDiepteScheme> .


###  https://w3id.org/utt/def/NauwkeurigheidXYvalue
:NauwkeurigheidXYvalue rdf:type owl:Class ;
                       rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                       rdfs:comment "XY accuracy classification. Mirrors the IMKL XY accuracy value list."@en ;
                       rdfs:label "Nauwkeurigheid XY Value"@nl ,
                                  "XY Accuracy Value"@en ;
                       rdfs:seeAlso <https://docs.geostandaarden.nl/kl/imkl/> ;
                       <http://www.w3.org/2004/02/skos/core#definition> "Accuracy class for XY measurement."@en ,
                                                                        "Nauwkeurigheidsklasse voor XY meting."@nl ;
                       <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://w3id.org/utt/voc/NauwkeurigheidXYScheme> .


###  https://w3id.org/utt/def/OndersteunendeData
:OndersteunendeData rdf:type owl:Class ;
                    rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ;
                    rdfs:comment "External supporting data such as point clouds, photos, CAD drawings, or reports."@en ;
                    rdfs:label "Ondersteunende Data"@nl ,
                               "Supporting Data"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "Reference to external data files."@en ,
                                                                     "Verwijzing naar externe databestanden."@nl .


###  https://w3id.org/utt/def/PositieAfwijking
:PositieAfwijking rdf:type owl:Class ;
                  rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ;
                  rdfs:comment """The deviation between the registered expected position and
    the field-observed actual position. This class is optional."""@en ;
                  rdfs:label "Positie Afwijking"@nl ,
                             "Position Deviation"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Afgeleide afwijking tussen verwachte en feitelijke positie."@nl ,
                                                                   "Derived deviation between expected and actual position."@en .


###  https://w3id.org/utt/def/Proefsleuf
:Proefsleuf rdf:type owl:Class ;
            rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> ;
            rdfs:comment "Central class of UTT."@en ;
            rdfs:label "Proefsleuf"@nl ,
                       "Test Trench"@en ;
            rdfs:seeAlso <https://www.ogc.org/standards/citygml> ;
            <http://www.w3.org/2004/02/skos/core#definition> """A physical excavation made to verify the location, depth
    and condition of underground cables and pipes."""@en ,
                                                             """Een fysieke uitgraving gemaakt om de locatie, diepte en
    conditie van ondergrondse kabels en leidingen te verifiëren."""@nl .


###  https://w3id.org/utt/def/Project
:Project rdf:type owl:Class ;
         rdfs:comment "The excavation project under which one or more test trenches are dug."@en ;
         rdfs:label "Project"@en ,
                    "Project"@nl ;
         <http://www.w3.org/2004/02/skos/core#definition> "Het bouwproject waarbinnen de proefsleuf is gegraven."@nl ,
                                                          "The construction project under which the test trench was excavated."@en .


###  https://w3id.org/utt/def/PuntClassificatie
:PuntClassificatie rdf:type owl:Class ;
                   rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                   rdfs:comment "Top concept of the UTT point classification SKOS vocabulary."@en ;
                   rdfs:label "Point Classification"@en ,
                              "Puntclassificatie"@nl ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Classificatie van een punt in een puntenwolk."@nl ,
                                                                    "Classification of a point in a point cloud."@en ;
                   <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://w3id.org/utt/voc/PuntClassificatieScheme> .


###  https://w3id.org/utt/def/RegistratieBron
:RegistratieBron rdf:type owl:Class ;
                 rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                 rdfs:comment "Top concept of the UTT registration source SKOS vocabulary."@en ;
                 rdfs:label "Registratie Bron"@nl ,
                            "Registration Source"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Registratie waaruit een verwachte positie afkomstig is."@nl ,
                                                                  "Registry from which an expected position was obtained."@en ;
                 <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://w3id.org/utt/voc/RegistratieBronScheme> .


###  https://w3id.org/utt/def/SleufDoel
:SleufDoel rdf:type owl:Class ;
           rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
           rdfs:comment "Top concept of the UTT trench purpose SKOS vocabulary."@en ;
           rdfs:label "Purpose of Trench"@en ,
                      "Sleuf Doel"@nl ;
           <http://www.w3.org/2004/02/skos/core#definition> "Reason the test trench was excavated."@en ,
                                                            "Reden waarom een proefsleuf wordt gegraven."@nl ;
           <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://w3id.org/utt/voc/SleufDoelScheme> .


###  https://w3id.org/utt/def/UTTDataset
:UTTDataset rdf:type owl:Class ;
            rdfs:subClassOf <http://rdfs.org/ns/void#Dataset> ,
                            <http://www.w3.org/ns/dcat#Dataset> ;
            rdfs:comment "A published collection of UTT trench records held by one party."@en ;
            rdfs:label "UTT Dataset"@en ,
                       "UTT Dataset"@nl ;
            <http://www.w3.org/2004/02/skos/core#definition> "A published collection of UTT trench records held by one party."@en ,
                                                             "Een gepubliceerde verzameling UTT proefsleufgegevens van één partij."@nl .


###  https://w3id.org/utt/def/VerificatieActiviteit
:VerificatieActiviteit rdf:type owl:Class ;
                       rdfs:subClassOf <http://www.w3.org/ns/prov#Activity> ;
                       rdfs:comment "The act of measuring and verifying the utilities observed in a trench."@en ;
                       rdfs:label "Verificatie Activiteit"@nl ,
                                  "Verification Activity"@en ;
                       <http://www.w3.org/2004/02/skos/core#definition> "De handeling van meten en verifiëren van de waarnemingen in een proefsleuf."@nl ,
                                                                        "The act of measuring and verifying the observations in a trench."@en .


###  https://w3id.org/utt/def/WaargenomenKenmerken
:WaargenomenKenmerken rdf:type owl:Class ;
                      rdfs:comment "Physical characteristics of the cable or pipe as observed in the field."@en ;
                      rdfs:label "Observed Characteristics"@en ,
                                 "Waargenomen Kenmerken"@nl ;
                      <http://www.w3.org/2004/02/skos/core#definition> "Fysieke eigenschappen van de kabel of leiding zoals waargenomen in het veld."@nl ,
                                                                       "Physical properties of the cable or pipe as observed in the field."@en .


###  https://w3id.org/utt/def/WaargenomenPositie
:WaargenomenPositie rdf:type owl:Class ;
                    rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ;
                    rdfs:comment "The field-observed 3D position of a utility."@en ;
                    rdfs:label "Observed Position"@en ,
                               "Waargenomen Positie"@nl ;
                    <http://www.w3.org/2004/02/skos/core#definition> "De in het veld gemeten 3D positie van een kabel of leiding."@nl ,
                                                                     "The field-measured 3D position of a cable or pipe."@en .


###  https://w3id.org/utt/def/Waarneming
:Waarneming rdf:type owl:Class ;
            rdfs:subClassOf <http://www.w3.org/ns/prov#Entity> ;
            rdfs:comment "A record of a cable or pipe observed in a test trench."@en ;
            rdfs:label "Observation"@en ,
                       "Waarneming"@nl ;
            <http://www.w3.org/2004/02/skos/core#definition> "A record of a cable or pipe observed in a test trench."@en ,
                                                             "Een registratie van een kabel of leiding die is waargenomen in een proefsleuf."@nl .


###  https://w3id.org/utt/def/WaarnemingStatus
:WaarnemingStatus rdf:type owl:Class ;
                  rdfs:subClassOf <http://www.w3.org/2004/02/skos/core#Concept> ;
                  rdfs:comment "Top concept of the UTT observation status SKOS vocabulary."@en ;
                  rdfs:label "Observation Status"@en ,
                             "Waarneming Status"@nl ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Status of an observation with respect to the registry."@en ,
                                                                   "Status van een waarneming ten opzichte van de registratie."@nl ;
                  <http://www.w3.org/2004/02/skos/core#topConceptOf> <https://w3id.org/utt/voc/WaarnemingStatusScheme> .


