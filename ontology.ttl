@prefix : <https://w3id.org/utt/def/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/utt/def/> .

<https://w3id.org/utt/def/> rdf:type owl:Ontology ;
                             owl:versionIRI <https://w3id.org/utt/def/0.4> ;
                             owl:imports <http://www.opengis.net/ont/geosparql> ;
                             <http://purl.org/dc/terms/conformsTo> <http://www.opengis.net/def/crs/EPSG/0/28992> ,
                                                                   <http://www.opengis.net/doc/IS/geosparql/1.1> ;
                             <http://purl.org/dc/terms/created> "2026-01-13"^^xsd:date ;
                             <http://purl.org/dc/terms/creator> "Faith Tangara" ;
                             <http://purl.org/dc/terms/description> "An ontology for capturing, sharing, and reusing verification data from test trench excavations (proefsleuven) in the Netherlands."@en ,
                                                                    "Een ontologie voor het vastleggen, delen en hergebruiken van verificatiegegevens uit proefsleuven in Nederland."@nl ;
                             <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                             <http://purl.org/dc/terms/modified> "2026-08-18"^^xsd:date ;
                             <http://purl.org/dc/terms/publisher> "Faith Tangara" ;
                             <http://purl.org/dc/terms/title> "Universal Test Trench (UTT) Ontology"@en ,
                                                              "Universele Proefsleuf (UTT) Ontologie"@nl ;
                             rdfs:seeAlso <http://www.opengis.net/doc/IS/geosparql/1.1> ,
                                          <https://data.gwsw.nl/> ,
                                          <https://docs.geostandaarden.nl/kl/imkl/> ,
                                          <https://sparql.gwsw.nl/> ,
                                          <https://www.ogc.org/standards/citygml> ,
                                          <https://www.pdok.nl/introductie/-/article/stedelijk-water-riolering-> ;
                             owl:priorVersion <https://w3id.org/utt/def/0.3> ;
                             owl:versionInfo "0.4" .

