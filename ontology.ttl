<http://www.w3.org/2004/02/skos/core#topConceptOf> rdf:type owl:AnnotationProperty .


###  https://w3id.org/utt/def/eenheid
:eenheid rdf:type owl:AnnotationProperty ;
         rdfs:comment """Declares the unit in which values of the annotated datatype property
    are expressed. Values are QUDT unit individuals, so the unit itself is identified by a
    QUDT IRI and is machine resolvable.

    A local annotation property is used rather than a QUDT predicate for two reasons. First,
    qudt:unit is deprecated in QUDT 2.1 and marked dcterms:isReplacedBy qudt:hasUnit. Second,
    qudt:hasUnit relates a system of units to a unit, which is a different relationship from
    the one needed here. QUDT provides no predicate for annotating an owl:DatatypeProperty
    with the unit its values carry, because QUDT expects measurements to be reified as
    qudt:QuantityValue instances.

    UTT deliberately records plain xsd:decimal values rather than reified quantity values,
    since contractors supply flat numeric fields and reification would add a node per
    measurement for no practical gain. This property states the expected unit for producers
    and consumers of that data. It is documentation, not a quantity construction, and no
    reasoner will derive unit conversion from it."""@en ;
         rdfs:label "eenheid"@nl ,
                    "unit"@en ;
         rdfs:range <http://qudt.org/schema/qudt/Unit> .


###  https://w3id.org/utt/def/pmklKleur
:pmklKleur rdf:type owl:AnnotationProperty ;
           rdfs:comment """RGB hex colour from the PMKL (Presentatiemodel Kabels en
    Leidingen) version 3.0 colour table, published at docs.geostandaarden.nl/kl/pmkl30/.
    Annotated on ThemaScheme individuals so the viewer renders utilities in the colour
    practitioners expect from KLIC maps."""@en ;
           rdfs:label "PMKL colour"@en ,
                      "PMKL kleur"@nl ;
           rdfs:range xsd:string .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#anyURI
xsd:anyURI rdf:type rdfs:Datatype ;
           <https://prez.dev/label> "any URI" ,
                                    "anyURI" .


###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype ;
         <https://prez.dev/label> "date" .


###  http://www.w3.org/2001/XMLSchema#dateTime
xsd:dateTime rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#decimal
xsd:decimal rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#double
xsd:double rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#string
xsd:string rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://purl.org/dc/terms/format
<http://purl.org/dc/terms/format> rdf:type owl:ObjectProperty ;
                                  rdfs:domain :OndersteunendeData ;
                                  rdfs:range :DataFormaat ;
                                  rdfs:comment """Reused from Dublin Core Terms. Links a supporting data file
    to its format (e.g. point cloud, photo, PDF). Replaces utt:bestandsFormaat from v0.1
    following reviewer recommendation to reuse dcterms:format."""@en .


###  http://rdfs.org/ns/void#sparqlEndpoint
<http://rdfs.org/ns/void#sparqlEndpoint> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <http://rdfs.org/ns/void#Dataset> ;
                                         rdfs:range owl:Thing ;
                                         rdfs:comment """The SPARQL endpoint that serves this dataset. Recorded per
    participating party so a federated query can be routed without a central store."""@en .


###  http://rdfs.org/ns/void#vocabulary
<http://rdfs.org/ns/void#vocabulary> rdf:type owl:ObjectProperty ;
                                     rdfs:domain <http://rdfs.org/ns/void#Dataset> ;
                                     rdfs:range owl:Thing ;
                                     rdfs:comment "The vocabulary used by this dataset, normally the UTT ontology IRI."@en .


###  http://www.opengis.net/ont/geosparql#hasGeometry
<http://www.opengis.net/ont/geosparql#hasGeometry> rdf:type owl:ObjectProperty ;
                                                   <https://prez.dev/description> "A spatial representation for a given Feature."@en ;
                                                   <https://prez.dev/label> "has geometry"@en .


###  http://www.w3.org/ns/dcat#contactPoint
<http://www.w3.org/ns/dcat#contactPoint> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <http://www.w3.org/ns/dcat#Dataset> ;
                                         rdfs:range <http://www.w3.org/ns/prov#Agent> .


###  http://www.w3.org/ns/prov#wasAssociatedWith
<http://www.w3.org/ns/prov#wasAssociatedWith> rdf:type owl:ObjectProperty ;
                                              rdfs:domain <http://www.w3.org/ns/prov#Activity> ;
                                              rdfs:range <http://www.w3.org/ns/prov#Agent> .


###  http://www.w3.org/ns/prov#wasDerivedFrom
<http://www.w3.org/ns/prov#wasDerivedFrom> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <http://www.w3.org/ns/prov#Entity> ;
                                           rdfs:range <http://www.w3.org/ns/prov#Entity> .


###  https://w3id.org/utt/def/bestaatUitMeetpunt
:bestaatUitMeetpunt rdf:type owl:ObjectProperty ;
                    rdfs:domain [ rdf:type owl:Class ;
                                  owl:unionOf ( :Proefsleuf
                                                :WaargenomenPositie
                                              )
                                ] ;
                    rdfs:range :Meetpunt ;
                    rdfs:comment """Links an observed position to the individual survey points
    from which its geometry was constructed, so that a per point date and uncertainty stay
    traceable after the points have been joined into a line."""@en ;
                    rdfs:label "bestaat uit meetpunt"@nl ,
                               "consists of survey point"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> """Koppelt een waargenomen positie aan de afzonderlijke
    meetpunten waaruit de geometrie is opgebouwd."""@nl ,
                                                                     """Links an observed position to the individual survey
    points from which its geometry was constructed."""@en .


###  https://w3id.org/utt/def/bevatWaarneming
:bevatWaarneming rdf:type owl:ObjectProperty ;
                 rdfs:domain :Mantelbuis ;
                 rdfs:range :Waarneming ;
                 rdfs:comment """Used to represent nested utilities, where a sleeve (mantelbuis)
    physically contains other cables or pipes observed inside it."""@en ;
                 rdfs:label "bevat waarneming"@nl ,
                            "contains observation"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> """Observation of a cable or pipe observed inside this
    sleeve."""@en ,
                                                                  """Waarneming van een kabel of leiding die binnen deze
    mantelbuis is waargenomen."""@nl .


###  https://w3id.org/utt/def/bodemGeometrie
:bodemGeometrie rdf:type owl:ObjectProperty ;
                rdfs:domain :Proefsleuf ;
                rdfs:range <http://www.opengis.net/ont/geosparql#Geometry> ;
                rdfs:comment """The excavation floor outline, as distinct from the ground
    level outline carried by utt:sleufGeometrie. Added in v0.4 because contractor drawings
    deliver both outlines and a single geometry property cannot say which is which. The pair
    gives the excavated volume rather than only a footprint, and the floor level records how
    far the excavation actually reached, which is the exclusion evidence for utilities that
    could have been present but were not found."""@en ;
                rdfs:label "bodemgeometrie"@nl ,
                           "trench floor geometry"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "Omtrek van de bodem van de proefsleuf."@nl ,
                                                                 "Outline of the floor of the test trench."@en .


###  https://w3id.org/utt/def/coordinaatstelsel
:coordinaatstelsel rdf:type owl:ObjectProperty ;
                   rdfs:domain <http://www.opengis.net/ont/geosparql#Geometry> ;
                   rdfs:range :CoordinaatStelsel ;
                   rdfs:comment """Declares the coordinate reference system of a geometry
    as a first-class resource, in addition to the CRS URI carried inside the geo:asWKT
    literal. Stated explicitly because UTT data combines a horizontal frame (RD New) with a
    separate vertical datum (NAP), which a single WKT CRS prefix does not always express."""@en ;
                   rdfs:label "coordinate reference system"@en ,
                              "coördinaatstelsel"@nl ;
                   <http://www.w3.org/2004/02/skos/core#definition> """Het coördinaatstelsel waarin deze geometrie is
    uitgedrukt."""@nl ,
                                                                    """The coordinate reference system in which this geometry
    is expressed."""@en .


###  https://w3id.org/utt/def/detailNiveau
:detailNiveau rdf:type owl:ObjectProperty ;
              rdfs:domain :OndersteunendeData ;
              rdfs:range :DetailNiveau ;
              rdfs:comment """Level of detail of the captured geometry, following the CityGML
    LoD concept."""@en ;
              rdfs:label "detail niveau"@nl ,
                         "level of detail"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> """Detailniveau van de vastgelegde geometrie, aansluitend op
    het CityGML LoD concept."""@nl ,
                                                               """Level of detail of the captured geometry, aligned to the
    CityGML LoD concept."""@en .


###  https://w3id.org/utt/def/diepteAangrijpingspunt
:diepteAangrijpingspunt rdf:type owl:ObjectProperty ;
                        rdfs:domain [ rdf:type owl:Class ;
                                      owl:unionOf ( :GeregistreerdePositie
                                                    :WaargenomenPositie
                                                  )
                                    ] ;
                        rdfs:range :DiepteAangrijpingspuntValue ;
                        rdfs:comment """The reference point on the utility from which depth
    is measured. Must be explicitly declared per measurement; depth values are only meaningful
    when the reference point is known (top, axis, bottom, BOB for sewer, etc.)."""@en ;
                        rdfs:label "depth reference point"@en ,
                                   "diepte aangrijpingspunt"@nl ;
                        <http://www.w3.org/2004/02/skos/core#definition> """Het punt op het object waarop de diepte is gemeten
    (bovenkant, hart, onderkant, BOB). Hergebruikt IMKL waardelijst via rdfs:seeAlso."""@nl ,
                                                                         """The point on the utility where depth is measured
    (top, axis, bottom, invert). Mirrors the IMKL value list via rdfs:seeAlso."""@en .


###  https://w3id.org/utt/def/doelVanSleuf
:doelVanSleuf rdf:type owl:ObjectProperty ;
              rdfs:domain :Proefsleuf ;
              rdfs:range :SleufDoel ;
              rdfs:comment """Captures why the trench was excavated. The purpose drives the
    type and resolution of data that can be expected from the observation."""@en ;
              rdfs:label "doel van sleuf"@nl ,
                         "purpose of trench"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> """Reason the test trench was excavated (KLIC verification,
    new installation, maintenance, design investigation)."""@en ,
                                                               """Reden waarom de proefsleuf is gegraven (KLIC verificatie,
    nieuwe aanleg, onderhoud, ontwerp onderzoek)."""@nl .


###  https://w3id.org/utt/def/feitelijkePositie
:feitelijkePositie rdf:type owl:ObjectProperty ;
                   rdfs:domain :PositieAfwijking ;
                   rdfs:range :WaargenomenPositie ;
                   rdfs:comment """One of two positions compared to derive a deviation.
    This refers to the field-observed position measured during verification."""@en ;
                   rdfs:label "actual position"@en ,
                              "feitelijke positie"@nl ;
                   <http://www.w3.org/2004/02/skos/core#definition> """De in het veld waargenomen positie waartegen de
    verwachte positie wordt vergeleken."""@nl ,
                                                                    """The field-observed position against which the expected
    position is compared."""@en .


###  https://w3id.org/utt/def/gebruiktApparatuur
:gebruiktApparatuur rdf:type owl:ObjectProperty ;
                    rdfs:domain :VerificatieActiviteit ;
                    rdfs:range :Meetapparatuur ;
                    rdfs:comment """Links a verification activity to the specific instrument
    used. Distinct from gebruiktMethode: the method is the technique (LiDAR), the equipment is
    the device (Leica BLK2GO)."""@en ;
                    rdfs:label "gebruikt apparatuur"@nl ,
                               "used equipment"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "Het instrument waarmee de meting is uitgevoerd."@nl ,
                                                                     "The instrument with which the measurement was taken."@en .


###  https://w3id.org/utt/def/gebruiktMethode
:gebruiktMethode rdf:type owl:ObjectProperty ;
                 rdfs:domain :VerificatieActiviteit ;
                 rdfs:range :Meetmethode ;
                 rdfs:comment """Links the verification activity to the measurement method
    used."""@en ;
                 rdfs:label "gebruikt methode"@nl ,
                            "used method"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "De meetmethode die is gebruikt."@nl ,
                                                                  "The measurement method that was used."@en .


###  https://w3id.org/utt/def/geregistreerdeGeometrie
:geregistreerdeGeometrie rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf <http://www.opengis.net/ont/geosparql#hasGeometry> ;
                         rdfs:domain :GeregistreerdePositie ;
                         rdfs:range <http://www.opengis.net/ont/geosparql#Geometry> ;
                         rdfs:comment "Geometry of the position as held in the registry."@en ;
                         rdfs:label "geregistreerde geometrie"@nl ,
                                    "registered geometry"@en ;
                         <http://www.w3.org/2004/02/skos/core#definition> "Geometrie van de positie zoals vastgelegd in de registratie."@nl ,
                                                                          "Geometry of the position as held in the registry."@en .


###  https://w3id.org/utt/def/geverifieerdDoor
:geverifieerdDoor rdf:type owl:ObjectProperty ;
                  rdfs:domain :Proefsleuf ;
                  rdfs:range :VerificatieActiviteit ;
                  rdfs:comment "Links a test trench to the verification activity that produced its data."@en ;
                  rdfs:label "geverifieerd door"@nl ,
                             "verified by"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "De verificatie activiteit die deze proefsleuf heeft aangemaakt."@nl ,
                                                                   "The verification activity that produced this test trench record."@en .


###  https://w3id.org/utt/def/heeftAanvrager
:heeftAanvrager rdf:type owl:ObjectProperty ;
                rdfs:domain :Graafpolygoon ;
                rdfs:range <http://www.w3.org/ns/prov#Agent> ;
                rdfs:comment "The party that submitted the area request."@en ;
                rdfs:label "has requesting party"@en ,
                           "heeft aanvrager"@nl ;
                <http://www.w3.org/2004/02/skos/core#definition> "De partij die het gebiedsverzoek heeft ingediend."@nl ,
                                                                 "The party that submitted the area request."@en .


###  https://w3id.org/utt/def/heeftAfwijking
:heeftAfwijking rdf:type owl:ObjectProperty ;
                rdfs:domain :Waarneming ;
                rdfs:range :PositieAfwijking ;
                rdfs:comment "Links an observation to a deviation record."@en ;
                rdfs:label "has deviation"@en ,
                           "heeft afwijking"@nl ;
                <http://www.w3.org/2004/02/skos/core#definition> """Afwijking ten opzichte van de geregistreerde positie,
    afgeleid uit twee expliciete positie instanties."""@nl ,
                                                                 """Deviation from the registered position, derived from two
    explicit position instances."""@en .


###  https://w3id.org/utt/def/heeftBijdrager
:heeftBijdrager rdf:type owl:ObjectProperty ;
                rdfs:domain :Graafpolygoon ;
                rdfs:range <http://www.w3.org/ns/prov#Agent> ;
                rdfs:comment """A party that contributed trench data in response to the
    area request. Multiple contributors are expected."""@en ;
                rdfs:label "has contributing party"@en ,
                           "heeft bijdrager"@nl ;
                <http://www.w3.org/2004/02/skos/core#definition> """A party that contributed trench data in response to
    the area request."""@en ,
                                                                 """Een partij die proefsleufinformatie heeft bijgedragen
    in reactie op het gebiedsverzoek."""@nl .


###  https://w3id.org/utt/def/heeftGrondCondities
:heeftGrondCondities rdf:type owl:ObjectProperty ;
                     rdfs:domain :Proefsleuf ;
                     rdfs:range :GrondCondities ;
                     rdfs:comment """Links a test trench to the observed ground conditions
    at the site (soil type, groundwater, compaction)."""@en ;
                     rdfs:label "has ground conditions"@en ,
                                "heeft grond condities"@nl ;
                     <http://www.w3.org/2004/02/skos/core#definition> """De waargenomen grondcondities ter plaatse van de
    proefsleuf."""@nl ,
                                                                      """The observed ground conditions at the site of the
    test trench."""@en .


###  https://w3id.org/utt/def/heeftKenmerken
:heeftKenmerken rdf:type owl:ObjectProperty ;
                rdfs:domain :Waarneming ;
                rdfs:range :WaargenomenKenmerken ;
                rdfs:comment "Links an observation to its observed physical characteristics."@en ;
                rdfs:label "has characteristics"@en ,
                           "heeft kenmerken"@nl ;
                <http://www.w3.org/2004/02/skos/core#definition> "Observed physical characteristics."@en ,
                                                                 "Waargenomen fysieke kenmerken."@nl .


###  https://w3id.org/utt/def/heeftMeetapparatuur
:heeftMeetapparatuur rdf:type owl:ObjectProperty ;
                     rdfs:domain :Meetpunt ;
                     rdfs:range :Meetapparatuur ;
                     rdfs:comment """Links a survey point to the equipment used for that
    point."""@en ;
                     rdfs:label "gemeten met apparatuur"@nl ,
                                "measured with equipment"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "Koppelt een meetpunt aan de gebruikte meetapparatuur."@nl ,
                                                                      "Links a survey point to the equipment used."@en .


###  https://w3id.org/utt/def/heeftNauwkeurigheid
:heeftNauwkeurigheid rdf:type owl:ObjectProperty ;
                     rdfs:domain [ rdf:type owl:Class ;
                                   owl:unionOf ( :GeregistreerdePositie
                                                 :WaargenomenPositie
                                               )
                                 ] ;
                     rdfs:range :Nauwkeurigheid ;
                     rdfs:comment """Accuracy is a property of the measured or registered
    position, not of the trench itself."""@en ;
                     rdfs:label "has accuracy"@en ,
                                "heeft nauwkeurigheid"@nl ;
                     <http://www.w3.org/2004/02/skos/core#definition> "Accuracy indicator for this position."@en ,
                                                                      "Nauwkeurigheidsindicator voor deze positie."@nl .


###  https://w3id.org/utt/def/heeftOndersteunendeData
:heeftOndersteunendeData rdf:type owl:ObjectProperty ;
                         rdfs:domain [ rdf:type owl:Class ;
                                       owl:unionOf ( :Proefsleuf
                                                     :Waarneming
                                                   )
                                     ] ;
                         rdfs:range :OndersteunendeData ;
                         rdfs:comment """Links an observation or a whole trench to external
    supporting files such as photos, point clouds, or CAD drawings."""@en ;
                         rdfs:label "has supporting data"@en ,
                                    "heeft ondersteunende data"@nl ;
                         <http://www.w3.org/2004/02/skos/core#definition> "Reference to supporting data files."@en ,
                                                                          "Verwijzing naar ondersteunende databestanden."@nl .


###  https://w3id.org/utt/def/heeftPositie
:heeftPositie rdf:type owl:ObjectProperty ;
              rdfs:domain :Waarneming ;
              rdfs:range :WaargenomenPositie ;
              rdfs:comment "Links an observation to its field-verified position."@en ;
              rdfs:label "has position"@en ,
                         "heeft positie"@nl ;
              <http://www.w3.org/2004/02/skos/core#definition> "De geverifieerde positie van deze waarneming."@nl ,
                                                               "The verified position of this observation."@en .


###  https://w3id.org/utt/def/heeftStatus
:heeftStatus rdf:type owl:ObjectProperty ;
             rdfs:domain :Waarneming ;
             rdfs:range :WaarnemingStatus ;
             rdfs:comment """Captures whether the observed utility matched the expected KLIC
    registration, deviated from it, or could not be identified at all."""@en ;
             rdfs:label "has status"@en ,
                        "heeft status"@nl ;
             <http://www.w3.org/2004/02/skos/core#definition> """Status of the observation: expected, aberrant, or unknown
    (not identifiable)."""@en ,
                                                              """Status van de waarneming: verwacht, afwijkend, of onbekend
    (niet te identificeren)."""@nl .


###  https://w3id.org/utt/def/heeftWaarneming
:heeftWaarneming rdf:type owl:ObjectProperty ;
                 owl:inverseOf :waargenomenIn ;
                 rdfs:domain :Proefsleuf ;
                 rdfs:range :Waarneming ;
                 rdfs:comment "Links a trench to the observations made within it."@en ;
                 rdfs:label "has observation"@en ,
                            "heeft waarneming"@nl ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Observations made in this test trench."@en ,
                                                                  "Waarnemingen gedaan in deze proefsleuf."@nl .


###  https://w3id.org/utt/def/komtOvereenMet
:komtOvereenMet rdf:type owl:ObjectProperty ;
                rdfs:domain :Waarneming ;
                rdfs:range :ImklKabelOfLeiding ;
                rdfs:comment """Links an observation to the registered asset in KLIC data
    when the correspondence can be established. The absence of this triple is meaningful and
    indicates an unregistered utility (orphan or weeslijding)."""@en ;
                rdfs:label "corresponds to"@en ,
                           "komt overeen met"@nl ;
                <http://www.w3.org/2004/02/skos/core#definition> """Reference to the registered IMKL object if identifiable.
    Absence of this relation indicates an unregistered utility."""@en ,
                                                                 """Verwijzing naar het geregistreerde IMKL object indien
    identificeerbaar. Afwezigheid van deze relatie duidt op een niet-geregistreerde
    utiliteit."""@nl .


###  https://w3id.org/utt/def/nauwkeurigheidDiepteklasse
:nauwkeurigheidDiepteklasse rdf:type owl:ObjectProperty ;
                            rdfs:domain :Nauwkeurigheid ;
                            rdfs:range :NauwkeurigheidDiepteValue ;
                            rdfs:comment "Mirrors the IMKL depth accuracy value list via rdfs:seeAlso."@en ;
                            rdfs:label "accuracy depth class"@en ,
                                       "nauwkeurigheid diepte klasse"@nl ;
                            <http://www.w3.org/2004/02/skos/core#definition> "Accuracy class for depth. Mirrors the IMKL value list."@en ,
                                                                             "Nauwkeurigheidsklasse voor diepte. Hergebruikt IMKL waardelijst."@nl .


###  https://w3id.org/utt/def/nauwkeurigheidXYklasse
:nauwkeurigheidXYklasse rdf:type owl:ObjectProperty ;
                        rdfs:domain :Nauwkeurigheid ;
                        rdfs:range :NauwkeurigheidXYvalue ;
                        rdfs:comment "Mirrors the IMKL XY accuracy value list via rdfs:seeAlso."@en ;
                        rdfs:label "accuracy XY class"@en ,
                                   "nauwkeurigheid XY klasse"@nl ;
                        <http://www.w3.org/2004/02/skos/core#definition> "Accuracy class for XY. Mirrors the IMKL value list."@en ,
                                                                         "Nauwkeurigheidsklasse voor XY. Hergebruikt IMKL waardelijst."@nl .


###  https://w3id.org/utt/def/onderdeelVanDataset
:onderdeelVanDataset rdf:type owl:ObjectProperty ;
                     rdfs:domain :Proefsleuf ;
                     rdfs:range :UTTDataset ;
                     rdfs:comment """Links a trench record to the published dataset that holds
    it. This is what makes the federation discoverable."""@en ;
                     rdfs:label "onderdeel van dataset"@nl ,
                                "part of dataset"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> """De gepubliceerde dataset waarin deze proefsleuf is
    opgenomen."""@nl ,
                                                                      """The published dataset in which this test trench is
    held."""@en .


###  https://w3id.org/utt/def/onderdeelVanProject
:onderdeelVanProject rdf:type owl:ObjectProperty ;
                     rdfs:domain :Proefsleuf ;
                     rdfs:range :Project ;
                     rdfs:comment "Groups multiple trenches under a single excavation job or project."@en ;
                     rdfs:label "onderdeel van project"@nl ,
                                "part of project"@en ;
                     <http://www.w3.org/2004/02/skos/core#definition> "Het project waartoe deze proefsleuf behoort."@nl ,
                                                                      "The project that this test trench belongs to."@en .


###  https://w3id.org/utt/def/onderdeelVanStelsel
:onderdeelVanStelsel rdf:type owl:ObjectProperty ;
                     rdfs:domain :Waarneming ;
                     rdfs:range owl:Thing ;
                     rdfs:comment """Links an observed utility to the network it belongs to,
    identified by an external IRI. UTT does not model networks itself."""@en ;
                     rdfs:label "onderdeel van stelsel"@nl ,
                                "part of network"@en ;
                     rdfs:seeAlso <https://data.gwsw.nl/> ;
                     <http://www.w3.org/2004/02/skos/core#definition> """Het netwerk of stelsel waartoe de waargenomen kabel of
    leiding behoort, geïdentificeerd via een externe IRI."""@nl ,
                                                                      """The network to which the observed cable or pipe
    belongs, identified by an external IRI."""@en .


###  https://w3id.org/utt/def/opdrachtVan
:opdrachtVan rdf:type owl:ObjectProperty ;
             rdfs:domain :VerificatieActiviteit ;
             rdfs:range :Aannemer ;
             rdfs:comment "Links a verification activity to the contractor who commissioned it."@en ;
             rdfs:label "commissioned by"@en ,
                        "opdracht van"@nl ;
             <http://www.w3.org/2004/02/skos/core#definition> "De aannemer die de verificatie heeft laten uitvoeren."@nl ,
                                                              "The contractor who commissioned the verification."@en .


###  https://w3id.org/utt/def/positieGeometrie
:positieGeometrie rdf:type owl:ObjectProperty ;
                  rdfs:subPropertyOf <http://www.opengis.net/ont/geosparql#hasGeometry> ;
                  rdfs:domain :WaargenomenPositie ;
                  rdfs:range <http://www.opengis.net/ont/geosparql#Geometry> ;
                  rdfs:comment "3D point or line geometry of the observed position."@en ;
                  rdfs:label "positie geometrie"@nl ,
                             "position geometry"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "3D point or line geometry of the observed position."@en ,
                                                                   "3D punt of lijn geometrie van de waargenomen positie."@nl .


###  https://w3id.org/utt/def/registratieBron
:registratieBron rdf:type owl:ObjectProperty ;
                 rdfs:domain :GeregistreerdePositie ;
                 rdfs:range :RegistratieBron ;
                 rdfs:comment "Identifies where a registered position was obtained from."@en ;
                 rdfs:label "registratiebron"@nl ,
                            "registration source"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> """De bron waaruit de geregistreerde positie is
    overgenomen."""@nl ,
                                                                  """The source from which the registered position was
    obtained."""@en .


###  https://w3id.org/utt/def/sleufGeometrie
:sleufGeometrie rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf <http://www.opengis.net/ont/geosparql#hasGeometry> ;
                rdfs:domain :Proefsleuf ;
                rdfs:range <http://www.opengis.net/ont/geosparql#Geometry> ;
                rdfs:comment "The 3D geometry of the trench."@en ;
                rdfs:label "sleuf geometrie"@nl ,
                           "trench geometry"@en ;
                <http://www.w3.org/2004/02/skos/core#definition> "De 3D geometrie van de proefsleuf (contour, polygoon, of lijn)."@nl ,
                                                                 "The 3D geometry of the test trench (contour, polygon, or line)."@en .


###  https://w3id.org/utt/def/uitgevoerdDoor
:uitgevoerdDoor rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf <http://www.w3.org/ns/prov#wasAssociatedWith> ;
                rdfs:domain :VerificatieActiviteit ;
                rdfs:range :Landmeter ;
                rdfs:comment "Links a verification activity to the surveyor or organisation that performed it."@en ;
                rdfs:label "performed by"@en ,
                           "uitgevoerd door"@nl ;
                <http://www.w3.org/2004/02/skos/core#definition> "De landmeter of organisatie die de meting heeft uitgevoerd."@nl ,
                                                                 "The surveyor or organisation that performed the measurement."@en .


###  https://w3id.org/utt/def/verwachtePositie
:verwachtePositie rdf:type owl:ObjectProperty ;
                  rdfs:domain :PositieAfwijking ;
                  rdfs:range :GeregistreerdePositie ;
                  rdfs:comment """One of two positions compared to derive a deviation.
    This refers to the registered expected position."""@en ;
                  rdfs:label "expected position"@en ,
                             "verwachte positie"@nl ;
                  <http://www.w3.org/2004/02/skos/core#definition> """De geregistreerde verwachte positie, waartegen de
    feitelijke positie wordt vergeleken."""@nl ,
                                                                   """The registered expected position against which the
    actual position is compared."""@en .


###  https://w3id.org/utt/def/waargenomenIn
:waargenomenIn rdf:type owl:ObjectProperty ;
               rdfs:domain :Waarneming ;
               rdfs:range :Proefsleuf ;
               rdfs:comment "Links an observation back to the trench in which it was made."@en ;
               rdfs:label "observed in"@en ,
                          "waargenomen in"@nl ;
               <http://www.w3.org/2004/02/skos/core#definition> "De proefsleuf waarin deze waarneming is gedaan."@nl ,
                                                                "The test trench in which this observation was made."@en .


###  https://w3id.org/utt/def/waargenomenMateriaal
:waargenomenMateriaal rdf:type owl:ObjectProperty ;
                      rdfs:domain :WaargenomenKenmerken ;
                      rdfs:range [ rdf:type owl:Class ;
                                   owl:unionOf ( :ImklPipeMaterialTypeValue
                                                 :KabelConstructieValue
                                               )
                                 ] ;
                      rdfs:comment "Material type. Mirrors the IMKL PipeMaterialType value list via rdfs:seeAlso."@en ;
                      rdfs:label "observed material"@en ,
                                 "waargenomen materiaal"@nl ;
                      <http://www.w3.org/2004/02/skos/core#definition> "Materiaaltype. Hergebruikt IMKL PipeMaterialType waardelijst."@nl ,
                                                                       "Material type. Mirrors the IMKL PipeMaterialType value list."@en .


###  https://w3id.org/utt/def/waargenomenType
:waargenomenType rdf:type owl:ObjectProperty ;
                 rdfs:domain :Waarneming ;
                 rdfs:range :ImklThema ;
                 rdfs:comment "Theme (type of utility) of the observed cable or pipe."@en ;
                 rdfs:label "observed type"@en ,
                            "waargenomen type"@nl ;
                 <http://www.w3.org/2004/02/skos/core#definition> """Het type nutsvoorziening (thema) van de waargenomen
    kabel of leiding. Gebruikt IMKL Thema waardelijst."""@nl ,
                                                                  """The type of utility (theme) of the observed cable or
    pipe. Uses the IMKL Thema value list."""@en .


#################################################################
#    Data properties
#################################################################

###  https://w3id.org/utt/def/actorNaam
:actorNaam rdf:type owl:DatatypeProperty ;
           rdfs:domain <http://www.w3.org/ns/prov#Agent> ;
           rdfs:range xsd:string ;
           rdfs:comment "Name of the person or organisation acting in the verification process."@en ;
           rdfs:label "actor naam"@nl ,
                      "actor name"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "Naam van de persoon of organisatie."@nl ,
                                                            "Name of the person or organisation."@en .


###  https://w3id.org/utt/def/afwijkingRichting
:afwijkingRichting rdf:type owl:DatatypeProperty ;
                   rdfs:domain :PositieAfwijking ;
                   rdfs:range xsd:decimal ;
                   rdfs:comment "Horizontal direction of the deviation in degrees (0-360, where 0 = north)."@en ;
                   rdfs:label "afwijking richting"@nl ,
                              "deviation direction"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "Direction of the horizontal deviation in degrees (0-360, where 0 = north)."@en ,
                                                                    "Richting van de horizontale afwijking in graden (0-360, waar 0 = noord)."@nl ;
                   :eenheid <http://qudt.org/vocab/unit/DEG> .


###  https://w3id.org/utt/def/antenneHoogte
:antenneHoogte rdf:type owl:DatatypeProperty ;
               rdfs:domain :Meetapparatuur ;
               rdfs:range xsd:decimal ;
               rdfs:comment "Height of the GNSS antenna above the measured point."@en ;
               rdfs:label "antenna height"@en ,
                          "antennehoogte"@nl ;
               <http://www.w3.org/2004/02/skos/core#definition> "Height of the GNSS antenna above the measured point."@en ,
                                                                "Hoogte van de GNSS antenne boven het ingemeten punt."@nl ;
               :eenheid <http://qudt.org/vocab/unit/M> .


###  https://w3id.org/utt/def/apparatuurModel
:apparatuurModel rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Meetapparatuur ;
                 rdfs:range xsd:string ;
                 rdfs:comment "Manufacturer and model of the instrument."@en ;
                 rdfs:label "apparatuur model"@nl ,
                            "equipment model"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Fabrikant en model van het instrument."@nl ,
                                                                  "Manufacturer and model of the instrument."@en .


###  https://w3id.org/utt/def/apparatuurSerienummer
:apparatuurSerienummer rdf:type owl:DatatypeProperty ;
                       rdfs:domain :Meetapparatuur ;
                       rdfs:range xsd:string ;
                       rdfs:comment "Serial number of the instrument."@en ;
                       rdfs:label "apparatuur serienummer"@nl ,
                                  "equipment serial number"@en ;
                       <http://www.w3.org/2004/02/skos/core#definition> "Serial number of the instrument."@en ,
                                                                        "Serienummer van het instrument."@nl .


###  https://w3id.org/utt/def/bestandsReferentie
:bestandsReferentie rdf:type owl:DatatypeProperty ;
                    rdfs:domain :OndersteunendeData ;
                    rdfs:range xsd:anyURI ;
                    rdfs:comment "URI reference to the external supporting data file."@en ;
                    rdfs:label "bestands referentie"@nl ,
                               "file reference"@en ;
                    <http://www.w3.org/2004/02/skos/core#definition> "URI reference to the external file."@en ,
                                                                     "URI verwijzing naar het externe bestand."@nl .


###  https://w3id.org/utt/def/bodemElevatieNAP
:bodemElevatieNAP rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Proefsleuf ;
                  rdfs:range xsd:decimal ;
                  rdfs:comment "Elevation of the excavation floor relative to NAP."@en ;
                  rdfs:label "bodemhoogte NAP"@nl ,
                             "trench floor elevation NAP"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Elevation of the trench floor relative to NAP."@en ,
                                                                   "Hoogte van de bodem van de proefsleuf ten opzichte van NAP."@nl ;
                  :eenheid <http://qudt.org/vocab/unit/M> .


###  https://w3id.org/utt/def/bodemType
:bodemType rdf:type owl:DatatypeProperty ;
           rdfs:domain :GrondCondities ;
           rdfs:range xsd:string ;
           rdfs:comment "Observed soil type at the trench location."@en ;
           rdfs:label "bodem type"@nl ,
                      "soil type"@en ;
           <http://www.w3.org/2004/02/skos/core#definition> "Observed soil type (e.g. sand, clay, peat, mixed)."@en ,
                                                            "Waargenomen bodemtype (bijv. zand, klei, veen, gemengd)."@nl .


###  https://w3id.org/utt/def/bronObjectId
:bronObjectId rdf:type owl:DatatypeProperty ;
              rdfs:domain :GeregistreerdePositie ;
              rdfs:range xsd:string ;
              rdfs:comment "Identifier of the object in the source registry."@en ;
              rdfs:label "bron object ID"@nl ,
                         "source object ID"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "Identificatie van het object in de bronregistratie."@nl ,
                                                               "Identifier of the object in the source registry."@en .


###  https://w3id.org/utt/def/bronPeildatum
:bronPeildatum rdf:type owl:DatatypeProperty ;
               rdfs:domain :GeregistreerdePositie ;
               rdfs:range xsd:dateTime ;
               rdfs:comment "Date and time at which the registered position was retrieved from its source."@en ;
               rdfs:label "bron peildatum"@nl ,
                          "source reference date"@en ;
               <http://www.w3.org/2004/02/skos/core#definition> "Date and time at which the registered position was retrieved from its source."@en ,
                                                                "Datum en tijd waarop de geregistreerde positie uit de bron is opgehaald."@nl .


###  https://w3id.org/utt/def/bronService
:bronService rdf:type owl:DatatypeProperty ;
             rdfs:domain :GeregistreerdePositie ;
             rdfs:range xsd:anyURI ;
             rdfs:comment "URI of the specific service endpoint the registered position was retrieved from."@en ;
             rdfs:label "bron service"@nl ,
                        "source service"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "URI of the service from which the registered position was retrieved."@en ,
                                                              "URI van de service waaruit de geregistreerde positie is opgehaald."@nl .


###  https://w3id.org/utt/def/classificatieCode
:classificatieCode rdf:type owl:DatatypeProperty ;
                   rdfs:domain :PuntClassificatie ;
                   rdfs:range xsd:integer ;
                   rdfs:comment "The integer value stored in the PLY class property for this category."@en ;
                   rdfs:label "classificatiecode"@nl ,
                              "classification code"@en ;
                   <http://www.w3.org/2004/02/skos/core#definition> "De integerwaarde opgeslagen in de PLY class eigenschap."@nl ,
                                                                    "The integer value stored in the PLY class property."@en .


###  https://w3id.org/utt/def/compactheid
:compactheid rdf:type owl:DatatypeProperty ;
             rdfs:domain :GrondCondities ;
             rdfs:range xsd:string ;
             rdfs:comment "Qualitative or quantitative description of soil compaction at the trench."@en ;
             rdfs:label "compactheid"@nl ,
                        "compaction"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "Kwalitatieve of kwantitatieve beschrijving van de grondverdichting."@nl ,
                                                              "Qualitative or quantitative description of soil compaction."@en .


###  https://w3id.org/utt/def/diepteNAP
:diepteNAP rdf:type owl:DatatypeProperty ;
           rdfs:domain [ rdf:type owl:Class ;
                         owl:unionOf ( :GeregistreerdePositie
                                       :WaargenomenPositie
                                     )
                       ] ;
           rdfs:range xsd:decimal ;
           rdfs:comment """Elevation of the utility reference point relative to NAP (Normaal
    Amsterdams Peil), in meters."""@en ;
           rdfs:label "depth NAP"@en ,
                      "diepte NAP"@nl ;
           <http://www.w3.org/2004/02/skos/core#definition> """Elevation of the utility reference point relative to NAP, in
    meters. Source of truth for depth."""@en ,
                                                            """Hoogte van het aangrijpingspunt van de kabel/leiding ten
    opzichte van NAP, in meters. Bron van waarheid voor diepte."""@nl ;
           <http://www.w3.org/2004/02/skos/core#scopeNote> """Both diepteNAP and diepteTovMaaiveld are retained because NAP
    elevation is the stable registration value that survives surface changes, while
    depth-of-cover relative to ground level is the value contractors actually collect and
    record in DXF deliveries. IMKL carries both. Removing depth-of-cover would leave the
    database empty wherever a contractor records only cover, while removing NAP would make
    values non-comparable across sites with different surface levels."""@en ;
           :eenheid <http://qudt.org/vocab/unit/M> .


###  https://w3id.org/utt/def/diepteTovMaaiveld
:diepteTovMaaiveld rdf:type owl:DatatypeProperty ;
                   rdfs:domain [ rdf:type owl:Class ;
                                 owl:unionOf ( :GeregistreerdePositie
                                               :WaargenomenPositie
                                             )
                               ] ;
                   rdfs:range xsd:decimal ;
                   rdfs:comment """Depth of the utility reference point relative to the local
    ground surface, in meters. This is the value normally carried in contractor DXF and CAD
    output. The authoritative depth is diepteNAP."""@en ;
                   rdfs:label "depth relative to ground level"@en ,
                              "diepte t.o.v. maaiveld"@nl ;
                   <http://www.w3.org/2004/02/skos/core#definition> """Depth of the utility reference point relative to the
    local ground surface, in meters. Derived; may shift if the ground surface changes."""@en ,
                                                                    """Diepte van het aangrijpingspunt van de kabel/leiding
    ten opzichte van het lokale maaiveld, in meters. Afgeleid; kan wijzigen bij
    maaiveldverandering."""@nl ;
                   <http://www.w3.org/2004/02/skos/core#scopeNote> """Retained alongside diepteNAP because contractor DXF
    deliveries record depth-of-cover relative to ground level, not NAP elevation. The
    authoritative value is diepteNAP; this property preserves the field-recorded value so
    the conversion can be audited."""@en ;
                   :eenheid <http://qudt.org/vocab/unit/M> .


###  https://w3id.org/utt/def/grondwaterNiveau
:grondwaterNiveau rdf:type owl:DatatypeProperty ;
                  rdfs:domain :GrondCondities ;
                  rdfs:range xsd:decimal ;
                  rdfs:comment "Observed groundwater level at the trench, expressed as elevation relative to NAP in meters."@en ;
                  rdfs:label "grondwater niveau"@nl ,
                             "groundwater level"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Observed groundwater level relative to NAP in meters."@en ,
                                                                   "Waargenomen grondwaterstand t.o.v. NAP in meters."@nl ;
                  :eenheid <http://qudt.org/vocab/unit/M> .


###  https://w3id.org/utt/def/horizontaleAfwijking
:horizontaleAfwijking rdf:type owl:DatatypeProperty ;
                      rdfs:domain :PositieAfwijking ;
                      rdfs:range xsd:decimal ;
                      rdfs:comment "Horizontal (XY) deviation in meters."@en ;
                      rdfs:label "horizontal deviation"@en ,
                                 "horizontale afwijking"@nl ;
                      <http://www.w3.org/2004/02/skos/core#definition> "Horizontal (XY) deviation in meters."@en ,
                                                                       "Horizontale (XY) afwijking in meters."@nl ;
                      :eenheid <http://qudt.org/vocab/unit/M> .


###  https://w3id.org/utt/def/horizontaleOnzekerheid
:horizontaleOnzekerheid rdf:type owl:DatatypeProperty ;
                        rdfs:domain :Nauwkeurigheid ;
                        rdfs:range xsd:decimal ;
                        rdfs:comment "Horizontal (XY) measurement uncertainty in meters (1 sigma)."@en ;
                        rdfs:label "horizontal uncertainty"@en ,
                                   "horizontale onzekerheid"@nl ;
                        <http://www.w3.org/2004/02/skos/core#definition> "Horizontal (XY) uncertainty in meters (1 sigma)."@en ,
                                                                         "Horizontale (XY) onzekerheid in meters (1 sigma)."@nl ;
                        :eenheid <http://qudt.org/vocab/unit/M> .


###  https://w3id.org/utt/def/kalibratieDatum
:kalibratieDatum rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Meetapparatuur ;
                 rdfs:range xsd:date ;
                 rdfs:comment "Date of last calibration."@en ;
                 rdfs:label "calibration date"@en ,
                            "kalibratie datum"@nl ;
                 <http://www.w3.org/2004/02/skos/core#definition> "Date of last calibration."@en ,
                                                                  "Datum van laatste kalibratie."@nl .


###  https://w3id.org/utt/def/klicObjectId
:klicObjectId rdf:type owl:DatatypeProperty ;
              rdfs:domain :ImklKabelOfLeiding ;
              rdfs:range xsd:string ;
              rdfs:comment """Persistent identifier for a registered utility object, stable
    across multiple KLIC meldingen."""@en ;
              rdfs:label "KLIC object ID"@en ,
                         "KLIC object ID"@nl ;
              <http://www.w3.org/2004/02/skos/core#definition> "Persistent identifier of a registered cable or pipe."@en ,
                                                               "Persistente identifier van een geregistreerde kabel of leiding."@nl .


###  https://w3id.org/utt/def/leverancierCode
:leverancierCode rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Waarneming ;
                 rdfs:range xsd:string ;
                 rdfs:comment """The contractor's own classification code for the observation,
    retained verbatim."""@en ;
                 rdfs:label "leverancierscode"@nl ,
                            "supplier code"@en ;
                 <http://www.w3.org/2004/02/skos/core#definition> "De eigen classificatiecode van de aannemer, letterlijk bewaard."@nl ,
                                                                  "The contractor's own classification code, retained verbatim."@en .


###  https://w3id.org/utt/def/maaiveldElevatieNAP
:maaiveldElevatieNAP rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Proefsleuf ;
                     rdfs:range xsd:decimal ;
                     rdfs:comment "Elevation of the ground surface at the trench, relative to NAP in meters."@en ;
                     rdfs:label "ground surface elevation NAP"@en ,
                                "maaiveld elevatie NAP"@nl ;
                     <http://www.w3.org/2004/02/skos/core#definition> "Ground surface elevation at the trench relative to NAP in meters."@en ,
                                                                      "Hoogte van het maaiveld ter plaatse van de proefsleuf t.o.v. NAP in meters."@nl ;
                     :eenheid <http://qudt.org/vocab/unit/M> .


###  https://w3id.org/utt/def/opnameDatum
:opnameDatum rdf:type owl:DatatypeProperty ;
             rdfs:domain :Meetpunt ;
             rdfs:range xsd:date ;
             rdfs:comment "Date on which this individual point was measured."@en ;
             rdfs:label "opnamedatum"@nl ,
                        "survey date"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "Date on which this individual point was measured."@en ,
                                                              "Datum waarop dit punt is ingemeten."@nl .


###  https://w3id.org/utt/def/prismaHoogte
:prismaHoogte rdf:type owl:DatatypeProperty ;
              rdfs:domain :Meetapparatuur ;
              rdfs:range xsd:decimal ;
              rdfs:comment "Height of the prism above the measured point for total station work."@en ;
              rdfs:label "prism height"@en ,
                         "prismahoogte"@nl ;
              <http://www.w3.org/2004/02/skos/core#definition> "Height of the prism above the measured point."@en ,
                                                               "Hoogte van het prisma boven het ingemeten punt."@nl ;
              :eenheid <http://qudt.org/vocab/unit/M> .


###  https://w3id.org/utt/def/projectNaam
:projectNaam rdf:type owl:DatatypeProperty ;
             rdfs:domain :Project ;
             rdfs:range xsd:string ;
             rdfs:comment "Name of the excavation project."@en ;
             rdfs:label "project naam"@nl ,
                        "project name"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "Naam van het project."@nl ,
                                                              "Name of the project."@en .


###  https://w3id.org/utt/def/projectNummer
:projectNummer rdf:type owl:DatatypeProperty ;
               rdfs:domain :Project ;
               rdfs:range xsd:string ;
               rdfs:comment "Identifier of the excavation project."@en ;
               rdfs:label "project number"@en ,
                          "project nummer"@nl ;
               <http://www.w3.org/2004/02/skos/core#definition> "Number/identifier of the project."@en ,
                                                                "Nummer/identificatie van het project."@nl .


###  https://w3id.org/utt/def/puntNummer
:puntNummer rdf:type owl:DatatypeProperty ;
            rdfs:domain :Meetpunt ;
            rdfs:range xsd:string ;
            rdfs:comment "The surveyor's own point number as delivered."@en ;
            rdfs:label "point number"@en ,
                       "puntnummer"@nl ;
            <http://www.w3.org/2004/02/skos/core#definition> "Puntnummer van de landmeter zoals aangeleverd."@nl ,
                                                             "The surveyor's own point number as delivered."@en .


###  https://w3id.org/utt/def/puntOnzekerheid
:puntOnzekerheid rdf:type owl:DatatypeProperty ;
                 rdfs:domain :Meetpunt ;
                 rdfs:range xsd:decimal ;
                 rdfs:comment "The single combined uncertainty figure reported by the instrument for one point."@en ;
                 rdfs:label "point uncertainty"@en ,
                            "puntonzekerheid"@nl ;
                 <http://www.w3.org/2004/02/skos/core#definition> "De gecombineerde onzekerheid die het instrument voor een punt rapporteert."@nl ,
                                                                  "The single combined uncertainty figure reported by the instrument for one point."@en ;
                 :eenheid <http://qudt.org/vocab/unit/M> .


###  https://w3id.org/utt/def/sleufBreedte
:sleufBreedte rdf:type owl:DatatypeProperty ;
              rdfs:domain :Proefsleuf ;
              rdfs:range xsd:decimal ;
              rdfs:comment "Width of the test trench in meters."@en ;
              rdfs:label "sleuf breedte"@nl ,
                         "trench width"@en ;
              <http://www.w3.org/2004/02/skos/core#definition> "Breedte van de proefsleuf in meters."@nl ,
                                                               "Width of the test trench in meters."@en ;
              :eenheid <http://qudt.org/vocab/unit/M> .


###  https://w3id.org/utt/def/sleufDiepte
:sleufDiepte rdf:type owl:DatatypeProperty ;
             rdfs:domain :Proefsleuf ;
             rdfs:range xsd:decimal ;
             rdfs:comment "Maximum excavated depth of the trench itself, in meters."@en ;
             rdfs:label "sleuf diepte"@nl ,
                        "trench excavated depth"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "Maximale uitgegraven diepte van de proefsleuf in meters."@nl ,
                                                              "Maximum excavated depth of the trench in meters."@en ;
             :eenheid <http://qudt.org/vocab/unit/M> .


###  https://w3id.org/utt/def/sleufLengte
:sleufLengte rdf:type owl:DatatypeProperty ;
             rdfs:domain :Proefsleuf ;
             rdfs:range xsd:decimal ;
             rdfs:comment "Length of the test trench in meters."@en ;
             rdfs:label "sleuf lengte"@nl ,
                        "trench length"@en ;
             <http://www.w3.org/2004/02/skos/core#definition> "Lengte van de proefsleuf in meters."@nl ,
                                                              "Length of the test trench in meters."@en ;
             :eenheid <http://qudt.org/vocab/unit/M> .


###  https://w3id.org/utt/def/typeAanduiding
:typeAanduiding rdf:type owl:DatatypeProperty ;
                rdfs:domain :WaargenomenKenmerken ;
                rdfs:range xsd:string ;
                rdfs:comment "A manufacturer or trade designation such as a cable type code."@en ;
                rdfs:label "type designation"@en ,
                           "typeaanduiding"@nl ;
                <http://www.w3.org/2004/02/skos/core#definition> "A manufacturer or trade designation, for example a cable type code."@en ,
                                                                 "Fabrikants- of handelsaanduiding, bijvoorbeeld een kabeltypecode."@nl .


###  https://w3id.org/utt/def/verificatieDatum
:verificatieDatum rdf:type owl:DatatypeProperty ;
                  rdfs:domain :VerificatieActiviteit ;
                  rdfs:range xsd:dateTime ;
                  rdfs:comment "Date and time the verification was performed."@en ;
                  rdfs:label "verificatie datum"@nl ,
                             "verification date"@en ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Date and time the verification was performed."@en ,
                                                                   "Datum en tijd waarop de verificatie is uitgevoerd."@nl .


###  https://w3id.org/utt/def/verticaleAfwijking
:verticaleAfwijking rdf:type owl:DatatypeProperty ;
                    rdfs:domain :PositieAfwijking ;
                    rdfs:range xsd:decimal ;
                    rdfs:comment """Vertical (depth) deviation in metres. Signed: positive means the utility was
    found shallower than registered."""@en ;
                    rdfs:label "vertical deviation"@en ,
                               "verticale afwijking"@nl ;
                    <http://www.w3.org/2004/02/skos/core#definition> "Vertical (depth) deviation in metres."@en ,
                                                                     "Verticale (diepte) afwijking in meters."@nl ;
                    :eenheid <http://qudt.org/vocab/unit/M> .


###  https://w3id.org/utt/def/verticaleOnzekerheid
:verticaleOnzekerheid rdf:type owl:DatatypeProperty ;
                      rdfs:domain :Nauwkeurigheid ;
                      rdfs:range xsd:decimal ;
                      rdfs:comment "Vertical (depth) measurement uncertainty in metres (1 sigma)."@en ;
                      rdfs:label "vertical uncertainty"@en ,
                                 "verticale onzekerheid"@nl ;
                      <http://www.w3.org/2004/02/skos/core#definition> "Vertical (depth) uncertainty in metres (1 sigma)."@en ,
                                                                       "Verticale (diepte) onzekerheid in meters (1 sigma)."@nl ;
                      :eenheid <http://qudt.org/vocab/unit/M> .


###  https://w3id.org/utt/def/waargenomenDiameter
:waargenomenDiameter rdf:type owl:DatatypeProperty ;
                     rdfs:domain :WaargenomenKenmerken ;
                     rdfs:range xsd:decimal ;
                     rdfs:comment "Outer diameter of the cable or pipe in millimeters."@en ;
                     rdfs:label "observed diameter"@en ,
                                "waargenomen diameter"@nl ;
                     <http://www.w3.org/2004/02/skos/core#definition> "Buitendiameter van de kabel of leiding in millimeters."@nl ,
                                                                      "Outer diameter of the cable or pipe in millimeters."@en ;
                     :eenheid <http://qudt.org/vocab/unit/MilliM> .


###  https://w3id.org/utt/def/waargenomenKleur
:waargenomenKleur rdf:type owl:DatatypeProperty ;
                  rdfs:domain :WaargenomenKenmerken ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Colour of the cable, pipe, or marking as observed in the field."@en ;
                  rdfs:label "observed color"@en ,
                             "waargenomen kleur"@nl ;
                  <http://www.w3.org/2004/02/skos/core#definition> "Colour of the cable, pipe or marking as observed in the field."@en ,
                                                                   "Kleur van de kabel, leiding of markering zoals waargenomen in het veld."@nl .


#################################################################
#    Classes
#################################################################

###  http://qudt.org/schema/qudt/Unit
<http://qudt.org/schema/qudt/Unit> rdf:type owl:Class ;
